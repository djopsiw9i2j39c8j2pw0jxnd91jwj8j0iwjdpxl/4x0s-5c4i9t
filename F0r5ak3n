function IsSuspiciousPart(part)
    if not part or not part:IsA("BasePart") then return true end
    AppState.PartSize = part.Size
    return AppState.PartSize.X > PortalConfig.SuspiciousMaxSize
        or AppState.PartSize.Y > PortalConfig.SuspiciousMaxSize
        or AppState.PartSize.Z > PortalConfig.SuspiciousMaxSize
        or AppState.PartSize.X < PortalConfig.SuspiciousMinSize
        or AppState.PartSize.Z < PortalConfig.SuspiciousMinSize
end

function CheckCandidate(result, centerPos)
    if not result then return nil end
    AppState.HitPart = result.Instance
    if not AppState.HitPart or not AppState.HitPart:IsA("BasePart") then return nil end
    if result.Normal.Y < PortalConfig.MinFloorNormalY then return nil end
    if IsSuspiciousPart(AppState.HitPart) then return nil end

    AppState.CandidatePos = result.Position + Vector3.new(0, PortalConfig.RootHeight, 0)

    AppState.TouchingParts = Workspace:GetPartBoundsInBox(CFrame.new(AppState.CandidatePos), PortalConfig.CheckSize, AppState.OverlapParams)
    for _, part in ipairs(AppState.TouchingParts) do
        if part ~= AppState.HitPart and part:IsA("BasePart") and part.CanCollide then
            return nil
        end
    end

    if Workspace:Raycast(AppState.CandidatePos + PortalConfig.HeadCheckOffset, PortalConfig.HeadCheckDir, AppState.RayParams) then
        return nil
    end

    AppState.SideOrigin = AppState.CandidatePos + PortalConfig.SideCheckOffset
    for _, dir in ipairs(PortalConfig.SideDirections) do
        if Workspace:Raycast(AppState.SideOrigin, dir, AppState.RayParams) then
            return nil
        end
    end

    for _, offset in ipairs(PortalConfig.FloorOffsets) do
        AppState.FloorCheck = Workspace:Raycast(result.Position + offset + Vector3.new(0, 2, 0), Vector3.new(0, -5, 0), AppState.RayParams)
        if not AppState.FloorCheck or AppState.FloorCheck.Normal.Y < PortalConfig.MinFloorNormalY then
            return nil
        end
    end

    return {
        CFrame = CFrame.new(AppState.CandidatePos),
        Position = AppState.CandidatePos,
        Surface = AppState.HitPart,
        Normal = result.Normal,
        Distance = (Vector3.new(AppState.CandidatePos.X, 0, AppState.CandidatePos.Z) - Vector3.new(centerPos.X, 0, centerPos.Z)).Magnitude,
    }
end

function FindSurfaceAtColumn(x, z, centerPos)
    AppState.ColumnOrigin = Vector3.new(x, PortalConfig.ScanTop, z)
    AppState.IgnoredParts = {AppState.ScanCharacter}

    for attempt = 1, PortalConfig.MaxPassThrough do
        AppState.ColumnResult = Workspace:Raycast(
            AppState.ColumnOrigin,
            Vector3.new(0, PortalConfig.ScanBottom - AppState.ColumnOrigin.Y, 0),
            NewColumnParams(AppState.IgnoredParts)
        )
        if not AppState.ColumnResult then return nil end

        AppState.ColumnCandidate = CheckCandidate(AppState.ColumnResult, centerPos)
        if AppState.ColumnCandidate then return AppState.ColumnCandidate end

        AppState.ColumnHit = AppState.ColumnResult.Instance
        if AppState.ColumnHit and AppState.ColumnHit:IsA("BasePart") then
            table.insert(AppState.IgnoredParts, AppState.ColumnHit)
            AppState.ColumnOrigin = Vector3.new(x, AppState.ColumnResult.Position.Y - 0.05, z)
        else
            return nil
        end
    end
    return nil
end

function GetHighestSafePos(centerPos)
    AppState.ScanCharacter = localPlayer.Character
    if not AppState.ScanCharacter then return nil end

    AppState.RayParams = RaycastParams.new()
    AppState.RayParams.FilterType = Enum.RaycastFilterType.Exclude
    AppState.RayParams.FilterDescendantsInstances = {AppState.ScanCharacter}
    AppState.RayParams.IgnoreWater = true

    AppState.OverlapParams = OverlapParams.new()
    AppState.OverlapParams.FilterType = Enum.RaycastFilterType.Exclude
    AppState.OverlapParams.FilterDescendantsInstances = {AppState.ScanCharacter}

    AppState.Candidates = {}

    for x = -PortalConfig.ScanRadius, PortalConfig.ScanRadius, PortalConfig.GridStep do
        for z = -PortalConfig.ScanRadius, PortalConfig.ScanRadius, PortalConfig.GridStep do
            if math.sqrt(x * x + z * z) <= PortalConfig.ScanRadius then
                AppState.Candidate = FindSurfaceAtColumn(centerPos.X + x, centerPos.Z + z, centerPos)
                if AppState.Candidate then
                    table.insert(AppState.Candidates, AppState.Candidate)
                end
            end
        end
    end

    if #AppState.Candidates == 0 then
        AppState.SafeSurface = nil
        AppState.SafeSurfaceNormal = nil
        AppState.SafePos = nil
        return nil
    end

    table.sort(AppState.Candidates, function(a, b) return a.Distance < b.Distance end)

    AppState.SafeSurface = AppState.Candidates[1].Surface
    AppState.SafeSurfaceNormal = AppState.Candidates[1].Normal
    AppState.SafePos = AppState.Candidates[1].Position
    return AppState.Candidates[1].CFrame
end
