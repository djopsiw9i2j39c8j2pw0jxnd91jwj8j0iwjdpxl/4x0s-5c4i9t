AutoQTEManager = {
    Construct = { Enabled = false, Hooked = false },
    Bloodhook = { Enabled = false, LoopActive = false, LastButton = nil },
    Targets = {"cl_ConstructQTE", "ConstructQTE"},
    NosHookRemote = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("NosHookQTE") or ReplicatedStorage:FindFirstChild("NosHookQTE", true)
}

function AutoQTEManager:TryHookConstruct()
    if self.Construct.Hooked then return end
    
    for i = 1, #self.Targets do
        self.Module = ReplicatedStorage:FindFirstChild(self.Targets[i], true)
        if self.Module then break end
    end
    
    if self.Module and self.Module:IsA("ModuleScript") then
        self.Success, self.Data = pcall(require, self.Module)
        
        if self.Success and type(self.Data) == "table" and self.Data.new then
            self.Data.OriginalNew = self.Data.new
            
            self.Data.new = function(...)
                AutoQTEManager.TempInstance = AutoQTEManager.Data.OriginalNew(...)
                
                if AutoQTEManager.Construct.Enabled then
                    task.spawn(function(qte)
                        task.wait(0.1)
                        if type(qte) == "table" and qte.AddProgress then
                            qte:AddProgress(100)
                        end
                    end, AutoQTEManager.TempInstance)
                end
                
                return AutoQTEManager.TempInstance
            end
            
            self.Construct.Hooked = true
        end
    end
end

function AutoQTEManager:HandleBloodhook(state)
    self.Bloodhook.Enabled = state
    
    if state and self.NosHookRemote and not self.Bloodhook.LoopActive then
        self.Bloodhook.LoopActive = true
        
        task.spawn(function()
            while AutoQTEManager.Bloodhook.Enabled do
                -- Dùng đường dẫn tĩnh bro cho để tối ưu tài nguyên, check từng cấp tránh lỗi nil
                AutoQTEManager.TempUI = Players.LocalPlayer.PlayerGui:FindFirstChild("TemporaryUI")
                AutoQTEManager.QTE = AutoQTEManager.TempUI and AutoQTEManager.TempUI:FindFirstChild("QTE")
                AutoQTEManager.ActiveButton = AutoQTEManager.QTE and AutoQTEManager.QTE:FindFirstChild("ActiveButton")
                
                if AutoQTEManager.ActiveButton and AutoQTEManager.ActiveButton.Visible then
                    -- Check xem nút này đã Fire chưa để tránh spam server trong lúc để nút làm màu
                    if AutoQTEManager.Bloodhook.LastButton ~= AutoQTEManager.ActiveButton then
                        AutoQTEManager.NosHookRemote:FireServer(true)
                        AutoQTEManager.Bloodhook.LastButton = AutoQTEManager.ActiveButton
                    end
                else
                    -- Reset lại khi không còn nút nào trên màn hình
                    AutoQTEManager.Bloodhook.LastButton = nil
                end
                
                task.wait(0.1)
            end
            AutoQTEManager.Bloodhook.LoopActive = false
        end)
    end
end

