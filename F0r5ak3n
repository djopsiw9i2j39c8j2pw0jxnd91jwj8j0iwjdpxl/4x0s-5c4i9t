BypassSys.SetTouch = function(visible)
    if localPlayer:FindFirstChildOfClass("PlayerGui") then
        for _, gui in ipairs(localPlayer:FindFirstChildOfClass("PlayerGui"):GetDescendants()) do
            if gui:IsA("GuiObject") and (gui.Name:lower():find("joystick") or gui.Name:lower():find("thumbstick") or gui.Name:lower():find("move")) then
                if visible then
                    if BypassSys.State.HiddenGuis[gui] ~= nil then
                        gui.Visible = BypassSys.State.HiddenGuis[gui]
                    end
                else
                    BypassSys.State.HiddenGuis[gui] = gui.Visible
                    gui.Visible = false
                end
            end
        end
    end
end

BypassSys.FixSprintAnim = function()
    if not BypassSys.State.SprintMod then
        for _, v in ipairs(getgc(true)) do
            if type(v) == "table" and rawget(v, "StaminaFreezeLocks") and rawget(v, "IsSprinting") ~= nil then
                BypassSys.State.SprintMod = v
                break
            end
        end
    end

    if BypassSys.State.SprintMod then
        BypassSys.State.SprintMod.IsSprinting = not BypassSys.State.SprintMod.IsSprinting
        if BypassSys.State.SprintMod.__sprintedEvent then
            BypassSys.State.SprintMod.__sprintedEvent:Fire(BypassSys.State.SprintMod.IsSprinting)
        end
        
        task.delay(0.05, function()
            BypassSys.State.SprintMod.IsSprinting = not BypassSys.State.SprintMod.IsSprinting
            if BypassSys.State.SprintMod.__sprintedEvent then
                BypassSys.State.SprintMod.__sprintedEvent:Fire(BypassSys.State.SprintMod.IsSprinting)
            end
        end)
    end
end

BypassSys.Restore = function()
    if BypassSys.State.MoveConn then
        BypassSys.State.MoveConn:Disconnect()
        BypassSys.State.MoveConn = nil
    end
    ContextActionService:UnbindAction(BypassSys.State.ActionName)
    BypassSys.SetTouch(true)
    BypassSys.State.CtrlBlocked = false
    BypassSys.State.AnimBlocked = false
end

BypassSys.DisableCtrl = function(duration)
    if BypassSys.State.CtrlBlocked then return end
    if not (localPlayer.Character and localPlayer.Character:FindFirstChildOfClass("Humanoid")) then return end

    BypassSys.State.CtrlBlocked = true
    BypassSys.SetTouch(false)

    ContextActionService:BindAction(
        BypassSys.State.ActionName,
        function() return Enum.ContextActionResult.Sink end,
        false,
        Enum.PlayerActions.CharacterForward,
        Enum.PlayerActions.CharacterBackward,
        Enum.PlayerActions.CharacterLeft,
        Enum.PlayerActions.CharacterRight,
        Enum.PlayerActions.CharacterJump
    )

    if BypassSys.State.MoveConn then BypassSys.State.MoveConn:Disconnect() end

    BypassSys.State.MoveConn = RunService.RenderStepped:Connect(function()
        if localPlayer.Character and localPlayer.Character:FindFirstChildOfClass("Humanoid") and localPlayer.Character:FindFirstChildOfClass("Humanoid").Parent then
            localPlayer.Character:FindFirstChildOfClass("Humanoid"):Move(Vector3.zero, true)
            if localPlayer.Character:FindFirstChildOfClass("Humanoid").RootPart then
                localPlayer.Character:FindFirstChildOfClass("Humanoid").RootPart.AssemblyLinearVelocity = Vector3.zero
            end
        end
    end)

    task.delay(duration or 0.2, function()
        BypassSys.Restore()
        if localPlayer.Character and localPlayer.Character:FindFirstChildOfClass("Humanoid") then
            task.wait()
            localPlayer.Character:FindFirstChildOfClass("Humanoid"):Move(localPlayer.Character:FindFirstChildOfClass("Humanoid").MoveDirection, true)
        end
    end)
end

BypassSys.BlockAnim = function(duration)
    if BypassSys.State.AnimBlocked then return end
    BypassSys.State.AnimBlocked = true

    if localPlayer.Character and localPlayer.Character:FindFirstChildOfClass("Humanoid") then
        for _, track in ipairs(localPlayer.Character:FindFirstChildOfClass("Humanoid"):GetPlayingAnimationTracks()) do
            track:Stop(0)
        end
        BypassSys.FixSprintAnim()
    end

    task.delay(duration or 0.1, function()
        BypassSys.State.AnimBlocked = false
    end)
end

BypassSys.OnSpeedChanged = function(val)
    if not (val and val:IsA("NumberValue")) or BypassSys.State.Updating then return end

    if BypassSys.Flags.AntiSlow and val.Name ~= "Stunned" and val.Value < 1 then
        BypassSys.State.Updating = true
        val.Value = 0.9
        BypassSys.State.Updating = false
        BypassSys.HideUI("Slowness")
    end

    if BypassSys.Flags.AntiStun and val.Name == "Stunned" then
        if val.Value < 1 then
            BypassSys.State.Updating = true
            val.Value = 1
            BypassSys.State.Updating = false

            BypassSys.HideUI("Stunned")

            if not BypassSys.State.LastStun then
                BypassSys.State.LastStun = true
                BypassSys.BlockAnim(0.1)

                task.delay(0.2, function()
                    BypassSys.State.LastStun = false
                end)
            end
        end
    end
end

BypassSys.HookChar = function(char)
    if char:GetAttribute("Username") ~= localPlayer.Name then return end
    
    task.spawn(function()
        BypassSys.Temp.SpeedFolder = char:WaitForChild("SpeedMultipliers", 3)
        if not BypassSys.Temp.SpeedFolder then return end

        for _, val in ipairs(BypassSys.Temp.SpeedFolder:GetChildren()) do
            BypassSys.OnSpeedChanged(val)
            table.insert(BypassSys.State.Conns, val:GetPropertyChangedSignal("Value"):Connect(function()
                BypassSys.OnSpeedChanged(val)
            end))
        end

        table.insert(BypassSys.State.Conns, BypassSys.Temp.SpeedFolder.ChildAdded:Connect(function(val)
            task.defer(function()
                BypassSys.OnSpeedChanged(val)
                table.insert(BypassSys.State.Conns, val:GetPropertyChangedSignal("Value"):Connect(function()
                    BypassSys.OnSpeedChanged(val)
                end))
            end)
        end))
    end)
end

BypassSys.EvaluateAll = function()
    if BypassSys.Temp.SpeedFolder then
