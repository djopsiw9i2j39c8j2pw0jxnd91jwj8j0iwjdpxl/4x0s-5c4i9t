function VeeronicaMods.TriggerSprint()
    VeeronicaMods.Data.SprintBtn = VeeronicaMods.Data.SprintBtn or (
        PlayerGui
        and PlayerGui:FindFirstChild("MainUI")
        and PlayerGui.MainUI:FindFirstChild("SprintingButton")
    )

    if not VeeronicaMods.Data.SprintBtn then return end

    if getconnections then
        for _, conn in pairs(getconnections(VeeronicaMods.Data.SprintBtn.MouseButton1Down)) do
            pcall(function()
                conn:Fire()
                if conn.Function then
                    conn:Function()
                end
            end)
        end
    elseif firesignal then
        firesignal(VeeronicaMods.Data.SprintBtn.MouseButton1Down)
    end
end

function VeeronicaMods.AutoTrickStep()
    if not VeeronicaMods.States.AutoTrick or not playerCharacter then return end

    for h in pairs(VeeronicaMods.Data.Highlights) do
        if h and h.Adornee and (
            h.Adornee == playerCharacter
            or h.Adornee:IsDescendantOf(playerCharacter)
        ) then
            VeeronicaMods.TriggerSprint()
            break
        end
    end
end

function VeeronicaMods.ToggleAutoTrick(state)
    VeeronicaMods.States.AutoTrick = state

    if VeeronicaMods.Data.Conns.TrickLoop then
        VeeronicaMods.Data.Conns.TrickLoop:Disconnect()
    end

    if VeeronicaMods.Data.Conns.BehaviorAdd then
        VeeronicaMods.Data.Conns.BehaviorAdd:Disconnect()
    end

    if VeeronicaMods.Data.Conns.BehaviorRem then
        VeeronicaMods.Data.Conns.BehaviorRem:Disconnect()
    end

    VeeronicaMods.Data.Highlights = {}

    if state then
        VeeronicaMods.Data.Folder = ReplicatedStorage:FindFirstChild("Assets")
        VeeronicaMods.Data.Folder = VeeronicaMods.Data.Folder and VeeronicaMods.Data.Folder:FindFirstChild("Survivors")
        VeeronicaMods.Data.Folder = VeeronicaMods.Data.Folder and VeeronicaMods.Data.Folder:FindFirstChild("Veeronica")
        VeeronicaMods.Data.Folder = VeeronicaMods.Data.Folder and VeeronicaMods.Data.Folder:FindFirstChild("Behavior")

        if VeeronicaMods.Data.Folder then
            for _, v in ipairs(VeeronicaMods.Data.Folder:GetDescendants()) do
                if v:IsA("Highlight") then
                    VeeronicaMods.Data.Highlights[v] = true
                end
            end

            VeeronicaMods.Data.Conns.BehaviorAdd =
                VeeronicaMods.Data.Folder.DescendantAdded:Connect(function(c)
                    if c:IsA("Highlight") then
                        VeeronicaMods.Data.Highlights[c] = true
                    end
                end)

            VeeronicaMods.Data.Conns.BehaviorRem =
                VeeronicaMods.Data.Folder.DescendantRemoving:Connect(function(c)
                    if c:IsA("Highlight") then
                        VeeronicaMods.Data.Highlights[c] = nil
                    end
                end)
        end

        VeeronicaMods.Data.Conns.TrickLoop =
            RunService.Heartbeat:Connect(VeeronicaMods.AutoTrickStep)
    end
end

function VeeronicaMods.SteerStep()
    if not VeeronicaMods.States.SmoothSteer then return end

    VeeronicaMods.GetCharacterData()

    if not (VeeronicaMods.Data.Hum and VeeronicaMods.Data.Root) then
        return
    end

    VeeronicaMods.Data.IsSkating = false

    for _, track in ipairs(VeeronicaMods.Data.Hum:GetPlayingAnimationTracks()) do
        if track.Animation and VeeronicaMods.Data.AnimIDs[
            tostring(track.Animation.AnimationId):match("%d+") or ""
        ] then
            VeeronicaMods.Data.IsSkating = true
            break
        end
    end

    if not VeeronicaMods.Data.IsSkating then
        if VeeronicaMods.Data.IsSk8Active then
            VeeronicaMods.Data.IsSk8Active = false
            VeeronicaMods.Data.Hum.WalkSpeed =
                VeeronicaMods.Data.SavedSpeed or 16
            VeeronicaMods.Data.Hum:Move(Vector3.zero, false)
        end

        VeeronicaMods.Data.LastLookDir = nil
        VeeronicaMods.Data.LastSpeedChange = 0
        return
    end

    if not VeeronicaMods.Data.IsSk8Active then
        VeeronicaMods.Data.IsSk8Active = true
        VeeronicaMods.Data.SavedSpeed =
            VeeronicaMods.Data.Hum.WalkSpeed
        VeeronicaMods.Data.LastLookDir = nil
        VeeronicaMods.Data.LastSpeedChange = 0
    end

    VeeronicaMods.Data.MoveDir = Vector3.new(
        Camera.CFrame.LookVector.X,
        0,
        Camera.CFrame.LookVector.Z
    )

    if VeeronicaMods.Data.MoveDir.Magnitude <= 0 then
        return
    end

    VeeronicaMods.Data.MoveDir =
        VeeronicaMods.Data.MoveDir.Unit

    if VeeronicaMods.Data.LastLookDir
        and 1 - VeeronicaMods.Data.LastLookDir:Dot(VeeronicaMods.Data.MoveDir)
            >= VeeronicaMods.Data.TurnThreshold
        and os.clock() - VeeronicaMods.Data.LastSpeedChange
            >= VeeronicaMods.Data.SpeedChangeCooldown then

        VeeronicaMods.Data.LastSpeedChange = os.clock()

        VeeronicaMods.Data.Hum.WalkSpeed =
            VeeronicaMods.Data.BoostSpeed

        task.defer(function()
            if VeeronicaMods.Data.Hum
                and VeeronicaMods.Data.IsSk8Active
                and VeeronicaMods.Data.IsSkating then

                VeeronicaMods.Data.Hum.WalkSpeed =
                    VeeronicaMods.Data.SavedSpeed
            end
        end)
    end

    VeeronicaMods.Data.LastLookDir =
        VeeronicaMods.Data.MoveDir

    VeeronicaMods.Data.Hum:Move(
        VeeronicaMods.Data.MoveDir,
        false
    )

    VeeronicaMods.Data.Root.CFrame =
        VeeronicaMods.Data.Root.CFrame:Lerp(
            CFrame.new(
                VeeronicaMods.Data.Root.Position,
                VeeronicaMods.Data.Root.Position
                    + VeeronicaMods.Data.MoveDir
            ),
            0.3
        )
end

function VeeronicaMods.ToggleSmoothSteer(state)
    VeeronicaMods.States.SmoothSteer = state

    if VeeronicaMods.Data.Conns.SteerLoop then
        VeeronicaMods.Data.Conns.SteerLoop:Disconnect()
    end

    if state then
        VeeronicaMods.Data.LastLookDir = nil
        VeeronicaMods.Data.LastSpeedChange = 0

        VeeronicaMods.Data.Conns.SteerLoop =
            RunService.RenderStepped:Connect(
                VeeronicaMods.SteerStep
            )
    elseif VeeronicaMods.Data.IsSk8Active then
        VeeronicaMods.Data.IsSk8Active = false
        VeeronicaMods.Data.LastLookDir = nil
        VeeronicaMods.Data.LastSpeedChange = 0

        VeeronicaMods.GetCharacterData()

        if VeeronicaMods.Data.Hum then
            VeeronicaMods.Data.Hum.WalkSpeed =
                VeeronicaMods.Data.SavedSpeed or 16

            VeeronicaMods.Data.Hum:Move(Vector3.zero, false)
        end
    end
end

