function CamlockBot:Tween(obj, props, duration)
    if obj then TweenService:Create(obj, TweenInfo.new(duration or 0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), props):Play() end
end

function CamlockBot:GetAimPos(model)
    if not model then return nil end
    local p = model:FindFirstChild(self.Config.AimPart) or model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart")
    return p and p.Position
end

function CamlockBot:IsKiller()
    return playerCharacter and playerCharacter:IsDescendantOf(killersFolder)
end

-- Gộp logic tìm mục tiêu vào 1 hàm duy nhất
function CamlockBot:GetAllTargets()
    if not survivorsFolder or not playerCharacter then return {} end
    local myRoot = playerCharacter:FindFirstChild("HumanoidRootPart")
    if not myRoot then return {} end

    local targets = {}
    for _, s in ipairs(survivorsFolder:GetChildren()) do
        local h, r = s:FindFirstChild("Humanoid"), s:FindFirstChild("HumanoidRootPart")
        if h and r and h.Health > 0 then
            table.insert(targets, {r = r, d = (r.Position - myRoot.Position).Magnitude})
        end
    end
    table.sort(targets, function(a, b) return a.d < b.d end)
    return targets
end

function CamlockBot:GetNearest()
    local t = self:GetAllTargets()
    return t[1] and t[1].r or nil
end

function CamlockBot:GetNextTarget()
    local targets = self:GetAllTargets()
    if #targets == 0 then return nil end
    if #targets == 1 then return targets[1].r end

    for i, t in ipairs(targets) do
        if t.r == self.State.Target then
            return targets[(i % #targets) + 1].r -- Thuật toán gộp Next Index gọn nhẹ
        end
    end
    return targets[1].r
end

function CamlockBot:UpdateQuickUI()
    if not self.UI.Button then return end
