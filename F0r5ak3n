function ESP:IsSelf(obj)
    if not localPlayer then return false end
    if obj == localPlayer then return true end

    if playerCharacter then
        if obj == playerCharacter then return true end
        if typeof(obj) == "Instance" and obj:IsDescendantOf(playerCharacter) then return true end
    end

    return false
end

function ESP:GetLocalPosition()
    if not playerCharacter or not playerCharacter.Parent then
        self.Cache.LocalRoot = nil
        return Camera.CFrame.Position
    end

    if not self.Cache.LocalRoot or not self.Cache.LocalRoot:IsDescendantOf(playerCharacter) then
        self.Cache.LocalRoot = playerCharacter:FindFirstChild("HumanoidRootPart") or playerCharacter:FindFirstChild("Head")
    end

    return self.Cache.LocalRoot and self.Cache.LocalRoot.Position or Camera.CFrame.Position
end

function ESP:GetTracerPos()
    if self.TracerOrigin == "Mouse" then
        return UserInputService:GetMouseLocation()
    end

    self.Cache.MidX = self.Cache.ViewSize.X * 0.5
    if self.TracerOrigin == "Center" then return Vector2.new(self.Cache.MidX, self.Cache.ViewSize.Y * 0.5) end
    if self.TracerOrigin == "Top" then return Vector2.new(self.Cache.MidX, 0) end
    return Vector2.new(self.Cache.MidX, self.Cache.ViewSize.Y)
end

