local PuzzleBot = {
    Config = {
        AutoSolve = false,
        ShowPath = false,
        SolveSpeed = 0.01
    },
    State = {
        Watchers = {},
        ActivePuzzle = nil,
        LastPuzzle = nil,
        IsSolving = false
    },
    Funcs = {}
}

function PuzzleBot.Funcs.IsNeighbor(node1, node2)
    return math.abs(node1.row - node2.row) + math.abs(node1.col - node2.col) == 1
end

function PuzzleBot.Funcs.GetPuzzle()
    local current = PuzzleBot.State.ActivePuzzle
    if current and not current.gameEnded and current.gridFrame and current.gridFrame:IsDescendantOf(game) then
        return current
    end

    for _, obj in pairs(getgc(true)) do
        if type(obj) == "table" and rawget(obj, "targetPairs") and rawget(obj, "Solution") and rawget(obj, "gridFrame") then
            if not obj.gameEnded and obj.gridFrame:IsDescendantOf(game) then
                PuzzleBot.State.ActivePuzzle = obj
                return obj
            end
        end
    end
    
    PuzzleBot.State.ActivePuzzle = nil
    return nil
end

function PuzzleBot.Funcs.ClearWatchers()
    for _, conn in pairs(PuzzleBot.State.Watchers) do
        if conn.Disconnect then conn:Disconnect() end
    end
    table.clear(PuzzleBot.State.Watchers)
end

function PuzzleBot.Funcs.GetOrderedPath(rawSolPath)
    if not rawSolPath or #rawSolPath <= 1 then return rawSolPath end
    
    local pool = {}
    for _, node in ipairs(rawSolPath) do
        table.insert(pool, {row = node.row, col = node.col})
    end
    
    local startIndex = 1
    for i, node in ipairs(pool) do
        local neighbors = 0
        for j, other in ipairs(pool) do
            if i ~= j and PuzzleBot.Funcs.IsNeighbor(node, other) then
                neighbors = neighbors + 1
            end
        end
        if neighbors == 1 then
            startIndex = i
            break
        end
    end
    
    local ordered = {}
    local current = table.remove(pool, startIndex)
    table.insert(ordered, current)
    
    while current and #pool > 0 do
        local foundIdx = nil
        for i, node in ipairs(pool) do
            if PuzzleBot.Funcs.IsNeighbor(current, node) then
                foundIdx = i
                break
            end
        end
        
        current = table.remove(pool, foundIdx or 1)
        table.insert(ordered, current)
    end
    
    return ordered
end

function PuzzleBot.Funcs.ApplyESP(puzzle)
    local defaultBtnColor = (puzzle.Settings and puzzle.Settings.defaultButtonColor) or Color3.fromRGB(30, 30, 30)

    for colorIndex, pathCoords in pairs(puzzle.Solution) do
        local pureColor = (puzzle.colors and puzzle.colors[colorIndex]) or Color3.new(1,1,1)
        local mixedColor = defaultBtnColor:Lerp(pureColor, 0.3)
        
        for _, node in ipairs(pathCoords) do
            local cell = puzzle.gridFrame:FindFirstChild(tostring(node.row) .. "-" .. tostring(node.col))
            if cell and cell:FindFirstChild("Button") then
                local btn = cell.Button
                local function forceColor()
                    if PuzzleBot.Config.ShowPath and btn.BackgroundColor3 ~= mixedColor then
                        btn.BackgroundColor3 = mixedColor
                        btn.BackgroundTransparency = 0 
                    end
                end
                
                forceColor()
                table.insert(PuzzleBot.State.Watchers, btn:GetPropertyChangedSignal("BackgroundColor3"):Connect(forceColor))
            end
        end
    end
end

function PuzzleBot.Funcs.SolvePuzzle(puzzle)
    for colorIndex, rawSolPath in pairs(puzzle.Solution) do
        if not PuzzleBot.Config.AutoSolve or puzzle.gameEnded then break end
        
        local orderedSolPath = PuzzleBot.Funcs.GetOrderedPath(rawSolPath)
        local currentPath = puzzle.paths[colorIndex]
        local isPerfect = true
        
        if not currentPath or #currentPath ~= #orderedSolPath then
            isPerfect = false
        else
            for j, node in ipairs(orderedSolPath) do
                if not currentPath[j] or currentPath[j].row ~= node.row or currentPath[j].col ~= node.col then
                    isPerfect = false
                    break
                end
            end
        end

        if not isPerfect then
            puzzle.paths[colorIndex] = {}
            if puzzle.updateGui then puzzle:updateGui() end
            task.wait(0.1) 
            
            for _, node in ipairs(orderedSolPath) do
                if not PuzzleBot.Config.AutoSolve or puzzle.gameEnded then break end
                table.insert(puzzle.paths[colorIndex], {row = node.row, col = node.col})
                if puzzle.updateGui then puzzle:updateGui() end
                task.wait(PuzzleBot.Config.SolveSpeed) 
            end
            task.wait(0.1) 
        end
    end
    
    if puzzle.checkForWin then puzzle:checkForWin() end
    PuzzleBot.State.IsSolving = false
end

