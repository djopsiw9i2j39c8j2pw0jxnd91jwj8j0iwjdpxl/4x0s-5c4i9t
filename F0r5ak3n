		PrevAutoRotate = nil,
		AimRotLocked = false
	}
}

TwoTime.Flatten = function(v)
	return Vector3.new(v.X, 0, v.Z)
end

TwoTime.FlatAngle = function(a, b)
	TwoTime.State.FA1 = TwoTime.Flatten(a)
	TwoTime.State.FA2 = TwoTime.Flatten(b)
	if TwoTime.State.FA1.Magnitude < 0.001 or TwoTime.State.FA2.Magnitude < 0.001 then
		return 999
	end
	return math.deg(math.acos(math.clamp(TwoTime.State.FA1.Unit:Dot(TwoTime.State.FA2.Unit), -1, 1)))
end

TwoTime.RotY = function(v, rad)
	TwoTime.State.RotCos = math.cos(rad)
	TwoTime.State.RotSin = math.sin(rad)
	return Vector3.new(v.X * TwoTime.State.RotCos + v.Z * TwoTime.State.RotSin, 0, -v.X * TwoTime.State.RotSin + v.Z * TwoTime.State.RotCos)
end

TwoTime.GetTargetRoot = function()
	TwoTime.State.MyPos = TwoTime.State.Root and TwoTime.State.Root.Position
	if not TwoTime.State.MyPos then return nil end

	TwoTime.State.BestRoot = nil
	TwoTime.State.BestDist = TwoTime.Config.AimRadius
	TwoTime.State.Target = nil

	for _, killer in ipairs(killersFolder:GetChildren()) do
		TwoTime.State.KR = killer:FindFirstChild("HumanoidRootPart")
		TwoTime.State.KH = killer:FindFirstChild("Humanoid")
		if TwoTime.State.KR and TwoTime.State.KH and TwoTime.State.KH.Health > 0 then
			TwoTime.State.KDist = (TwoTime.State.KR.Position - TwoTime.State.MyPos).Magnitude
			if TwoTime.State.KDist <= TwoTime.State.BestDist then
				TwoTime.State.BestDist = TwoTime.State.KDist
				TwoTime.State.BestRoot = TwoTime.State.KR
				TwoTime.State.Target = killer
			end
		end
	end

	return TwoTime.State.BestRoot
end

TwoTime.ComputeZone = function()
	TwoTime.State.PPos = TwoTime.State.Root.Position
	TwoTime.State.TargetRoot = TwoTime.GetTargetRoot()
	TwoTime.State.InZone = false

	if TwoTime.State.TargetRoot then
		TwoTime.State.KPos = TwoTime.State.TargetRoot.Position
		TwoTime.State.KLook = TwoTime.Flatten(TwoTime.State.TargetRoot.CFrame.LookVector)
		TwoTime.State.BehindDir = TwoTime.State.KLook.Magnitude > 0.001 and -TwoTime.State.KLook.Unit or Vector3.new(0, 0, 1)

		TwoTime.State.ToPlayer = TwoTime.Flatten(TwoTime.State.PPos - TwoTime.State.KPos)
		TwoTime.State.Dist = TwoTime.State.ToPlayer.Magnitude
		if TwoTime.State.Dist > 0.001 then
			TwoTime.State.ToPlayer = TwoTime.State.ToPlayer.Unit
		else
			TwoTime.State.ToPlayer = TwoTime.State.BehindDir
		end

		TwoTime.State.InZone = TwoTime.FlatAngle(TwoTime.State.ToPlayer, TwoTime.State.BehindDir) <= TwoTime.Config.BackAngle * 0.5
			and TwoTime.State.Dist <= TwoTime.Config.BackConeRadius
	end
end

TwoTime.TeleportStep = function()
	if not TwoTime.State.IsBoosting then return end
	if not (TwoTime.State.Root and TwoTime.State.Root.Parent) then return end

	if not TwoTime.State.Flags.Teleport then
		TwoTime.State.DidTeleport = false
		return
	end

	TwoTime.ComputeZone()

	if TwoTime.State.InZone then
		if not TwoTime.State.DidTeleport and os.clock() >= TwoTime.State.NextTeleport then
			TwoTime.State.DidTeleport = true
			TwoTime.State.NextTeleport = os.clock() + TwoTime.Config.TeleportCooldown
			if TwoTime.State.Dist > TwoTime.Config.StabOffset + 1 then
				TwoTime.State.StabPoint = Vector3.new(
					TwoTime.State.KPos.X + TwoTime.State.BehindDir.X * TwoTime.Config.StabOffset,
					TwoTime.State.PPos.Y,
					TwoTime.State.KPos.Z + TwoTime.State.BehindDir.Z * TwoTime.Config.StabOffset
				)
				TwoTime.State.Root.CFrame = CFrame.lookAt(TwoTime.State.StabPoint, Vector3.new(TwoTime.State.KPos.X, TwoTime.State.PPos.Y, TwoTime.State.KPos.Z))
				TwoTime.State.Root.AssemblyLinearVelocity = Vector3.zero
			end
		end
	else
		TwoTime.State.DidTeleport = false
	end
end

TwoTime.AimStep = function()
	if not TwoTime.State.Active then return end
	if not (TwoTime.State.Root and TwoTime.State.Root.Parent) then return end

	TwoTime.ComputeZone()

	if TwoTime.State.TargetRoot then
		if TwoTime.State.InZone then
			TwoTime.State.Root.CFrame = CFrame.lookAt(TwoTime.State.Root.Position, Vector3.new(TwoTime.State.KPos.X, TwoTime.State.Root.Position.Y, TwoTime.State.KPos.Z))
		else
			TwoTime.State.Tangent = Vector3.new(TwoTime.State.ToPlayer.Z, 0, -TwoTime.State.ToPlayer.X)
			if TwoTime.State.Tangent:Dot(TwoTime.State.BehindDir) < 0 then
				TwoTime.State.Tangent = -TwoTime.State.Tangent
			end

			if TwoTime.State.Dist < TwoTime.Config.SafeRadius then
				TwoTime.State.Radial = TwoTime.State.ToPlayer
				TwoTime.State.ApproachW = 1.5
			else
				TwoTime.State.Radial = -TwoTime.State.ToPlayer
				TwoTime.State.ApproachW = math.clamp(TwoTime.State.Dist / 10, 0.4, 1.2)
			end

			TwoTime.State.MoveDir = TwoTime.State.Tangent * TwoTime.Config.TangentWeight + TwoTime.State.Radial * TwoTime.State.ApproachW
			if TwoTime.State.MoveDir.Magnitude > 0.001 then
				TwoTime.State.MoveDir = TwoTime.State.MoveDir.Unit
			else
				TwoTime.State.MoveDir = TwoTime.State.Tangent
			end

			TwoTime.State.Root.CFrame = CFrame.lookAt(TwoTime.State.PPos, TwoTime.State.PPos + TwoTime.State.MoveDir)
		end
	else
		TwoTime.State.CamDir = TwoTime.Flatten(Camera.CFrame.LookVector)
		if TwoTime.State.CamDir.Magnitude > 0.001 then
			TwoTime.State.Root.CFrame = CFrame.lookAt(TwoTime.State.PPos, TwoTime.State.PPos + TwoTime.State.CamDir.Unit)
		end
	end
end

TwoTime.LockAimRotation = function()
	TwoTime.State.AimHum = TwoTime.State.Char and TwoTime.State.Char:FindFirstChild("Humanoid")
	if TwoTime.State.AimHum and not TwoTime.State.AimRotLocked then
		TwoTime.State.PrevAutoRotate = TwoTime.State.AimHum.AutoRotate
		TwoTime.State.AimHum.AutoRotate = false
		TwoTime.State.AimRotLocked = true
	end
end

TwoTime.UnlockAimRotation = function()
	if not TwoTime.State.AimRotLocked then return end

	if TwoTime.State.AimHum and TwoTime.State.AimHum.Parent then
		TwoTime.State.AimHum.AutoRotate = TwoTime.State.PrevAutoRotate ~= false
	end

	if TwoTime.State.Root and TwoTime.State.Root.Parent then
		TwoTime.State.CamDir = TwoTime.Flatten(Camera.CFrame.LookVector)
		if TwoTime.State.CamDir.Magnitude > 0.001 then
			TwoTime.State.Root.CFrame = CFrame.lookAt(TwoTime.State.Root.Position, TwoTime.State.Root.Position + TwoTime.State.CamDir.Unit)
		end
	end

	TwoTime.State.AimHum = nil
	TwoTime.State.PrevAutoRotate = nil
	TwoTime.State.AimRotLocked = false
end

TwoTime.OnBoostStart = function()
	TwoTime.State.DidTeleport = false
	TwoTime.State.Target = nil
	TwoTime.State.Active = TwoTime.State.Flags.AutoAim and TwoTime.State.CurrentAim == true

	if TwoTime.State.Flags.Teleport then
		RunService:BindToRenderStep("TwoTime_Teleport", 2998, TwoTime.TeleportStep)
	end

	if TwoTime.State.Active then
		TwoTime.LockAimRotation()
		RunService:BindToRenderStep("TwoTime_AimSteer", 2999, TwoTime.AimStep)
	end
end

TwoTime.OnBoostEnd = function()
	pcall(function()
		RunService:UnbindFromRenderStep("TwoTime_Teleport")
	end)

	if TwoTime.State.Active then
		pcall(function()
			RunService:UnbindFromRenderStep("TwoTime_AimSteer")
		end)
	end

	TwoTime.UnlockAimRotation()

	TwoTime.State.Active = false
	TwoTime.State.Target = nil
	TwoTime.State.DidTeleport = false
end

TwoTime.GetVizFolder = function()
	if not (TwoTime.State.VizFolder and TwoTime.State.VizFolder.Parent) then
		TwoTime.State.VizFolder = Instance.new("Folder")
		TwoTime.State.VizFolder.Name = "TwoTimeAimViz"
		TwoTime.State.VizFolder.Parent = CoreGui
	end
	return TwoTime.State.VizFolder
end

TwoTime.NewAdornment = function(className, adornee, color)
	TwoTime.State.NewAdorn = Instance.new(className)
	TwoTime.State.NewAdorn.Adornee = adornee
	TwoTime.State.NewAdorn.Color3 = color
	TwoTime.State.NewAdorn.Transparency = TwoTime.Config.VizTransparency
	TwoTime.State.NewAdorn.AlwaysOnTop = true
	TwoTime.State.NewAdorn.Parent = TwoTime.GetVizFolder()
	return TwoTime.State.NewAdorn
end

TwoTime.LayoutVisuals = function(viz)
	if not (viz.Root and viz.Root.Parent and viz.Hum) then return end

	TwoTime.State.GroundY = -(viz.Hum.HipHeight + viz.Root.Size.Y * 0.5) + 0.15
	TwoTime.State.GPos = viz.Root.Position + Vector3.new(0, TwoTime.State.GroundY, 0)
	TwoTime.State.KLook = TwoTime.Flatten(viz.Root.CFrame.LookVector)
	TwoTime.State.BehindDir = TwoTime.State.KLook.Magnitude > 0.001 and -TwoTime.State.KLook.Unit or Vector3.new(0, 0, 1)

	viz.Circle.CFrame = CFrame.new(0, TwoTime.State.GroundY, 0) * CFrame.Angles(math.pi * 0.5, 0, 0)
	viz.Circle.Radius = TwoTime.Config.AimRadius
	viz.Circle.InnerRadius = math.max(TwoTime.Config.AimRadius - TwoTime.Config.RingThick, 0)
	viz.Circle.Height = 0.15

	TwoTime.State.HalfRad = math.rad(TwoTime.Config.BackAngle * 0.5)
	TwoTime.State.P1 = TwoTime.State.GPos + TwoTime.RotY(TwoTime.State.BehindDir, TwoTime.State.HalfRad) * TwoTime.Config.BackConeRadius
	TwoTime.State.P2 = TwoTime.State.GPos + TwoTime.RotY(TwoTime.State.BehindDir, -TwoTime.State.HalfRad) * TwoTime.Config.BackConeRadius
	TwoTime.State.Segments = {
		{ TwoTime.State.GPos, TwoTime.State.P1 },
		{ TwoTime.State.GPos, TwoTime.State.P2 },
		{ TwoTime.State.P1, TwoTime.State.P2 },
	}

	for i, seg in ipairs(TwoTime.State.Segments) do
		TwoTime.State.LineVec = seg[2] - seg[1]
		TwoTime.State.LineLen = TwoTime.State.LineVec.Magnitude
		if TwoTime.State.LineLen < 0.01 then
			viz.Lines[i].Size = Vector3.zero
		else
			viz.Lines[i].Size = Vector3.new(TwoTime.Config.LineThick, TwoTime.Config.LineThick, TwoTime.State.LineLen)
			viz.Lines[i].CFrame = viz.Root.CFrame:ToObjectSpace(CFrame.lookAt((seg[1] + seg[2]) * 0.5, seg[2]))
		end
	end
end

TwoTime.ApplyVisibility = function(viz)
	viz.Circle.Visible = TwoTime.State.Flags.ShowAimRadius
	for _, line in ipairs(viz.Lines) do
		line.Visible = TwoTime.State.Flags.ShowBackCone
	end
end

TwoTime.RefreshVisualVisibility = function()
	for _, viz in pairs(TwoTime.State.Visuals) do
		TwoTime.ApplyVisibility(viz)
	end
end

TwoTime.RemoveVisuals = function(killer)
	TwoTime.State.OldViz = TwoTime.State.Visuals[killer]
	if not TwoTime.State.OldViz then return end

	TwoTime.State.OldViz.Circle:Destroy()
	for _, line in ipairs(TwoTime.State.OldViz.Lines) do
		line:Destroy()
	end
	for _, conn in ipairs(TwoTime.State.OldViz.Conns) do
		conn:Disconnect()
	end
	TwoTime.State.Visuals[killer] = nil
end

TwoTime.BuildVisuals = function(killer)
	TwoTime.RemoveVisuals(killer)

	TwoTime.State.KR = killer:FindFirstChild("HumanoidRootPart")
	TwoTime.State.KH = killer:FindFirstChild("Humanoid")
	if not (TwoTime.State.KR and TwoTime.State.KH) or TwoTime.State.KH.Health <= 0 then return end

	TwoTime.State.NewViz = {
		Root = TwoTime.State.KR,
		Hum = TwoTime.State.KH,
		Circle = TwoTime.NewAdornment("CylinderHandleAdornment", TwoTime.State.KR, TwoTime.Config.VizColor),
		Lines = {
			TwoTime.NewAdornment("BoxHandleAdornment", TwoTime.State.KR, TwoTime.Config.LineColor),
			TwoTime.NewAdornment("BoxHandleAdornment", TwoTime.State.KR, TwoTime.Config.LineColor),
			TwoTime.NewAdornment("BoxHandleAdornment", TwoTime.State.KR, TwoTime.Config.LineColor),
		},
		Conns = {},
	}
	TwoTime.State.Visuals[killer] = TwoTime.State.NewViz

	TwoTime.LayoutVisuals(TwoTime.State.NewViz)
	TwoTime.ApplyVisibility(TwoTime.State.NewViz)

	table.insert(TwoTime.State.NewViz.Conns, TwoTime.State.KH.Died:Connect(function()
		TwoTime.RemoveVisuals(killer)
	end))
	table.insert(TwoTime.State.NewViz.Conns, killer.AncestryChanged:Connect(function(_, parent)
		if not parent then
			TwoTime.RemoveVisuals(killer)
		end
	end))
end

TwoTime.TryAttach = function(killer)
	task.defer(function()
		if killer:WaitForChild("HumanoidRootPart", 5) and killer:WaitForChild("Humanoid", 5) then
			TwoTime.BuildVisuals(killer)
		end
	end)
end

TwoTime.RebuildVisuals = function()
	for killer, viz in pairs(TwoTime.State.Visuals) do
		if killer.Parent and viz.Root and viz.Root.Parent then
			TwoTime.LayoutVisuals(viz)
		else
			TwoTime.RemoveVisuals(killer)
		end
	end
end

TwoTime.IsExactMatch = function(str)
	if type(str) ~= "string" then return false end
	TwoTime.State.LowerStr = str:lower()

	TwoTime.State.MatchedData = TwoTime.Config.Skills[TwoTime.State.LowerStr]
	if TwoTime.State.MatchedData then
		TwoTime.State.MatchedSpeed = TwoTime.State.MatchedData.Speed
		TwoTime.State.MatchedCutoff = TwoTime.State.MatchedData.Cutoff
		TwoTime.State.MatchedAim = TwoTime.State.MatchedData.Aim == true
		return true
	end

	return false
end

TwoTime.WalkTable = function(tbl, depth)
	if depth > 4 then return end
	for k, v in pairs(tbl) do
		if TwoTime.IsExactMatch(k) and (type(v) == "string" or type(v) == "number") then
			TwoTime.State.SkillCache[tostring(v):match("%d+")] = {
				Speed = TwoTime.State.MatchedSpeed,
				Cutoff = TwoTime.State.MatchedCutoff,
				Aim = TwoTime.State.MatchedAim
			}
		end

		if type(v) == "table" then
			TwoTime.WalkTable(v, depth + 1)
		end
	end
end

TwoTime.ScanFolder = function(folder, depth)
	if not folder or depth > 3 then return end
	for _, child in ipairs(folder:GetChildren()) do
		if child:IsA("ModuleScript") then
			TwoTime.State.Ok, TwoTime.State.Data = pcall(require, child)
			if TwoTime.State.Ok and type(TwoTime.State.Data) == "table" then
				TwoTime.WalkTable(TwoTime.State.Data, 0)
			end
		elseif child:IsA("Folder") or child:IsA("Model") then
			TwoTime.ScanFolder(child, depth + 1)
		end
	end
end

TwoTime.LoadConfigs = function()
	TwoTime.State.AssetsFolder = ReplicatedStorage:FindFirstChild("Assets")
	if not TwoTime.State.AssetsFolder then return end

	TwoTime.State.SurvFolder = TwoTime.State.AssetsFolder:FindFirstChild("Survivors")
	if TwoTime.State.SurvFolder then
		TwoTime.ScanFolder(TwoTime.State.SurvFolder:FindFirstChild("TwoTime"), 1)
	end

	TwoTime.State.SkinFolder = TwoTime.State.AssetsFolder:FindFirstChild("Skins")
	if TwoTime.State.SkinFolder then
		TwoTime.State.SkinSurvFolder = TwoTime.State.SkinFolder:FindFirstChild("Survivors")
		if TwoTime.State.SkinSurvFolder then
			TwoTime.ScanFolder(TwoTime.State.SkinSurvFolder:FindFirstChild("TwoTime"), 1)
		end
	end
end

TwoTime.StopBoost = function()
	TwoTime.State.IsBoosting = false
	TwoTime.State.CurrentTrack = nil

	TwoTime.OnBoostEnd()

	pcall(function()
		RunService:UnbindFromRenderStep("TwoTime_PhysicsOverride")
	end)

	if TwoTime.State.Root and TwoTime.State.Root.Parent then
		TwoTime.State.Root.AssemblyLinearVelocity = Vector3.zero
		TwoTime.State.Root.AssemblyAngularVelocity = Vector3.zero
	end
end

TwoTime.DashStep = function()
	if not TwoTime.State.CurrentTrack then return TwoTime.StopBoost() end

	TwoTime.State.TrackEnded = (not TwoTime.State.CurrentTrack.IsPlaying)
		or (TwoTime.State.CurrentTrack.Length > 0 and TwoTime.State.CurrentTrack.TimePosition >= TwoTime.State.CurrentTrack.Length * TwoTime.State.CurrentCutoff)

	if TwoTime.State.TrackEnded or not TwoTime.State.IsBoosting or not TwoTime.State.Root.Parent then
		return TwoTime.StopBoost()
	end

	for _, child in ipairs(TwoTime.State.Root:GetChildren()) do
		for _, className in ipairs(TwoTime.Config.BadMovers) do
			if child:IsA(className) then
				child:Destroy()
				break
			end
		end
	end

	if TwoTime.State.Active then
		TwoTime.State.FlatDir = TwoTime.Flatten(TwoTime.State.Root.CFrame.LookVector)
	else
		TwoTime.State.FlatDir = TwoTime.Flatten(TwoTime.State.Cam.CFrame.LookVector)
	end

	if TwoTime.State.FlatDir.Magnitude > 0.001 then
		TwoTime.State.FlatDir = TwoTime.State.FlatDir.Unit
	else
		TwoTime.State.FlatDir = TwoTime.State.Root.CFrame.LookVector
	end

	TwoTime.State.Root.AssemblyLinearVelocity = TwoTime.State.FlatDir * TwoTime.State.CurrentSpeed
	TwoTime.State.Root.AssemblyAngularVelocity = Vector3.zero
end

TwoTime.StartBoost = function(track)
	if not TwoTime.State.Flags.TwoTimeDash or TwoTime.State.IsBoosting then return end

	TwoTime.State.Char = localPlayer.Character
	if not TwoTime.State.Char then return end

	TwoTime.State.Root = TwoTime.State.Char:FindFirstChild("HumanoidRootPart")
	if not TwoTime.State.Root then return end

	TwoTime.StopBoost()
	TwoTime.State.IsBoosting = true
	TwoTime.State.Cam = Camera
	TwoTime.State.CurrentTrack = track

	TwoTime.OnBoostStart()

	RunService:BindToRenderStep("TwoTime_PhysicsOverride", 3000, TwoTime.DashStep)

	track.Stopped:Once(TwoTime.StopBoost)
end

TwoTime.OnAnimPlayed = function(track)
	if not track or not track.Animation then return end

	TwoTime.State.AnimName = track.Animation.Name or ""
	TwoTime.State.AnimId = tostring(track.Animation.AnimationId):match("%d+") or ""

	TwoTime.State.IsMatched = TwoTime.IsExactMatch(TwoTime.State.AnimName)

	if not TwoTime.State.IsMatched and TwoTime.State.SkillCache[TwoTime.State.AnimId] then
		TwoTime.State.IsMatched = true
		TwoTime.State.MatchedSpeed = TwoTime.State.SkillCache[TwoTime.State.AnimId].Speed
		TwoTime.State.MatchedCutoff = TwoTime.State.SkillCache[TwoTime.State.AnimId].Cutoff
		TwoTime.State.MatchedAim = TwoTime.State.SkillCache[TwoTime.State.AnimId].Aim == true
	end

	if TwoTime.State.IsMatched then
		TwoTime.State.CurrentSpeed = TwoTime.State.MatchedSpeed
		TwoTime.State.CurrentCutoff = TwoTime.State.MatchedCutoff
		TwoTime.State.CurrentAim = TwoTime.State.MatchedAim
		TwoTime.StartBoost(track)
	end
end

TwoTime.HookPlayer = function(char)
	if not char then return end
	TwoTime.StopBoost()

	for _, conn in ipairs(TwoTime.State.PlayerConns) do conn:Disconnect() end
	table.clear(TwoTime.State.PlayerConns)

	TwoTime.State.Hum = char:WaitForChild("Humanoid", 5)
	TwoTime.State.Animator = TwoTime.State.Hum and TwoTime.State.Hum:WaitForChild("Animator", 5)

	if TwoTime.State.Animator then
		table.insert(TwoTime.State.PlayerConns, TwoTime.State.Animator.AnimationPlayed:Connect(TwoTime.OnAnimPlayed))
	end
end

