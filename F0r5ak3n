    Enabled = false,
    Connections = {}
}

function AntiSlowFeature:HideUI()
    pcall(function()
        local mainUI = PlayerGui:FindFirstChild("MainUI")
        if not mainUI then return end

        local status = mainUI:FindFirstChild("StatusContainer")
        if not status then return end

        local slowUI = status:FindFirstChild("Slowness")
        if slowUI and slowUI.Visible then
            slowUI.Visible = false
        end
    end)
end

function AntiSlowFeature:ClearConnections()
    for _, conn in ipairs(self.Connections) do
        if conn.Connected then
            conn:Disconnect()
        end
    end
    table.clear(self.Connections)
end

function AntiSlowFeature:OnSpeedChanged(val)
    if self.Enabled and val:IsA("NumberValue") and val.Value < 1 then
        val.Value = 1
        self:HideUI()
    end
end

function AntiSlowFeature:HookSurvivor(survivor)
    if survivor:GetAttribute("Username") ~= localPlayer.Name then return end
    
    local speedFolder = survivor:WaitForChild("SpeedMultipliers", 3)
    if not speedFolder then return end

    for _, val in ipairs(speedFolder:GetChildren()) do
        self:OnSpeedChanged(val)
        table.insert(self.Connections, val:GetPropertyChangedSignal("Value"):Connect(function()
            self:OnSpeedChanged(val)
        end))
    end

    table.insert(self.Connections, speedFolder.ChildAdded:Connect(function(val)
        task.defer(function()
            self:OnSpeedChanged(val)
            table.insert(self.Connections, val:GetPropertyChangedSignal("Value"):Connect(function()
                self:OnSpeedChanged(val)
            end))
        end)
    end))
end

