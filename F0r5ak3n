local function GetTracerPos()
    local o = ESP.TracerOrigin
    local vs = ESP.Cache.ViewSize
    if o == "Bottom" then return Vector2.new(vs.X * 0.5, vs.Y)
    elseif o == "Center" then return Vector2.new(vs.X * 0.5, vs.Y * 0.5)
    elseif o == "Mouse" then return UserInputService:GetMouseLocation()
    else return Vector2.new(vs.X * 0.5, 0) end
end

local function GetBoundingInfo(obj)
    if typeof(obj) ~= "Instance" then return nil, nil, nil end

    if obj:IsA("Player") then
        if not obj.Character then return nil, nil, nil end
        obj = obj.Character
    end

    -- Check lại lần nữa phòng trường hợp player character load sau
    if IsSelf(obj) then return nil, nil, nil end

    local hum = obj:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then return nil, nil, nil end

    if obj:IsA("Model") then
        local cf, size = obj:GetBoundingBox()
        if size.Magnitude > 0.1 then
            return cf.Position, size, obj, hum
        end
    elseif obj:IsA("BasePart") then
        return obj.Position, obj.Size, obj, hum
    end

    return nil, nil, nil
end

local function UpdateTracerFrame(frame, from, to, color)
    local distance = (to - from).Magnitude
    local center = (from + to) / 2
    local angle = math.atan2(to.Y - from.Y, to.X - from.X)

    frame.Size = UDim2.new(0, distance, 0, 1.5)
    frame.Position = UDim2.new(0, center.X, 0, center.Y)
    frame.Rotation = math.deg(angle)
    frame.BackgroundColor3 = color
end

ESP.Connection = RunService.RenderStepped:Connect(function()
    local clock = os.clock()
    local heavy = (clock - ESP.Cache.LastUpdate) >= ESP.Config.UpdateInterval
    if heavy then ESP.Cache.LastUpdate = clock end

    local myPos = Camera.CFrame.Position  
    local playerCharacter = localPlayer.Character
    if playerCharacter then  
        local root = playerCharacter:FindFirstChild("HumanoidRootPart") or playerCharacter:FindFirstChild("Head")  
        if root then myPos = root.Position end  
    end  
    
    local tracerPos = GetTracerPos()  

    for id, d in pairs(ESP.Objects) do  
        local obj = d.Object  

        if IsSelf(obj) then
            SetAllVisible(d.Drawings, false)
            continue
        end
        
        if d.IsInstance and (not obj or not obj.Parent) then  
            ESP:Huy(id)  
            continue  
        end  

        if not d.IsActive then  
            SetAllVisible(d.Drawings, false) 
            continue  
        end  

        local cPos, size, adornee, hum = GetBoundingInfo(obj)

        if not cPos then
            SetAllVisible(d.Drawings, false)
            continue
        end

        local dist = (myPos - cPos).Magnitude   

        if dist > ESP.Config.MaxDistance then  
            SetAllVisible(d.Drawings, false)
            continue   
        end  

        local set = d.Settings  
        local draw = AllocateDrawings(d)
        local col = set.Color  
        local rootPart = obj:IsA("Model") and obj:FindFirstChild("HumanoidRootPart") or adornee

        if heavy and set.UseText then  
            local tArr = {}  
            if set.ShowName ~= false then table.insert(tArr, d.BaseName) end  
            if set.ShowHP and hum then table.insert(tArr, string.format("[%d/%d]", math.floor(hum.Health), math.floor(hum.MaxHealth))) end  
            if set.ShowDistance then table.insert(tArr, string.format("[%dm]", math.floor(dist))) end  
            d.DisplayText = table.concat(tArr, " ")  
        end  

        if set.UseHighlight and draw.Highlight then  
            if not draw.Highlight.Enabled then draw.Highlight.Enabled = true end  
            if draw.Highlight.Adornee ~= adornee then draw.Highlight.Adornee = adornee end  
            if draw.Highlight.FillColor ~= col then draw.Highlight.FillColor = col end  
        elseif draw.Highlight and draw.Highlight.Enabled then 
            draw.Highlight.Enabled = false 
        end  

        if set.UseBox and draw.Box then
            if not draw.Box.Enabled then draw.Box.Enabled = true end
            if draw.Box.Adornee ~= rootPart then draw.Box.Adornee = rootPart end
            if draw.BoxStroke.Color ~= col then draw.BoxStroke.Color = col end
        elseif draw.Box and draw.Box.Enabled then
            draw.Box.Enabled = false
        end

        if set.UseText and draw.TextBill then
            if not draw.TextBill.Enabled then draw.TextBill.Enabled = true end
            if draw.TextBill.Adornee ~= rootPart then draw.TextBill.Adornee = rootPart end
            draw.TextLabel.Text = d.DisplayText
            if draw.TextLabel.TextColor3 ~= col then draw.TextLabel.TextColor3 = col end
        elseif draw.TextBill and draw.TextBill.Enabled then
            draw.TextBill.Enabled = false
        end

        if set.UseTracer and draw.Tracer then
            local sPos, on = Camera:WorldToViewportPoint(cPos)
            if on then
                if not draw.Tracer.Visible then draw.Tracer.Visible = true end
                UpdateTracerFrame(draw.Tracer, tracerPos, Vector2.new(sPos.X, sPos.Y), col)
            else
                if draw.Tracer.Visible then draw.Tracer.Visible = false end
            end
        elseif draw.Tracer and draw.Tracer.Visible then
            draw.Tracer.Visible = false
        end
    end
end)

