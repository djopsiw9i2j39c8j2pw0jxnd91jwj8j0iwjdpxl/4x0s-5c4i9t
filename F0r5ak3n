CoreData.Logic.FindNearestTarget = function(folder)
    CoreData.State.ShortestDist = math.huge
    CoreData.State.NearestTarget = nil
    
    if not (CoreData.State.CachedRoot and folder) then return nil, math.huge end

    for _, char in ipairs(folder:GetChildren()) do
        if char ~= playerCharacter and char:FindFirstChild("HumanoidRootPart") then
            CoreData.State.TempDist = (char.HumanoidRootPart.Position - CoreData.State.CachedRoot.Position).Magnitude
            if CoreData.State.TempDist < CoreData.State.ShortestDist then
                CoreData.State.ShortestDist = CoreData.State.TempDist
                CoreData.State.NearestTarget = char.HumanoidRootPart
            end
        end
    end
    return CoreData.State.NearestTarget, CoreData.State.ShortestDist
end

CoreData.Logic.GetAbilityTarget = function(configKey, identityCheck)
    if not (identityCheck and CoreData.Config[configKey].Enabled) then return nil end
    
    CoreData.State.WantsKillers = table.find(CoreData.Config[configKey].Targets, "Killers")
    CoreData.State.WantsSurvivors = table.find(CoreData.Config[configKey].Targets, "Survivors")

    if CoreData.State.WantsKillers and not CoreData.State.WantsSurvivors then return CoreData.State.Targets.Killers end
    if CoreData.State.WantsSurvivors and not CoreData.State.WantsKillers then return CoreData.State.Targets.Survivors end
    
    if CoreData.State.WantsKillers and CoreData.State.WantsSurvivors then
        if CoreData.State.KillerDist < CoreData.State.SurvDist then
            return CoreData.State.Targets.Killers or CoreData.State.Targets.Survivors
        else
            return CoreData.State.Targets.Survivors or CoreData.State.Targets.Killers
        end
    end
    return nil
end

CoreData.Logic.GetFlatAimCFrame = function(originPosition, targetPosition)
    return CFrame.lookAt(originPosition, Vector3.new(targetPosition.X, originPosition.Y, targetPosition.Z))
end

CoreData.Logic.HookMouse = function(modulePath, funcName, hookState, oldHook, targetsMap)
    CoreData.State.CurrentMod = ReplicatedStorage
    for _, path in ipairs(modulePath) do
        CoreData.State.CurrentMod = CoreData.State.CurrentMod and CoreData.State.CurrentMod:FindFirstChild(path)
    end
    
    if not CoreData.State.CurrentMod then return end
    CoreData.State.ReqMod = require(CoreData.State.CurrentMod)
    
    if type(CoreData.State.ReqMod) ~= "table" or not CoreData.State.ReqMod[funcName] or CoreData.Hooks[hookState] then return end
    
    CoreData.Hooks[hookState] = true
    
    CoreData.Hooks[oldHook] = hookfunction(CoreData.State.ReqMod[funcName], function(self, ...)
        if CoreData.State.CachedRoot then
            for _, skillKey in ipairs(targetsMap) do
                if CoreData.Config[skillKey].Enabled and CoreData.State.Targets[skillKey] then
                    local dist = (CoreData.State.Targets[skillKey].Position - CoreData.State.CachedRoot.Position).Magnitude
                    if dist <= CoreData.Config.MaxAimDistance then
                        return CoreData.State.Targets[skillKey].Position
                    end
                end
            end
        end
        return CoreData.Hooks[oldHook](self, ...)
    end)
end

