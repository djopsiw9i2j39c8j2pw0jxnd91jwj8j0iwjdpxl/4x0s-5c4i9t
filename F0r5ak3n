AbilityEvent = {
    State = {
        AutoSkills = {},
        Loop = nil,
        Target = nil,
        Charge = nil
    },

    GetNumber = function(value)
        return tonumber(type(value) == "string" and string.gsub(value, "[^%d%.]", "") or value) or 0
    end,

    GetCharge = function(btn)
        if btn:GetAttribute("Charges") or btn:GetAttribute("Charge") then
            return tonumber(btn:GetAttribute("Charges") or btn:GetAttribute("Charge")) or 0
        end

        for _, key in ipairs({"Charges", "Charge", "Count", "Amount"}) do
            if btn:FindFirstChild(key) then
                return AbilityEvent.GetNumber(btn[key].Text or btn[key].Value)
            end
        end

        return 0
    end,

    IsReverse = function(value)
        return type(value) == "string" and string.lower(value) == "true" or value == true
    end,

    Fire = function(btn)
        if type(firesignal) == "function" then
            firesignal(btn.MouseButton1Click)
            firesignal(btn.MouseButton1Down)
            firesignal(btn.MouseButton1Up)
            firesignal(btn.Activated)
        elseif btn.Activate then
            btn:Activate()
        end
    end,

    CanUse = function(btn, requiredCharges, reverseCheck, chargeBtn)
        if not btn then return false end

        for _, child in ipairs(btn:GetChildren()) do
            if child:GetAttribute("IsLockObject") then return false end
        end

        if btn:FindFirstChild("CooldownTime") and btn.CooldownTime.Visible and AbilityEvent.GetNumber(btn.CooldownTime.Text) > 0 then
            return false
        end

        if requiredCharges and tonumber(requiredCharges) then
            if (AbilityEvent.IsReverse(reverseCheck) and AbilityEvent.GetCharge(chargeBtn or btn) >= tonumber(requiredCharges))
            or (not AbilityEvent.IsReverse(reverseCheck) and AbilityEvent.GetCharge(chargeBtn or btn) < tonumber(requiredCharges)) then
                return false
            end
        end

        return true
    end,

    GetNodes = function(abilityName, checkAbilityName)
        if not (PlayerGui and PlayerGui:FindFirstChild("MainUI") and PlayerGui.MainUI:FindFirstChild("AbilityContainer")) then return end
        if not PlayerGui.MainUI.AbilityContainer:FindFirstChild(tostring(abilityName)) then return end
        if checkAbilityName and not PlayerGui.MainUI.AbilityContainer:FindFirstChild(tostring(checkAbilityName)) then return end

        return PlayerGui.MainUI.AbilityContainer[tostring(abilityName)],
               PlayerGui.MainUI.AbilityContainer[tostring(checkAbilityName or abilityName)]
    end,

    HandleAuto = function(self)
        for ability, args in pairs(self.State.AutoSkills) do
            self.State.Target, self.State.Charge = self.GetNodes(ability, args.checkName)
            if self.State.Target and self.CanUse(self.State.Target, args.reqCharge, args.revCheck, self.State.Charge) then
                self.Fire(self.State.Target)
            end
        end
    end,

    Use = function(self, abilityName, requiredCharges, reverseCheck, checkAbilityName, autoUse)
        if autoUse then
            self.State.AutoSkills[abilityName] = {
                reqCharge = requiredCharges,
                revCheck = reverseCheck,
                checkName = checkAbilityName
            }
            
            if not self.State.Loop then
                self.State.Loop = RunService.Heartbeat:Connect(function()
                    self:HandleAuto()
                end)
            end
        else
            self.State.AutoSkills[abilityName] = nil
            
            if self.State.Loop and next(self.State.AutoSkills) == nil then
                self.State.Loop:Disconnect()
                self.State.Loop = nil
            end
        end

        self.State.Target, self.State.Charge = self.GetNodes(abilityName, checkAbilityName)
        
        if self.State.Target and self.CanUse(self.State.Target, requiredCharges, reverseCheck, self.State.Charge) then
            self.Fire(self.State.Target)
            return true
        end

        return false
    end
}

