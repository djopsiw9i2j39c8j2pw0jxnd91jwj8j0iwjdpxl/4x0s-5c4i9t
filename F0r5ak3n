HitboxDevilSS1.NormalizeId = function(id) 
	return tostring(id):match("%d+") 
end

HitboxDevilSS1.ExtractIds = function(val)
	if type(val) == "string" or type(val) == "number" then
		HitboxDevilSS1.State.ParsedId = HitboxDevilSS1.NormalizeId(val)
		if HitboxDevilSS1.State.ParsedId then 
			HitboxDevilSS1.State.ActionCache[HitboxDevilSS1.State.ParsedId] = true 
		end
	elseif type(val) == "table" then
		for _, subVal in pairs(val) do 
			HitboxDevilSS1.ExtractIds(subVal) 
		end
	end
end

HitboxDevilSS1.WalkTableAndCache = function(tbl, depth)
	if depth > 4 then return end
	for k, v in pairs(tbl) do
		HitboxDevilSS1.State.KeyMatched = false
		if type(k) == "string" then
			HitboxDevilSS1.State.LowerK = k:lower()
			for _, key in ipairs(HitboxDevilSS1.Config.SkillKeys) do
				if HitboxDevilSS1.State.LowerK == key:lower() then
					HitboxDevilSS1.ExtractIds(v)
					HitboxDevilSS1.State.KeyMatched = true
					break
				end
			end
		end
		if type(v) == "table" and not HitboxDevilSS1.State.KeyMatched then 
			HitboxDevilSS1.WalkTableAndCache(v, depth + 1) 
		end
	end
end

HitboxDevilSS1.ScanKillerAssets = function()
	HitboxDevilSS1.State.Assets = ReplicatedStorage:FindFirstChild("Assets")
	if not HitboxDevilSS1.State.Assets then return end

	HitboxDevilSS1.State.TargetFolders = {
		HitboxDevilSS1.State.Assets:FindFirstChild("Killers"),
		HitboxDevilSS1.State.Assets:FindFirstChild("Skins") and HitboxDevilSS1.State.Assets.Skins:FindFirstChild("Killers")
	}

	for _, folder in ipairs(HitboxDevilSS1.State.TargetFolders) do
		if folder then
			for _, module in ipairs(folder:GetDescendants()) do
				if module:IsA("ModuleScript") then
					HitboxDevilSS1.State.Ok, HitboxDevilSS1.State.Data = pcall(require, module)
					if HitboxDevilSS1.State.Ok and type(HitboxDevilSS1.State.Data) == "table" then
						HitboxDevilSS1.WalkTableAndCache(HitboxDevilSS1.State.Data, 0)
					end
				end
			end
		end
	end
end

HitboxDevilSS1.UpdateTargetModes = function(list)
	table.clear(HitboxDevilSS1.Config.TargetModes)
	for _, v in ipairs(list) do 
		HitboxDevilSS1.Config.TargetModes[v] = true 
	end
end

HitboxDevilSS1.GetTarget = function()
	HitboxDevilSS1.State.BestDist = HitboxDevilSS1.Config.Distance
	HitboxDevilSS1.State.BestTarget = nil
	HitboxDevilSS1.State.MyRoot = playerCharacter and playerCharacter:FindFirstChild("HumanoidRootPart")
	if not HitboxDevilSS1.State.MyRoot then return nil end

	HitboxDevilSS1.State.SearchFolders = {}
	if HitboxDevilSS1.Config.TargetModes["Survivors"] then table.insert(HitboxDevilSS1.State.SearchFolders, Workspace:FindFirstChild("Survivors") or survivorsFolder) end
	if HitboxDevilSS1.Config.TargetModes["Killers"] then table.insert(HitboxDevilSS1.State.SearchFolders, Workspace:FindFirstChild("Killers") or killersFolder) end

	for _, folder in ipairs(HitboxDevilSS1.State.SearchFolders) do
		if folder then
			for _, model in ipairs(folder:GetChildren()) do
				if model:IsA("Model") and model ~= playerCharacter then
					HitboxDevilSS1.State.EHum = model:FindFirstChild("Humanoid")
					HitboxDevilSS1.State.ERoot = model:FindFirstChild("HumanoidRootPart")
					if HitboxDevilSS1.State.EHum and HitboxDevilSS1.State.ERoot and HitboxDevilSS1.State.EHum.Health > 0 then
						HitboxDevilSS1.State.Dist = (HitboxDevilSS1.State.ERoot.Position - HitboxDevilSS1.State.MyRoot.Position).Magnitude
						if HitboxDevilSS1.State.Dist < HitboxDevilSS1.State.BestDist then
							HitboxDevilSS1.State.BestDist = HitboxDevilSS1.State.Dist
							HitboxDevilSS1.State.BestTarget = HitboxDevilSS1.State.ERoot
						end
					end
				end
			end
		end
	end
	return HitboxDevilSS1.State.BestTarget
end

HitboxDevilSS1.SetCharVisibility = function(char, visible)
	if not char then return end
	HitboxDevilSS1.State.TargetTrans = visible and 0 or 1
	
	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") or part:IsA("Decal") or part:IsA("Texture") then
			HitboxDevilSS1.State.PName = string.lower(part.Name)
			if HitboxDevilSS1.State.PName ~= "humanoidrootpart" and not string.find(HitboxDevilSS1.State.PName, "hitbox") then
				part.LocalTransparencyModifier = HitboxDevilSS1.State.TargetTrans
			end
		end
	end
end

HitboxDevilSS1.CreateNoCollision = function(part0, charModel)
	for _, part1 in ipairs(charModel:GetDescendants()) do
		if part1:IsA("BasePart") then
			HitboxDevilSS1.State.NCC = Instance.new("NoCollisionConstraint")
			HitboxDevilSS1.State.NCC.Part0 = part0
			HitboxDevilSS1.State.NCC.Part1 = part1
			HitboxDevilSS1.State.NCC.Parent = part0
		end
	end
end

HitboxDevilSS1.DestroyClone = function()
	pcall(function() RunService:UnbindFromRenderStep("HitboxDevil_BlinkSync") end)
	
	table.clear(HitboxDevilSS1.State.CloneTracks)

	if HitboxDevilSS1.State.CloneModel then
		HitboxDevilSS1.State.CloneModel:Destroy()
		HitboxDevilSS1.State.CloneModel = nil
	end
	
	HitboxDevilSS1.State.CloneHum = nil
	HitboxDevilSS1.State.CloneRoot = nil
	HitboxDevilSS1.State.CloneAnimator = nil
	
	if playerCharacter then
		HitboxDevilSS1.SetCharVisibility(playerCharacter, true)
		HitboxDevilSS1.State.MyHum = playerCharacter:FindFirstChildOfClass("Humanoid")
		if HitboxDevilSS1.State.MyHum and Camera then
			Camera.CameraSubject = HitboxDevilSS1.State.MyHum
		end
	end
end

HitboxDevilSS1.CreateClone = function()
	HitboxDevilSS1.DestroyClone()
	if not playerCharacter or not HitboxDevilSS1.Config.Enabled or HitboxDevilSS1.Config.Mode ~= "Hitbox 10shedletsky" then return end
	
	playerCharacter.Archivable = true
	HitboxDevilSS1.State.CloneModel = playerCharacter:Clone()
	playerCharacter.Archivable = false
	
	for _, obj in ipairs(HitboxDevilSS1.State.CloneModel:GetDescendants()) do
		if obj:IsA("Script") or obj:IsA("LocalScript") then 
			obj:Destroy() 
		elseif obj:IsA("BasePart") then
			obj.CanTouch = false
			obj.CanQuery = false
			obj.Massless = true
			
			HitboxDevilSS1.State.ObjName = string.lower(obj.Name)
			if HitboxDevilSS1.State.ObjName == "humanoidrootpart" or string.find(HitboxDevilSS1.State.ObjName, "hitbox") then
				obj.Transparency = 1
			end
			
			HitboxDevilSS1.CreateNoCollision(obj, playerCharacter)
		end
	end
	
	HitboxDevilSS1.State.CloneModel.Name = "BlinkClone_" .. localPlayer.Name
	HitboxDevilSS1.State.CloneModel.Parent = Workspace
	
	HitboxDevilSS1.State.CloneHum = HitboxDevilSS1.State.CloneModel:FindFirstChildOfClass("Humanoid")
	HitboxDevilSS1.State.CloneRoot = HitboxDevilSS1.State.CloneModel:FindFirstChild("HumanoidRootPart")
	
	if HitboxDevilSS1.State.CloneHum then
		HitboxDevilSS1.State.CloneHum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None 
		HitboxDevilSS1.State.CloneAnimator = HitboxDevilSS1.State.CloneHum:FindFirstChildOfClass("Animator")
		if not HitboxDevilSS1.State.CloneAnimator then
			HitboxDevilSS1.State.CloneAnimator = Instance.new("Animator", HitboxDevilSS1.State.CloneHum)
		end
	end
	
	if HitboxDevilSS1.State.CloneRoot then
		HitboxDevilSS1.State.CloneRoot.Anchored = false
	end

	RunService:BindToRenderStep("HitboxDevil_BlinkSync", 199, HitboxDevilSS1.BlinkSyncLoop)
end

HitboxDevilSS1.BlinkSyncLoop = function(dt)
	if not HitboxDevilSS1.Config.Enabled or HitboxDevilSS1.Config.Mode ~= "Hitbox 10shedletsky" then 
		return HitboxDevilSS1.DestroyClone() 
	end

	HitboxDevilSS1.SetCharVisibility(playerCharacter, false)
	if HitboxDevilSS1.State.CloneHum and Camera and Camera.CameraSubject ~= HitboxDevilSS1.State.CloneHum then
		Camera.CameraSubject = HitboxDevilSS1.State.CloneHum
	end
	
	HitboxDevilSS1.State.MyRoot = playerCharacter and playerCharacter:FindFirstChild("HumanoidRootPart")
	HitboxDevilSS1.State.OrigHum = playerCharacter and playerCharacter:FindFirstChildOfClass("Humanoid")
	HitboxDevilSS1.State.OrigAnimator = HitboxDevilSS1.State.OrigHum and HitboxDevilSS1.State.OrigHum:FindFirstChildOfClass("Animator")

	if HitboxDevilSS1.State.MyRoot and HitboxDevilSS1.State.CloneRoot then
		if not HitboxDevilSS1.State.IsBlinking then
			HitboxDevilSS1.State.CloneRoot.CFrame = HitboxDevilSS1.State.MyRoot.CFrame
			HitboxDevilSS1.State.CloneRoot.AssemblyLinearVelocity = HitboxDevilSS1.State.MyRoot.AssemblyLinearVelocity
		else
			if HitboxDevilSS1.State.OrigHum then
				HitboxDevilSS1.State.CloneHum:Move(HitboxDevilSS1.State.OrigHum.MoveDirection, false)
			end
		end
	end

	if HitboxDevilSS1.State.CloneAnimator and HitboxDevilSS1.State.OrigAnimator then
		table.clear(HitboxDevilSS1.State.RealTracks)
		
		for _, track in ipairs(HitboxDevilSS1.State.OrigAnimator:GetPlayingAnimationTracks()) do
			if track.Animation and track.Animation.AnimationId then
				HitboxDevilSS1.State.AnimId = track.Animation.AnimationId
				HitboxDevilSS1.State.RealTracks[HitboxDevilSS1.State.AnimId] = track

				if not HitboxDevilSS1.State.CloneTracks[HitboxDevilSS1.State.AnimId] then
					HitboxDevilSS1.State.CloneTracks[HitboxDevilSS1.State.AnimId] = HitboxDevilSS1.State.CloneAnimator:LoadAnimation(track.Animation)
					HitboxDevilSS1.State.CloneTracks[HitboxDevilSS1.State.AnimId]:Play()
				end

				HitboxDevilSS1.State.CTrack = HitboxDevilSS1.State.CloneTracks[HitboxDevilSS1.State.AnimId]
				HitboxDevilSS1.State.CTrack:AdjustSpeed(track.Speed)
				HitboxDevilSS1.State.CTrack:AdjustWeight(track.WeightCurrent)
			end
		end

		for id, cTrack in pairs(HitboxDevilSS1.State.CloneTracks) do
			if not HitboxDevilSS1.State.RealTracks[id] then
				cTrack:Stop()
				HitboxDevilSS1.State.CloneTracks[id] = nil
			end
		end
	end
end

HitboxDevilSS1.ManageTempPart = function(create)
	if create then
		if not HitboxDevilSS1.State.TempPart or not HitboxDevilSS1.State.TempPart.Parent then
			HitboxDevilSS1.State.TempPart = Instance.new("Part")
			HitboxDevilSS1.State.TempPart.Name = "HitboxDevil_TempRoot"
			HitboxDevilSS1.State.TempPart.Size = Vector3.new(2, 2, 1)
			HitboxDevilSS1.State.TempPart.Transparency = 1
			HitboxDevilSS1.State.TempPart.CanCollide = false
			HitboxDevilSS1.State.TempPart.Anchored = true
			HitboxDevilSS1.State.TempPart.Parent = Workspace
		end
		if playerCharacter and playerCharacter.PrimaryPart ~= HitboxDevilSS1.State.TempPart then
			HitboxDevilSS1.State.OldPrimaryPart = playerCharacter.PrimaryPart
			playerCharacter.PrimaryPart = HitboxDevilSS1.State.TempPart
		end
	else
		if playerCharacter and HitboxDevilSS1.State.OldPrimaryPart and HitboxDevilSS1.State.OldPrimaryPart.Parent then
			playerCharacter.PrimaryPart = HitboxDevilSS1.State.OldPrimaryPart
		end
		if HitboxDevilSS1.State.TempPart then
			HitboxDevilSS1.State.TempPart:Destroy()
			HitboxDevilSS1.State.TempPart = nil
		end
	end
end

HitboxDevilSS1.StopReach = function()
	HitboxDevilSS1.State.IsAttacking = false
	HitboxDevilSS1.State.ActiveTrack = nil
	HitboxDevilSS1.State.ActiveSound = nil
	
	if HitboxDevilSS1.State.ReachConn then
		HitboxDevilSS1.State.ReachConn:Disconnect()
		HitboxDevilSS1.State.ReachConn = nil
	end
	
	if HitboxDevilSS1.Config.Mode == "Hitbox 10shedletsky" and HitboxDevilSS1.State.IsBlinking then
		HitboxDevilSS1.State.IsBlinking = false
		if HitboxDevilSS1.State.CloneRoot and playerCharacter then
			HitboxDevilSS1.State.MyRoot = playerCharacter:FindFirstChild("HumanoidRootPart")
			if HitboxDevilSS1.State.MyRoot then
				HitboxDevilSS1.State.MyRoot.CFrame = HitboxDevilSS1.State.CloneRoot.CFrame
				HitboxDevilSS1.State.MyRoot.AssemblyLinearVelocity = HitboxDevilSS1.State.CloneRoot.AssemblyLinearVelocity
			end
		end
	else
		HitboxDevilSS1.State.IsBlinking = false
		HitboxDevilSS1.ManageTempPart(false)
	end
end

HitboxDevilSS1.IsActionEnded = function(obj)
	if not obj then return true end
	if obj:IsA("AnimationTrack") then
		return not obj.IsPlaying or (obj.Length > 0 and obj.TimePosition >= obj.Length * 0.9)
	elseif obj:IsA("Sound") then
		return not obj.IsPlaying or (obj.TimeLength > 0 and obj.TimePosition >= obj.TimeLength * 0.9)
	end
	return true
end

HitboxDevilSS1.ReachLoop = function()
	if not HitboxDevilSS1.Config.Enabled or not HitboxDevilSS1.State.IsAttacking then 
		return HitboxDevilSS1.StopReach() 
	end

	HitboxDevilSS1.State.ActiveObj = HitboxDevilSS1.State.ActiveTrack or HitboxDevilSS1.State.ActiveSound
	HitboxDevilSS1.State.MyRoot = playerCharacter and playerCharacter:FindFirstChild("HumanoidRootPart")

	if HitboxDevilSS1.IsActionEnded(HitboxDevilSS1.State.ActiveObj) or not HitboxDevilSS1.State.MyRoot then
		return HitboxDevilSS1.StopReach()
	end

	HitboxDevilSS1.State.Target = HitboxDevilSS1.GetTarget()
	if not HitboxDevilSS1.State.Target then 
		return HitboxDevilSS1.StopReach() 
	end

	if HitboxDevilSS1.Config.Mode == "Silent Hitbox" then
		if HitboxDevilSS1.State.TempPart then
			HitboxDevilSS1.State.TempPart.CFrame = HitboxDevilSS1.State.Target.CFrame
		end
	elseif HitboxDevilSS1.Config.Mode == "Hitbox 10shedletsky" then
		HitboxDevilSS1.State.IsBlinking = true
		HitboxDevilSS1.State.MyRoot.AssemblyLinearVelocity = Vector3.zero
		HitboxDevilSS1.State.MyRoot.CFrame = HitboxDevilSS1.State.Target.CFrame
	end
end

HitboxDevilSS1.OnActionTriggered = function(id, trackOrSound)
	if not HitboxDevilSS1.Config.Enabled then return end
	HitboxDevilSS1.State.Normalized = HitboxDevilSS1.NormalizeId(id)
	
	if HitboxDevilSS1.State.Normalized and HitboxDevilSS1.State.ActionCache[HitboxDevilSS1.State.Normalized] then
		
		HitboxDevilSS1.State.Target = HitboxDevilSS1.GetTarget()
		if not HitboxDevilSS1.State.Target then return end 

		HitboxDevilSS1.StopReach() 
		HitboxDevilSS1.State.IsAttacking = true
		
		if HitboxDevilSS1.Config.Mode == "Silent Hitbox" then
			HitboxDevilSS1.ManageTempPart(true)
		end
		
		if typeof(trackOrSound) == "Instance" and trackOrSound:IsA("AnimationTrack") then
			HitboxDevilSS1.State.ActiveTrack = trackOrSound
			trackOrSound.Stopped:Once(HitboxDevilSS1.StopReach)
		elseif typeof(trackOrSound) == "Instance" and trackOrSound:IsA("Sound") then
			HitboxDevilSS1.State.ActiveSound = trackOrSound
			trackOrSound.Ended:Once(HitboxDevilSS1.StopReach)
			trackOrSound.Stopped:Once(HitboxDevilSS1.StopReach)
		end

		HitboxDevilSS1.State.ReachConn = RunService.RenderStepped:Connect(HitboxDevilSS1.ReachLoop)
	end
end

HitboxDevilSS1.HookPlayer = function(char)
	if not char then return end
	HitboxDevilSS1.StopReach()
	HitboxDevilSS1.DestroyClone()
	
	for _, conn in ipairs(HitboxDevilSS1.State.Conns) do conn:Disconnect() end
	table.clear(HitboxDevilSS1.State.Conns)
	
	HitboxDevilSS1.State.Hum = char:WaitForChild("Humanoid", 5)
	HitboxDevilSS1.State.Animator = HitboxDevilSS1.State.Hum and HitboxDevilSS1.State.Hum:WaitForChild("Animator", 5)
	
	if HitboxDevilSS1.State.Hum then
		if HitboxDevilSS1.State.DeathConn then HitboxDevilSS1.State.DeathConn:Disconnect() end
		HitboxDevilSS1.State.DeathConn = HitboxDevilSS1.State.Hum.Died:Connect(function()
			HitboxDevilSS1.StopReach()
			HitboxDevilSS1.DestroyClone()
		end)
	end
	
	if HitboxDevilSS1.State.Animator then
		table.insert(HitboxDevilSS1.State.Conns, HitboxDevilSS1.State.Animator.AnimationPlayed:Connect(function(track)
			if track.Animation and track.Animation.AnimationId then
				HitboxDevilSS1.OnActionTriggered(track.Animation.AnimationId, track)
			end
		end))
	end
	
	table.insert(HitboxDevilSS1.State.Conns, char.DescendantAdded:Connect(function(child)
		if child:IsA("Sound") then
			table.insert(HitboxDevilSS1.State.Conns, child.Played:Connect(function()
				HitboxDevilSS1.OnActionTriggered(child.SoundId, child)
			end))
			if child.Playing then HitboxDevilSS1.OnActionTriggered(child.SoundId, child) end
		end
	end))

	if HitboxDevilSS1.Config.Enabled and HitboxDevilSS1.Config.Mode == "Hitbox 10shedletsky" then
		task.defer(HitboxDevilSS1.CreateClone)
	end
end

