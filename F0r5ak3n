RunService.Heartbeat:Connect(function(dt)
    if not playerCharacter then return end
    local humanoid = playerCharacter:FindFirstChildOfClass("Humanoid")
    local hrp = playerCharacter:FindFirstChild("HumanoidRootPart")
    if not humanoid or not hrp then return end

    if PowerManager.Toggles.Fly then
        if not PowerManager.AntiGravity then
            PowerManager.AntiGravity = Instance.new("BodyVelocity", hrp)
            PowerManager.AntiGravity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            PowerManager.AntiGravity.Velocity = Vector3.zero
        end

        local moveDir = humanoid.MoveDirection
        if moveDir.Magnitude > 0 then
            local cam = Workspace.CurrentCamera
            local _, rotY, _ = cam.CFrame:ToEulerAnglesYXZ()
            local flatCam = CFrame.Angles(0, rotY, 0)
            
            local move3D = (cam.CFrame.LookVector * moveDir:Dot(flatCam.LookVector)) + 
                           (cam.CFrame.RightVector * moveDir:Dot(flatCam.RightVector))
            
            hrp.CFrame = hrp.CFrame + (move3D.Unit * PowerManager.Values.FlySpeed * dt)
        end
        hrp.AssemblyLinearVelocity = Vector3.zero

    elseif PowerManager.Toggles.Speed and humanoid.MoveDirection.Magnitude > 0 then
        hrp.CFrame = hrp.CFrame + (humanoid.MoveDirection * PowerManager.Values.Speed * dt)
    end
end)

