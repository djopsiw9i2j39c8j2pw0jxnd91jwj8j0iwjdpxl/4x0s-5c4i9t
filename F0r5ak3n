local ESP = getgenv().MyESPFramwork

local ESPManager = {
    ESP = ESP,
    UI = MyUIElements,
    State = {
        CurrentMap = nil
    },
    Constants = {
        Modes = {"Highlight", "Text", "Box", "Tracer"},
        TextBasic = {"Name", "HP", "Distance"},
        TextProgress = {"Name", "Progress", "Distance"},
        TracerOrigin = {
            Top = "Top",
            Bottom = "Bottom",
            Center = "Center",
            Mouse = "Mouse"
        }
    },
    Entries = {},
    FolderRouters = {},
    Connections = {
        Global = {},
        Map = {}
    },
    MapEntryKeys = {"Generator", "FakeGenerator"}
}

function ESPManager:CreateBoolMap(values, defaults)
    local map = {}
    for _, value in pairs(values or {}) do
        map[value] = defaults and defaults[value] or false
    end
    return map
end

function ESPManager:BoolMapToArray(map, values)
    local selected = {}
    for _, value in pairs(values or {}) do
        if map and map[value] then
            selected[#selected + 1] = value
        end
    end
    return selected
end

function ESPManager:ApplySelection(target, values, selectedValues)
    for _, value in pairs(values or {}) do
        target[value] = false
    end

    for key, value in pairs(selectedValues or {}) do
        local selected = type(key) == "string" and key or value
        if target[selected] ~= nil then
            target[selected] = true
        end
    end
end

function ESPManager:GetObjectDebugId(object)
    if not object then
        return "Unknown"
    end

    local success, result = pcall(object.GetDebugId, object)
    if success and result then
        return result
    end

    return object.Name or "Unknown"
end

function ESPManager:GetObjectId(entry, object)
    return entry.IdPrefix .. self:GetObjectDebugId(object)
end

function ESPManager:GetChildrenMatching(parent, checker)
    local list = {}
    if not parent then
        return list
    end

    for _, child in pairs(parent:GetChildren()) do
        if not checker or checker(child) then
            list[#list + 1] = child
        end
    end

    return list
end

function ESPManager:GetProgressValue(entry, object)
    if not entry.ProgressChild or not object then
        return nil
    end

    local progress = object:FindFirstChild(entry.ProgressChild)
    if progress and progress:IsA("NumberValue") then
        return progress
    end

    return nil
end

function ESPManager:ShouldRender(entry, object, progress)
    if entry.ShouldRenderObject then
        return entry.ShouldRenderObject(self, entry, object, progress)
    end
    return true
end

function ESPManager:GetDisplayName(entry, object, progress)
    if entry.GetDisplayName then
        return entry.GetDisplayName(self, entry, object, progress)
    end
    return object.Name
end

function ESPManager:GetESPOptions(entry, object, progress)
    return {
        UseHighlight = entry.Config.Types.Highlight,
        UseText = entry.Config.Types.Text,
        UseBox = entry.Config.Types.Box,
        UseTracer = entry.Config.Types.Tracer,
        Color = entry.Config.Color,
        ShowName = entry.Config.TextFormat.Name or false,
        ShowHP = entry.Config.TextFormat.HP or false,
        ShowDistance = entry.Config.TextFormat.Distance or false,
        CustomName = self:GetDisplayName(entry, object, progress)
    }
end

function ESPManager:DisconnectConnection(connection)
    if connection then
        connection:Disconnect()
    end
end

function ESPManager:DisconnectConnectionTable(connectionTable)
    for key, connection in pairs(connectionTable or {}) do
        self:DisconnectConnection(connection)
        connectionTable[key] = nil
    end
end

function ESPManager:UnregisterObject(entry, id)
    self.ESP:Huy(id)
    entry.ActiveIds[id] = nil

    if entry.Watched[id] then
        self:DisconnectConnection(entry.Watched[id])
        entry.Watched[id] = nil
    end
end

function ESPManager:ClearEntry(entry)
    for id in pairs(entry.ActiveIds) do
        self:UnregisterObject(entry, id)
    end

    for id in pairs(entry.Watched) do
        if entry.Watched[id] then
            self:DisconnectConnection(entry.Watched[id])
            entry.Watched[id] = nil
        end
    end
end

function ESPManager:WatchProgress(entry, object, id, progress)
    if not progress or entry.Watched[id] then
        return
    end

    entry.Watched[id] = progress:GetPropertyChangedSignal("Value"):Connect(function()
        if not entry.Config.Enabled then
            self:UnregisterObject(entry, id)
            return
        end

        if object and object.Parent then
            self:RegisterObject(entry, object, id)
        else
            self:UnregisterObject(entry, id)
        end
    end)
end

function ESPManager:RegisterObject(entry, object, id)
    if not object then
        return
    end

    id = id or self:GetObjectId(entry, object)
    local progress = self:GetProgressValue(entry, object)

    if progress then
        self:WatchProgress(entry, object, id, progress)
    end

    if not self:ShouldRender(entry, object, progress) then
        self:UnregisterObject(entry, id)
        return
    end

    self.ESP:DangKy(id, object, self:GetESPOptions(entry, object, progress))
    entry.ActiveIds[id] = true
end

function ESPManager:UpdateEntry(entry)
    if not entry then
        return
    end

    if not entry.Config.Enabled then
        self:ClearEntry(entry)
        return
    end

    local liveIds = {}

    for _, object in pairs(entry.GetObjects(self, entry) or {}) do
        if object and (not entry.Matcher or entry.Matcher(self, entry, object)) then
            local id = self:GetObjectId(entry, object)
            liveIds[id] = true
            self:RegisterObject(entry, object, id)
        end
    end

    for id in pairs(entry.ActiveIds) do
        if not liveIds[id] then
            self:UnregisterObject(entry, id)
        end
    end
end

function ESPManager:UpdateEntryByKey(key)
    self:UpdateEntry(self.Entries[key])
end

function ESPManager:AddFolderRoute(folder, route)
    if not folder then
        return
    end

    if not self.FolderRouters[folder] then
        self.FolderRouters[folder] = {
            Folder = folder,
            Routes = {},
            Connections = {}
        }
    end

    self.FolderRouters[folder].Routes[#self.FolderRouters[folder].Routes + 1] = route
end

function ESPManager:StartFolderRouter(folder)
    local router = self.FolderRouters[folder]
    if not router or router.Connections.Added then
        return
    end

    router.Connections.Added = folder.ChildAdded:Connect(function(child)
        for _, route in pairs(router.Routes) do
            local entry = self.Entries[route.EntryKey]
            if entry and (not route.Match or route.Match(child)) and entry.Config.Enabled then
                task.delay(route.Delay or 0, function()
                    if entry.Config.Enabled and child.Parent == folder then
                        if route.SingleObject then
                            self:RegisterObject(entry, child)
                        else
                            self:UpdateEntry(entry)
                        end
                    end
                end)
            end
        end
    end)

    router.Connections.Removed = folder.ChildRemoved:Connect(function(child)
        for _, route in pairs(router.Routes) do
            local entry = self.Entries[route.EntryKey]
            if entry and (not route.Match or route.Match(child)) then
                self:UnregisterObject(entry, self:GetObjectId(entry, child))
            end
        end
    end)
end

function ESPManager:StartAllFolderRouters()
    for folder in pairs(self.FolderRouters) do
        self:StartFolderRouter(folder)
    end
end

function ESPManager:BindEntryUI(entry)
    entry.UI:Dropdown({
        Title = "loc:ESPMode",
        Desc = "loc:ESPModeDesc",
        Flag = entry.Flags.Type,
        Values = self.Constants.Modes,
        Value = self:BoolMapToArray(entry.Config.Types, self.Constants.Modes),
        Multi = true,
        AllowNone = true,
        Callback = function(selectedValues)
            self:ApplySelection(entry.Config.Types, self.Constants.Modes, selectedValues)
            self:UpdateEntry(entry)
        end
    })

    entry.UI:Dropdown({
        Title = "loc:SetupEspText",
        Desc = "loc:SetupEspTextDesc",
        Flag = entry.Flags.Text,
        Values = entry.TextValues,
        Value = self:BoolMapToArray(entry.Config.TextFormat, entry.TextValues),
        Multi = true,
        AllowNone = true,
        Callback = function(selectedValues)
            self:ApplySelection(entry.Config.TextFormat, entry.TextValues, selectedValues)
            self:UpdateEntry(entry)
        end
    })

    entry.UI:Colorpicker({
        Title = "loc:EspColor",
        Desc = "loc:EspColorDesc",
        Flag = entry.Flags.Color,
        Default = entry.Config.Color,
        Transparency = 0,
        Locked = false,
        Callback = function(color)
            entry.Config.Color = color
            self:UpdateEntry(entry)
        end
    })

    entry.UI:Toggle({
        Title = entry.Toggle.Title,
        Desc = entry.Toggle.Desc,
        Flag = entry.Flags.Toggle,
        Value = false,
        Callback = function(state)
            entry.Config.Enabled = state
            self:UpdateEntry(entry)
        end
    })
end

function ESPManager:AddEntry(key, data)
    data.Key = key
    data.ActiveIds = {}
    data.Watched = {}
    data.Config = {
        Enabled = false,
        Types = self:CreateBoolMap(self.Constants.Modes, data.DefaultTypes),
        TextFormat = self:CreateBoolMap(data.TextValues, data.DefaultText),
        Color = data.DefaultColor
    }

    if not data.GetObjects then
        data.GetObjects = function(manager, entry)
            local source = entry.UseCurrentMap and manager.State.CurrentMap or entry.SourceFolder
            return manager:GetChildrenMatching(source, function(object)
                return not entry.Matcher or entry.Matcher(manager, entry, object)
            end)
        end
    end

    self.Entries[key] = data
    self:BindEntryUI(data)
    return data
end

function ESPManager:SetCurrentMap(mapFolder)
    if self.State.CurrentMap == mapFolder then
        return
    end

    for _, key in pairs(self.MapEntryKeys) do
        self:ClearEntry(self.Entries[key])
    end

    self:DisconnectConnectionTable(self.Connections.Map)
    self.State.CurrentMap = mapFolder

    if not mapFolder then
        return
    end

    self.Connections.Map.Added = mapFolder.ChildAdded:Connect(function(child)
        for _, key in pairs(self.MapEntryKeys) do
            local entry = self.Entries[key]
            if entry and entry.Matcher(self, entry, child) and entry.Config.Enabled then
                task.delay(entry.AddDelay or 0, function()
                    if self.State.CurrentMap == mapFolder and child.Parent == mapFolder and entry.Config.Enabled then
                        self:RegisterObject(entry, child)
                    end
                end)
            end
        end
    end)

    self.Connections.Map.Removed = mapFolder.ChildRemoved:Connect(function(child)
        for _, key in pairs(self.MapEntryKeys) do
            local entry = self.Entries[key]
            if entry and entry.Matcher(self, entry, child) then
                self:UnregisterObject(entry, self:GetObjectId(entry, child))
            end
        end
    end)

    task.delay(1, function()
        if self.State.CurrentMap == mapFolder then
            for _, key in pairs(self.MapEntryKeys) do
                self:UpdateEntryByKey(key)
            end
        end
    end)
end

function ESPManager:StartPolling()
    task.spawn(function()
        while task.wait(0.5) do
            for _, entry in pairs(self.Entries) do
                if entry.PollInterval and entry.Config.Enabled then
                    entry._LastPoll = entry._LastPoll or 0
                    entry._LastPoll = entry._LastPoll + 0.5

                    if entry._LastPoll >= entry.PollInterval then
                        entry._LastPoll = 0
                        self:UpdateEntry(entry)
                    end
                end
            end
        end
    end)
end

