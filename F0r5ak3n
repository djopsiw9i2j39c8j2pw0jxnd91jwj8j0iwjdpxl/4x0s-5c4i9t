StatusLogic = {
    ParagraphUI = nil,
    LocalPlayer = localPlayer,
    CustomName = "None",
    CustomNameEnabled = false,
    Connections = {},
    OriginalNames = {},
    WatchedObjects = {},

    TargetPaths = {
        ["Username"] = {
            {Depth = 1, ParentName = "PlayerInfo"},
            {Depth = 2, ParentName = "CurrentSurvivors"}
        },
        ["PlayerName"] = {
            {Depth = 1, ParentName = "BasicInfo"}
        }
    },

    FormatName = function(self, value)
        self.CustomName = (tostring(value) == "" or tostring(value) == "nil") and "None" or tostring(value)
    end,

    GetStatValue = function(self, statName)
        return (self.LocalPlayer:FindFirstChild("leaderstats") and self.LocalPlayer.leaderstats:FindFirstChild(statName)) 
            and self.LocalPlayer.leaderstats[statName].Value 
            or "0"
    end,

    UpdateUI = function(self)
        if not self.ParagraphUI then return end
        
        if self.ParagraphUI.SetDesc then
            self.ParagraphUI:SetDesc(string.format("Money: $%s\nKiller Chance (Malice): %s%%", tostring(self:GetStatValue("Money")), tostring(self:GetStatValue("KillerChance"))))
        elseif self.ParagraphUI.SetText then
            self.ParagraphUI:SetText("loc:Update", string.format("Money: $%s\nKiller Chance (Malice): %s%%", tostring(self:GetStatValue("Money")), tostring(self:GetStatValue("KillerChance"))))
        end
    end,

    DisconnectCustomName = function(self)
        for _, connection in ipairs(self.Connections) do
            connection:Disconnect()
        end
        table.clear(self.Connections)
        table.clear(self.WatchedObjects)
    end,

    EscapeString = function(self, str)
        return string.gsub(str, "[%^%$%(%)%%%.%[%]%*%+%-%?]", "%%%1")
    end,

    ReplaceTargetName = function(self, text)
        if string.find(text, self:EscapeString(self.LocalPlayer.DisplayName)) then
            return string.gsub(text, self:EscapeString(self.LocalPlayer.DisplayName), self.CustomName), true
        elseif string.find(text, self:EscapeString(self.LocalPlayer.Name)) then
            return string.gsub(text, self:EscapeString(self.LocalPlayer.Name), self.CustomName), true
        end
        return text, false
    end,

    ApplyCustomName = function(self, object)
        if not self.CustomNameEnabled or not object or not object.Parent then return end

        local newText, isTarget = self:ReplaceTargetName(object.Text)

        if isTarget and object.Text ~= newText then
            self.OriginalNames[object] = object.Text
            object.Text = newText
        end
    end,

    WatchNameObject = function(self, object)
        if self.WatchedObjects[object] then return end
        self.WatchedObjects[object] = true

        self:ApplyCustomName(object)
        
        self.Connections[#self.Connections + 1] = object:GetPropertyChangedSignal("Text"):Connect(function()
            if self.CustomNameEnabled then
                self:ApplyCustomName(object)
            end
        end)
    end,

    RestoreNames = function(self)
        for object, originalName in pairs(self.OriginalNames) do
            if object and object.Parent then
                object.Text = originalName
            end
        end
        table.clear(self.OriginalNames)
    end,

    ProcessNameObject = function(self, object)
        if not self.CustomNameEnabled or not object or not object:IsA("TextLabel") or not self.TargetPaths[object.Name] then return end

        for _, path in ipairs(self.TargetPaths[object.Name]) do
            if path.Depth == 1 and object.Parent and object.Parent.Name == path.ParentName then
                self:WatchNameObject(object)
                break
            elseif path.Depth == 2 and object.Parent and object.Parent.Parent and object.Parent.Parent.Name == path.ParentName then
                self:WatchNameObject(object)
                break
            end
        end
    end,

    ScanExistingUI = function(self)
        if not self.CustomNameEnabled or not PlayerGui then return end
        for _, object in ipairs(PlayerGui:GetDescendants()) do
            self:ProcessNameObject(object)
        end
    end,

    UpdateState = function(self, state)
        self.CustomNameEnabled = state
        
        self:DisconnectCustomName()
        self:RestoreNames()

        if self.CustomNameEnabled then
            self:FormatName(self.CustomName)
            self:ScanExistingUI()

            self.Connections[#self.Connections + 1] = PlayerGui.DescendantAdded:Connect(function(object)
                self:ProcessNameObject(object)
            end)
        end
    end,

    StartMonitor = function(self)
        task.spawn(function()
            if not self.LocalPlayer:WaitForChild("leaderstats", 15) then return end

            for _, statName in ipairs({"Money", "KillerChance"}) do
                if self.LocalPlayer.leaderstats:WaitForChild(statName, 5) then
                    self.LocalPlayer.leaderstats[statName]:GetPropertyChangedSignal("Value"):Connect(function()
                        self:UpdateUI()
                    end)
                end
            end
            self:UpdateUI()
        end)
    end
}

