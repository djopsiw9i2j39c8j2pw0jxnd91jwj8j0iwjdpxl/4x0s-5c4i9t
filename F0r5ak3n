ModSkinSystem.SetupGroxLMS = function()
    ModSkinSystem.ThemesFolder = Workspace:FindFirstChild("Themes")
    if not ModSkinSystem.ThemesFolder then return end
    ModSkinSystem.OnLastSurvivor = function(sound)
        if not sound:IsA("Sound") or sound.Name ~= "LastSurvivor" then return end
        ModSkinSystem.SurvsF = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Survivors")
        ModSkinSystem.PlayingChance = false
        if ModSkinSystem.SurvsF then
            for _, child in ipairs(ModSkinSystem.SurvsF:GetChildren()) do
                if child.Name == "Chance" and child:GetAttribute("Username") == ModSkinSystem.Grox.TargetUser then ModSkinSystem.PlayingChance = true break end
            end
        end
        if ModSkinSystem.PlayingChance then task.defer(function() if sound.Parent and ModSkinSystem.Grox.Active then sound.SoundId = ModSkinSystem.Grox.LMS end end) end
    end

    if ModSkinSystem.Grox.LMSConn then ModSkinSystem.Grox.LMSConn:Disconnect() end
    if ModSkinSystem.ThemesFolder:FindFirstChild("LastSurvivor") then ModSkinSystem.OnLastSurvivor(ModSkinSystem.ThemesFolder.LastSurvivor) end
    ModSkinSystem.Grox.LMSConn = ModSkinSystem.ThemesFolder.ChildAdded:Connect(ModSkinSystem.OnLastSurvivor)
end

ModSkinSystem.CheckGrox = function()
    if not ModSkinSystem.Grox.Active then return end
    ModSkinSystem.SurvsFolder = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Survivors")
    if not ModSkinSystem.SurvsFolder then return end
    ModSkinSystem.TryApplyGrox = function(child)
        if child.Name == "Chance" then
            task.wait(0.8)
            if ModSkinSystem.Grox.Active and child:GetAttribute("Username") == ModSkinSystem.Grox.TargetUser then ModSkinSystem.ApplyGroxConfig() ModSkinSystem.DoGroxMorph(child) end
        end
    end
    for _, child in ipairs(ModSkinSystem.SurvsFolder:GetChildren()) do ModSkinSystem.TryApplyGrox(child) end
    if ModSkinSystem.Grox.Conn then ModSkinSystem.Grox.Conn:Disconnect() end
    ModSkinSystem.Grox.Conn = ModSkinSystem.SurvsFolder.ChildAdded:Connect(ModSkinSystem.TryApplyGrox)
end

