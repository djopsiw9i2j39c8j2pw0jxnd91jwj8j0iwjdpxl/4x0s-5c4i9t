        Enabled = false, ZoomDistance = 10, HeightOffset = 1.5,
        AimPart = "Head", QuickGuiVisible = false, SwitchGuiVisible = false, UIScale = 1, Smoothness = 1
    },
    State = {
        Target = nil, OriginalCameraSubject = nil, CustomCFrame = nil,
        PinchTouches = {}, LastPinchDistance = nil
    },
    UI = { Frame = nil, Button = nil, Stroke = nil, SwitchFrame = nil, SwitchButton = nil, SwitchStroke = nil },
    Connections = {},
