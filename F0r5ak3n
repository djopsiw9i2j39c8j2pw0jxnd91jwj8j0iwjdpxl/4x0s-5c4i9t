App.ShowHitbox = function(killer, key)
	App.State.VisualRoot = App.GetRoot(killer)
	if not App.State.VisualRoot then return end
	App.State.VisualCfg = App.GetSizeConfig(killer.Name, key)
	
	App.State.HitboxId = HttpService:GenerateGUID(false)
	
	App.State.ActiveHitboxes[App.State.HitboxId] = App.MakePart({
		Name = "FakeHitbox_" .. key, Size = App.State.VisualCfg.Size,
		Anchored = false, Massless = true, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false,
		Material = Enum.Material.Neon, Color = App.Config.Hitbox.Color, Transparency = App.Config.Hitbox.Transparency,
		Parent = Workspace
	})

	App.State.VisualWeld = Instance.new("Weld")
	App.State.VisualWeld.Part0 = App.State.VisualRoot
	App.State.VisualWeld.Part1 = App.State.ActiveHitboxes[App.State.HitboxId]
	App.State.VisualWeld.C0 = App.State.VisualCfg.Offset
	App.State.VisualWeld.Parent = App.State.ActiveHitboxes[App.State.HitboxId]

	Debris:AddItem(App.State.ActiveHitboxes[App.State.HitboxId], App.Config.Hitbox.Duration + 1)
	App.State.ActiveTweens[App.State.HitboxId] = TweenService:Create(App.State.ActiveHitboxes[App.State.HitboxId], TweenInfo.new(0.15), { Transparency = 1 })
	
	task.delay(App.Config.Hitbox.Duration, function(hId)
		if App.State.ActiveHitboxes[hId] and App.State.ActiveHitboxes[hId].Parent then 
			App.State.ActiveTweens[hId]:Play()
			App.State.ActiveTweens[hId].Completed:Once(function() 
				if App.State.ActiveHitboxes[hId] then
					App.State.ActiveHitboxes[hId]:Destroy() 
					App.State.ActiveHitboxes[hId] = nil
					App.State.ActiveTweens[hId] = nil
				end
			end) 
		end
	end, App.State.HitboxId)
end

App.OnKillerTrigger = function(killer, matched)
	if not (App.State.Flags.ShowHitbox or App.State.Flags.AutoBlock) then return end
	if App.State.LastTrigger[killer] and os.clock() - App.State.LastTrigger[killer] < 0.1 then return end
	App.State.LastTrigger[killer] = os.clock()

	if App.State.Flags.ShowHitbox then App.ShowHitbox(killer, matched) end
	
	if App.State.Flags.AutoBlock then
		App.State.TrigPRoot, App.State.TrigKRoot = App.GetRoot(playerCharacter), App.GetRoot(killer)
		if not (App.State.TrigPRoot and App.State.TrigKRoot) then return end
		
		App.State.CurrDist = (App.State.TrigPRoot.Position - App.State.TrigKRoot.Position).Magnitude
		App.State.IsHit = (App.State.CurrDist <= App.Config.AntiBait.CloseDist) or App.PlayerInVirtualHitbox(killer, matched)
		
		if App.State.IsHit and App.AntiBait.Run(killer) then 
			App.TryBlock() 
		end
	end
end

App.OnLocalTrigger = function(char, matched, actionObj)
	if not App.State.Flags.AutoCounter then return end
	if os.clock() - App.State.LocalLastTrigger < 0.1 then return end
	App.State.LocalLastTrigger = os.clock()
	App.TriggerCounter(actionObj)
end

App.CheckTriggerEvent = function(char, id, cache, actionObj, isLocal)
	if not (id and cache[id]) then return end
	if isLocal then App.OnLocalTrigger(char, cache[id], actionObj)
	else App.OnKillerTrigger(char, cache[id]) end
end

App.HookSound = function(char, sound, state, isLocal)
	if not sound:IsA("Sound") then return end

	table.insert(state.Conns, sound.Played:Connect(function()
		App.State.HookCache = isLocal and App.State.LocalSkillCache or App.State.SkillCache[char]
		if not App.State.HookCache then return end
		App.CheckTriggerEvent(char, App.NormalizeId(sound.SoundId), App.State.HookCache, sound, isLocal)
	end))

	if sound.IsPlaying then 
		App.State.HookCache = isLocal and App.State.LocalSkillCache or App.State.SkillCache[char]
		if App.State.HookCache then
			App.CheckTriggerEvent(char, App.NormalizeId(sound.SoundId), App.State.HookCache, sound, isLocal)
		end
	end
end

App.InitCharState = function(char, isLocal)
	App.State.NewCharState = { Conns = {} }
	App.State.CharResolveFunc = isLocal and App.ResolveLocal or function() 
		App.State.SkillCache[char] = nil; App.ResolveKiller(char) 
	end

	if isLocal then App.ResolveLocal() else App.ResolveKiller(char) end

	table.insert(App.State.NewCharState.Conns, char:GetAttributeChangedSignal("SkinName"):Connect(App.State.CharResolveFunc))
	
	App.State.Hum = char:WaitForChild("Humanoid", 5)
	App.State.Animator = App.State.Hum and App.State.Hum:WaitForChild("Animator", 5)
	if App.State.Animator then
		table.insert(App.State.NewCharState.Conns, App.State.Animator.AnimationPlayed:Connect(function(track)
			App.State.AnimCache = isLocal and App.State.LocalSkillCache or App.State.SkillCache[char]
			if not App.State.AnimCache then return end
			App.CheckTriggerEvent(char, App.NormalizeId(track.Animation and track.Animation.AnimationId), App.State.AnimCache, track, isLocal)
		end))
	end

	for _, d in ipairs(char:GetDescendants()) do App.HookSound(char, d, App.State.NewCharState, isLocal) end
	table.insert(App.State.NewCharState.Conns, char.DescendantAdded:Connect(function(d) App.HookSound(char, d, App.State.NewCharState, isLocal) end))
	
	return App.State.NewCharState
end

App.WatchKiller = function(killer)
	if not killer:IsA("Model") or App.State.KillerStates[killer] then return end
	App.State.KillerStates[killer] = App.InitCharState(killer, false)
	
	table.insert(App.State.KillerStates[killer].Conns, killer.AncestryChanged:Connect(function(_, parent)
		if not parent then
			App.ClearConnections(App.State.KillerStates[killer].Conns)
			App.State.KillerStates[killer], App.State.SkillCache[killer], App.State.LastTrigger[killer], App.State.BaitTimestamps[killer], App.State.RetreatData[killer], App.State.AngleData[killer] = nil, nil, nil, nil, nil, nil
		end
	end))
end

App.SetupLocalPlayer = function(char)
	if not char then return end
	if App.State.LocalState.Conns then App.ClearConnections(App.State.LocalState.Conns) end
	App.State.LocalState = App.InitCharState(char, true)
end

