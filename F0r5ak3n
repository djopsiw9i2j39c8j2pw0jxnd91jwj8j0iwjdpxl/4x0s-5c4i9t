function BypassSystem:RestoreLightingEffects()
    for _, object in ipairs(self.Core.Lighting:GetChildren()) do
        local original = object:GetAttribute("originalVal")
        if original ~= nil then
            if object:IsA("PostEffect") then
                object.Enabled = original
            end
            object:SetAttribute("originalVal", nil)
        end
    end
end

function BypassSystem:IsBlacklisted(name)
    for _, blacklist in ipairs(self.BlacklistNames) do
        if name:find(blacklist) then
            return true
        end
    end
    return false
end

function BypassSystem:HandleSubspace(object)
    if object.Name == "SubspaceVFXBlur" or object.Name == "SubspaceVFXColorCorrection" then
        object.Enabled = false
        object:Destroy()
        self:RestoreLightingEffects()
    elseif object:IsA("Highlight") then
        object.Enabled = false
        object.FillTransparency = 1
        object.OutlineTransparency = 1
    end
end

function BypassSystem:HandleBlindness(object)
    if object.Name == "BlindnessBlur" then
        object.Enabled = false
        object:Destroy()
    end
end

function BypassSystem:HandleBloodhunt(object)
    if object:IsA("ColorCorrectionEffect") then
        object.Enabled = false
        object:Destroy()
    elseif object:IsA("Atmosphere") and object:GetAttribute("Artificial") then
        object:Destroy()
    end
end

function BypassSystem:HandleInfernalCry(object)
    if self:IsBlacklisted(object.Name) then
        if object:IsA("PostEffect") then
            object.Enabled = false
        end
        object:Destroy()
    end
end

function BypassSystem:ScanAllActive()
    if self.Config.AntiSubspace then
        if self.State.Character and self.State.Character:GetAttribute("MuteChaseThemes") then
            self.State.Character:SetAttribute("MuteChaseThemes", false)
        end
        for _, object in ipairs(Workspace:GetDescendants()) do
            if object:IsA("Highlight") then self:HandleSubspace(object) end
        end
    end

    if self.Config.AntiBlindness then
        local blur = self.Core.Lighting:FindFirstChild("BlindnessBlur")
        if blur then self:HandleBlindness(blur) end
        if self.Core.Lighting.ExposureCompensation < -2 or self.Core.Lighting.ExposureCompensation > 2 then
            self.Core.Lighting.ExposureCompensation = 0
        end
    end

    if self.Config.AntiBloodhunt then
        self.Core.Player:SetAttribute("HuntVFXActive", true)
        if self.Core.PlayerGui then
            local tempUI = self.Core.PlayerGui:FindFirstChild("TemporaryUI")
            if tempUI then
                for _, object in ipairs(tempUI:GetChildren()) do
                    if self:IsBlacklisted(object.Name) then object:Destroy() end
                end
            end
        end
        if self.State.Character then
            for _, object in ipairs(self.State.Character:GetDescendants()) do
                if object.Name:find("Spotlight") or object.Name:find("BloodHunt") then
                    object:Destroy()
                end
            end
        end
    end

    for _, object in ipairs(self.Core.Lighting:GetChildren()) do
        if self.Config.AntiSubspace then self:HandleSubspace(object) end
        if self.Config.AntiBloodhunt then self:HandleBloodhunt(object) end
        if self.Config.AntiInfernalCry then self:HandleInfernalCry(object) end
    end
    
    if self.Config.AntiInfernalCry then
        pcall(function() RunService:UnbindFromRenderStep("InfernalCryTransparency") end)
    end
end

function BypassSystem:InitConnections()
    self.Core.Lighting.ChildAdded:Connect(function(object)
        if self.Config.AntiSubspace then self:HandleSubspace(object) end
        if self.Config.AntiBlindness then self:HandleBlindness(object) end
        if self.Config.AntiBloodhunt then self:HandleBloodhunt(object) end
        if self.Config.AntiInfernalCry then self:HandleInfernalCry(object) end
    end)
    
    self.Core.Lighting:GetPropertyChangedSignal("ExposureCompensation"):Connect(function()
        if self.Config.AntiBlindness and (self.Core.Lighting.ExposureCompensation < -2 or self.Core.Lighting.ExposureCompensation > 2) then
            self.Core.Lighting.ExposureCompensation = 0
        end
    end)

    self.Core.PlayerGui.DescendantAdded:Connect(function(object)
        if self.Config.AntiBloodhunt and object.Parent and object.Parent.Name == "TemporaryUI" then
            if self:IsBlacklisted(object.Name) then object:Destroy() end
        end
    end)
    
    self.Core.Player.ChildAdded:Connect(function(object)
        if self.Config.AntiInfernalCry then self:HandleInfernalCry(object) end
    end)

    Workspace.DescendantAdded:Connect(function(object)
        if self.Config.AntiSubspace and object:IsA("Highlight") then
            self:HandleSubspace(object)
        end
    end)
    
    Workspace:GetAttributeChangedSignal("BloodHuntActive"):Connect(function()
        if self.Config.AntiBloodhunt then
            self.Core.Player:SetAttribute("HuntVFXActive", true)
            task.defer(function() self:ScanAllActive() end)
        end
    end)

    RunService.RenderStepped:Connect(function()
        if self.Config.AntiInfernalCry then
            pcall(function() RunService:UnbindFromRenderStep("InfernalCryTransparency") end)
        end
    end)
end

