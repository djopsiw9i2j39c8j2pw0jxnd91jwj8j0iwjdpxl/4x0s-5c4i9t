local function MakeDraggableAndClickable(frame, button, onClick)
    local dragInput, dragging, startPos, dragStart, dragDist = nil, false, nil, nil, 0
    
    button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging, dragInput, dragStart, startPos, dragDist = true, input, input.Position, frame.Position, 0
            CamlockBot:Tween(frame, {Size = UDim2.new(0, (130 - 10) * CamlockBot.Config.UIScale, 0, (45 - 5) * CamlockBot.Config.UIScale)}, 0.1)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            dragDist = delta.Magnitude
            if dragDist > 5 then frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y) end
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input == dragInput then
            dragging, dragInput = false, nil
            CamlockBot:Tween(frame, {Size = UDim2.new(0, 130 * CamlockBot.Config.UIScale, 0, 45 * CamlockBot.Config.UIScale)}, 0.15)
            if dragDist < 10 and onClick then onClick() end
        end
    end)
end

function CamlockBot:CreateUIBtn(sgui, yPos, text)
    local frame = Instance.new("Frame", sgui)
    frame.Size, frame.Position = UDim2.new(0, 130 * self.Config.UIScale, 0, 45 * self.Config.UIScale), UDim2.new(0.85, 0, yPos, 0)
    frame.BackgroundColor3, frame.BorderSizePixel, frame.Active = Color3.fromRGB(20, 20, 20), 0, true
    frame.AnchorPoint = Vector2.new(0.5, 0.5)
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 12)

    local stroke = Instance.new("UIStroke", frame)
    stroke.Thickness, stroke.Color = 2, Color3.fromRGB(60, 60, 60)

    local btn = Instance.new("TextButton", frame)
    btn.Size, btn.BackgroundTransparency = UDim2.new(1, 0, 1, 0), 1
    btn.Font, btn.TextSize = Enum.Font.GothamBold, 14 * self.Config.UIScale
    if text then btn.Text, btn.TextColor3 = text, Color3.fromRGB(200, 200, 200) end

    return frame, btn, stroke
end

