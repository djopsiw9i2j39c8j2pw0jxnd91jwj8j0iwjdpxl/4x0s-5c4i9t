MainAimLogicSS1.NormalizeId = function(id) 
	return tostring(id):match("%d+") 
end

MainAimLogicSS1.UpdateDict = function(dict, list)
	table.clear(dict)
	for _, v in ipairs(list) do dict[v] = true end
end

MainAimLogicSS1.WalkTable = function(tbl, depth, charData, charName)
	if depth > 4 then return end
	for k, v in pairs(tbl) do
		MainAimLogicSS1.State.TempMatched = nil
		for _, key in ipairs(charData.SkillKeys) do
			if type(k) == "string" and k:lower() == key:lower() then
				MainAimLogicSS1.State.TempMatched = key:lower()
				break
			end
		end
		if MainAimLogicSS1.State.TempMatched then
			if type(v) == "string" or type(v) == "number" then
				MainAimLogicSS1.State.SkillCache[MainAimLogicSS1.NormalizeId(v)] = {
					CharName = charName,
					Offset = charData.RightOffset
				}
			elseif type(v) == "table" then
				MainAimLogicSS1.WalkTable(v, depth + 1, charData, charName)
			end
		end
		if type(v) == "table" then 
			MainAimLogicSS1.WalkTable(v, depth + 1, charData, charName) 
		end
	end
end

MainAimLogicSS1.ScanDirectory = function(folder, charData, charName, depth)
	if not folder or (depth and depth > 3) then return end
	MainAimLogicSS1.State.CurrentDepth = depth or 1
	
	for _, child in ipairs(folder:GetChildren()) do
		if child:IsA("ModuleScript") then
			MainAimLogicSS1.State.Ok, MainAimLogicSS1.State.Data = pcall(require, child)
			if MainAimLogicSS1.State.Ok and type(MainAimLogicSS1.State.Data) == "table" then
				MainAimLogicSS1.WalkTable(MainAimLogicSS1.State.Data, 0, charData, charName)
			end
		elseif child:IsA("Folder") or child:IsA("Model") then
			MainAimLogicSS1.ScanDirectory(child, charData, charName, MainAimLogicSS1.State.CurrentDepth + 1)
		end
	end
end

MainAimLogicSS1.LoadConfigs = function()
	MainAimLogicSS1.State.AssetsFolder = ReplicatedStorage:FindFirstChild("Assets")
	if not MainAimLogicSS1.State.AssetsFolder then return end

	MainAimLogicSS1.State.SkinsFolder = MainAimLogicSS1.State.AssetsFolder:FindFirstChild("Skins")

	for charName, charData in pairs(MainAimLogicSS1.Config.Characters) do
		MainAimLogicSS1.State.RoleName = charData.BasePath[#charData.BasePath]
		
		MainAimLogicSS1.State.RoleFolder = MainAimLogicSS1.State.AssetsFolder:FindFirstChild(MainAimLogicSS1.State.RoleName)
		if MainAimLogicSS1.State.RoleFolder then
			MainAimLogicSS1.State.CharFolder = MainAimLogicSS1.State.RoleFolder:FindFirstChild(charData.FolderName) or MainAimLogicSS1.State.RoleFolder:FindFirstChild(charData.FolderName:lower())
			if MainAimLogicSS1.State.CharFolder then
				MainAimLogicSS1.ScanDirectory(MainAimLogicSS1.State.CharFolder, charData, charName, 1)
			end
		end
		
		if MainAimLogicSS1.State.SkinsFolder then
			MainAimLogicSS1.State.SkinRoleFolder = MainAimLogicSS1.State.SkinsFolder:FindFirstChild(MainAimLogicSS1.State.RoleName)
			if MainAimLogicSS1.State.SkinRoleFolder then
				MainAimLogicSS1.State.SkinCharFolder = MainAimLogicSS1.State.SkinRoleFolder:FindFirstChild(charData.FolderName) or MainAimLogicSS1.State.SkinRoleFolder:FindFirstChild(charData.FolderName:lower())
				if MainAimLogicSS1.State.SkinCharFolder then
					MainAimLogicSS1.ScanDirectory(MainAimLogicSS1.State.SkinCharFolder, charData, charName, 1)
				end
			end
		end
	end
end

MainAimLogicSS1.GetBestTarget = function(charName)
	if not charName then return nil end
	table.clear(MainAimLogicSS1.State.BestTargetsList)
	MainAimLogicSS1.State.BestValue = math.huge
	MainAimLogicSS1.State.MyRoot = playerCharacter and playerCharacter:FindFirstChild("HumanoidRootPart")
	MainAimLogicSS1.State.CurrentRadius = MainAimLogicSS1.Config.Characters[charName].AimRadius
	MainAimLogicSS1.State.CurrentMaxY = MainAimLogicSS1.Config.Characters[charName].MaxYDiff or 3
	MainAimLogicSS1.State.CurrentSortBy = MainAimLogicSS1.Config.Characters[charName].SortBy
	
	if not MainAimLogicSS1.State.MyRoot then return nil end
	
	for mode, active in pairs(MainAimLogicSS1.State.TargetModes[charName]) do
		if active and MainAimLogicSS1.Config.TargetFolder[mode] then
			for _, model in ipairs(MainAimLogicSS1.Config.TargetFolder[mode]:GetChildren()) do
				if model ~= playerCharacter then
					MainAimLogicSS1.State.ScanHum = model:FindFirstChildOfClass("Humanoid")
					MainAimLogicSS1.State.ScanRoot = model:FindFirstChild("HumanoidRootPart")
					
					if MainAimLogicSS1.State.ScanHum and MainAimLogicSS1.State.ScanRoot and MainAimLogicSS1.State.ScanHum.Health > 0 and MainAimLogicSS1.State.ScanHum.MaxHealth > 0 then
						MainAimLogicSS1.State.Dist = (MainAimLogicSS1.State.ScanRoot.Position - MainAimLogicSS1.State.MyRoot.Position).Magnitude
						MainAimLogicSS1.State.YDiff = math.abs(MainAimLogicSS1.State.ScanRoot.Position.Y - MainAimLogicSS1.State.MyRoot.Position.Y)
						
						if MainAimLogicSS1.State.Dist <= MainAimLogicSS1.State.CurrentRadius and MainAimLogicSS1.State.YDiff <= MainAimLogicSS1.State.CurrentMaxY then
							if MainAimLogicSS1.State.CurrentSortBy == "HP" then
								MainAimLogicSS1.State.Metric = MainAimLogicSS1.State.ScanHum.Health / MainAimLogicSS1.State.ScanHum.MaxHealth
							else
								MainAimLogicSS1.State.Metric = MainAimLogicSS1.State.Dist
							end
							
							if MainAimLogicSS1.State.Metric < MainAimLogicSS1.State.BestValue then
								MainAimLogicSS1.State.BestValue = MainAimLogicSS1.State.Metric
								table.clear(MainAimLogicSS1.State.BestTargetsList)
								table.insert(MainAimLogicSS1.State.BestTargetsList, MainAimLogicSS1.State.ScanRoot)
							elseif MainAimLogicSS1.State.Metric == MainAimLogicSS1.State.BestValue then
								table.insert(MainAimLogicSS1.State.BestTargetsList, MainAimLogicSS1.State.ScanRoot)
							end
						end
					end
				end
			end
		end
	end
	
	if #MainAimLogicSS1.State.BestTargetsList > 0 then
		return MainAimLogicSS1.State.BestTargetsList[math.random(1, #MainAimLogicSS1.State.BestTargetsList)]
	end
	return nil
end

MainAimLogicSS1.StopAim = function()
	MainAimLogicSS1.State.IsAiming = false
	if MainAimLogicSS1.State.AimConn then 
		MainAimLogicSS1.State.AimConn:Disconnect()
		MainAimLogicSS1.State.AimConn = nil 
	end
	
	MainAimLogicSS1.State.MyHum = playerCharacter and playerCharacter:FindFirstChildOfClass("Humanoid")
	if MainAimLogicSS1.State.MyHum then 
		MainAimLogicSS1.State.MyHum.AutoRotate = true 
	end
	
	MainAimLogicSS1.State.AimTrack = nil
	MainAimLogicSS1.State.AimTargetRoot = nil
end

MainAimLogicSS1.AimLoop = function()
	if not MainAimLogicSS1.State.IsAiming or not playerCharacter then return MainAimLogicSS1.StopAim() end
	
	if MainAimLogicSS1.State.AimTrack then
		MainAimLogicSS1.State.TrackEnded = not MainAimLogicSS1.State.AimTrack.IsPlaying or MainAimLogicSS1.State.AimTrack.WeightTarget <= 0.01 or (MainAimLogicSS1.State.AimTrack.Length > 0 and MainAimLogicSS1.State.AimTrack.TimePosition >= MainAimLogicSS1.State.AimTrack.Length - 0.05)
		if MainAimLogicSS1.State.TrackEnded then return MainAimLogicSS1.StopAim() end
	else
		return MainAimLogicSS1.StopAim()
	end

	MainAimLogicSS1.State.MyRoot = playerCharacter:FindFirstChild("HumanoidRootPart")
	if not MainAimLogicSS1.State.MyRoot then return MainAimLogicSS1.StopAim() end

	MainAimLogicSS1.State.TargetValid = false
	if MainAimLogicSS1.State.AimTargetRoot and MainAimLogicSS1.State.AimTargetRoot.Parent then
		MainAimLogicSS1.State.TargetHum = MainAimLogicSS1.State.AimTargetRoot.Parent:FindFirstChildOfClass("Humanoid")
		if MainAimLogicSS1.State.TargetHum and MainAimLogicSS1.State.TargetHum.Health > 0 then
			MainAimLogicSS1.State.CurrentMaxY = MainAimLogicSS1.Config.Characters[MainAimLogicSS1.State.ActiveCharName] and MainAimLogicSS1.Config.Characters[MainAimLogicSS1.State.ActiveCharName].MaxYDiff or 3
			MainAimLogicSS1.State.YDiff = math.abs(MainAimLogicSS1.State.AimTargetRoot.Position.Y - MainAimLogicSS1.State.MyRoot.Position.Y)
			if MainAimLogicSS1.State.YDiff <= MainAimLogicSS1.State.CurrentMaxY then
				MainAimLogicSS1.State.TargetValid = true
			end
		end
	end

	if not MainAimLogicSS1.State.TargetValid then
		MainAimLogicSS1.State.AimTargetRoot = MainAimLogicSS1.GetBestTarget(MainAimLogicSS1.State.ActiveCharName)
		if not MainAimLogicSS1.State.AimTargetRoot then
			return MainAimLogicSS1.StopAim() 
		end
	end

	MainAimLogicSS1.State.MyPos = MainAimLogicSS1.State.MyRoot.Position
	MainAimLogicSS1.State.TargetPos = MainAimLogicSS1.State.AimTargetRoot.Position

	MainAimLogicSS1.State.Dir = Vector3.new(MainAimLogicSS1.State.TargetPos.X - MainAimLogicSS1.State.MyPos.X, 0, MainAimLogicSS1.State.TargetPos.Z - MainAimLogicSS1.State.MyPos.Z)
	
	if MainAimLogicSS1.State.Dir.Magnitude > 0.05 then
		MainAimLogicSS1.State.DirFlat = MainAimLogicSS1.State.Dir.Unit
		
		if MainAimLogicSS1.State.CurrentOffset ~= 0 then
			MainAimLogicSS1.State.RightVec = MainAimLogicSS1.State.DirFlat:Cross(Vector3.new(0, 1, 0))
			MainAimLogicSS1.State.AimPoint = MainAimLogicSS1.State.TargetPos + (MainAimLogicSS1.State.RightVec * MainAimLogicSS1.State.CurrentOffset)
		else
			MainAimLogicSS1.State.AimPoint = MainAimLogicSS1.State.TargetPos
		end

		MainAimLogicSS1.State.MyRoot.CFrame = CFrame.lookAt(MainAimLogicSS1.State.MyPos, Vector3.new(MainAimLogicSS1.State.AimPoint.X, MainAimLogicSS1.State.MyPos.Y, MainAimLogicSS1.State.AimPoint.Z))
	end
end

MainAimLogicSS1.OnAnimPlayed = function(track)
	if not track.Animation or not track.Animation.AnimationId then return end
	if MainAimLogicSS1.State.IsAiming then return end

	MainAimLogicSS1.State.AnimId = MainAimLogicSS1.NormalizeId(track.Animation.AnimationId)
	MainAimLogicSS1.State.SkillInfo = MainAimLogicSS1.State.SkillCache[MainAimLogicSS1.State.AnimId]
	
	if MainAimLogicSS1.State.SkillInfo then
		if not MainAimLogicSS1.State.Flags[MainAimLogicSS1.State.SkillInfo.CharName] then return end

		MainAimLogicSS1.State.AimTargetRoot = MainAimLogicSS1.GetBestTarget(MainAimLogicSS1.State.SkillInfo.CharName)
		
		if MainAimLogicSS1.State.AimTargetRoot then
			MainAimLogicSS1.State.IsAiming = true
			MainAimLogicSS1.State.AimTrack = track
			MainAimLogicSS1.State.CurrentOffset = MainAimLogicSS1.State.SkillInfo.Offset
			MainAimLogicSS1.State.ActiveCharName = MainAimLogicSS1.State.SkillInfo.CharName 
			
			MainAimLogicSS1.State.MyHum = playerCharacter and playerCharacter:FindFirstChildOfClass("Humanoid")
			if MainAimLogicSS1.State.MyHum then 
				MainAimLogicSS1.State.MyHum.AutoRotate = false 
			end

			if MainAimLogicSS1.State.AimConn then MainAimLogicSS1.State.AimConn:Disconnect() end
			MainAimLogicSS1.State.AimConn = RunService.RenderStepped:Connect(MainAimLogicSS1.AimLoop)

			track.Stopped:Once(MainAimLogicSS1.StopAim)
		end
	end
end

MainAimLogicSS1.HookPlayer = function(char)
	if not char then return end
	MainAimLogicSS1.StopAim() 
	
	for _, conn in ipairs(MainAimLogicSS1.State.PlayerConns) do conn:Disconnect() end
	table.clear(MainAimLogicSS1.State.PlayerConns)
	
	MainAimLogicSS1.State.Hum = char:WaitForChild("Humanoid", 5)
	MainAimLogicSS1.State.Animator = MainAimLogicSS1.State.Hum and MainAimLogicSS1.State.Hum:WaitForChild("Animator", 5)
	
	if MainAimLogicSS1.State.Animator then
		table.insert(MainAimLogicSS1.State.PlayerConns, MainAimLogicSS1.State.Animator.AnimationPlayed:Connect(MainAimLogicSS1.OnAnimPlayed))
	end
end

