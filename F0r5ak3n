    if SkillController.CurrentHumanoid and SkillController.ActiveMode == "Charge" then
        SkillController.CurrentHumanoid.AutoRotate = true
        SkillController.CurrentHumanoid:Move(Vector3.new(0, 0, 0))
    end
    
