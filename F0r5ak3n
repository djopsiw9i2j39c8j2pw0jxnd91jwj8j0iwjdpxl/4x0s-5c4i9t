function CamlockBot:Tween(obj, props, duration)
    if obj then TweenService:Create(obj, TweenInfo.new(duration or 0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), props):Play() end
end

function CamlockBot:GetAimPos(model)
    if not model then return nil end
    local p = model:FindFirstChild(self.Config.AimPart) or model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart")
    return p and p.Position
end

function CamlockBot:IsKiller()
    return playerCharacter and playerCharacter:IsDescendantOf(killersFolder)
end

function CamlockBot:GetAllTargets()
    if not survivorsFolder or not playerCharacter then return {} end
    local myRoot = playerCharacter:FindFirstChild("HumanoidRootPart")
    if not myRoot then return {} end

    local targets = {}
    for _, s in ipairs(survivorsFolder:GetChildren()) do
        local h, r = s:FindFirstChild("Humanoid"), s:FindFirstChild("HumanoidRootPart")
        if h and r and h.Health > 0 then
            table.insert(targets, {r = r, d = (r.Position - myRoot.Position).Magnitude})
        end
    end
    table.sort(targets, function(a, b) return a.d < b.d end)
    return targets
end

function CamlockBot:GetNearest()
    local t = self:GetAllTargets()
    return t[1] and t[1].r or nil
end

function CamlockBot:GetNextTarget()
    local targets = self:GetAllTargets()
    if #targets == 0 then return nil end
    if #targets == 1 then return targets[1].r end

    for i, t in ipairs(targets) do
        if t.r == self.State.Target then
            return targets[(i % #targets) + 1].r
        end
    end
    return targets[1].r
end

function CamlockBot:UpdateQuickUI()
    if not self.UI.Button then return end
    local state = self.Config.Enabled
    self.UI.Button.Text = state and "CAMLOCK: ON" or "CAMLOCK: OFF"
    self:Tween(self.UI.Button, {TextColor3 = state and Color3.fromRGB(255, 75, 75) or Color3.fromRGB(200, 200, 200)}, 0.3)
    self:Tween(self.UI.Stroke, {Color = state and Color3.fromRGB(255, 75, 75) or Color3.fromRGB(60, 60, 60)}, 0.3)
end

function CamlockBot:UpdateUISize()
    local s = self.Config.UIScale
    local size = UDim2.new(0, 130 * s, 0, 45 * s)
    if self.UI.Frame then
        self:Tween(self.UI.Frame, {Size = size}, 0.2)
        if self.UI.Button then self.UI.Button.TextSize = 14 * s end
    end
    if self.UI.SwitchFrame then
        self:Tween(self.UI.SwitchFrame, {Size = size}, 0.2)
        if self.UI.SwitchButton then self.UI.SwitchButton.TextSize = 14 * s end
    end
end

local function MakeDraggableAndClickable(frame, button, onClick)
    local dragInput, dragging, startPos, dragStart, dragDist = nil, false, nil, nil, 0
    
    button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging, dragInput, dragStart, startPos, dragDist = true, input, input.Position, frame.Position, 0
            CamlockBot:Tween(frame, {Size = UDim2.new(0, (130 - 10) * CamlockBot.Config.UIScale, 0, (45 - 5) * CamlockBot.Config.UIScale)}, 0.1)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            dragDist = delta.Magnitude
            if dragDist > 5 then frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y) end
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input == dragInput then
            dragging, dragInput = false, nil
            CamlockBot:Tween(frame, {Size = UDim2.new(0, 130 * CamlockBot.Config.UIScale, 0, 45 * CamlockBot.Config.UIScale)}, 0.15)
            if dragDist < 10 and onClick then onClick() end
        end
    end)
end

function CamlockBot:CreateUIBtn(sgui, yPos, text)
    local frame = Instance.new("Frame", sgui)
    frame.Size, frame.Position = UDim2.new(0, 130 * self.Config.UIScale, 0, 45 * self.Config.UIScale), UDim2.new(0.85, 0, yPos, 0)
    frame.BackgroundColor3, frame.BorderSizePixel, frame.Active = Color3.fromRGB(20, 20, 20), 0, true
    frame.AnchorPoint = Vector2.new(0.5, 0.5)
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 12)

    local stroke = Instance.new("UIStroke", frame)
    stroke.Thickness, stroke.Color = 2, Color3.fromRGB(60, 60, 60)

    local btn = Instance.new("TextButton", frame)
    btn.Size, btn.BackgroundTransparency = UDim2.new(1, 0, 1, 0), 1
    btn.Font, btn.TextSize = Enum.Font.GothamBold, 14 * self.Config.UIScale
    if text then btn.Text, btn.TextColor3 = text, Color3.fromRGB(200, 200, 200) end

    return frame, btn, stroke
end

function CamlockBot:SetupQuickGui()
    if CoreGui:FindFirstChild("QuickCamlock") then CoreGui.QuickCamlock:Destroy() end
    local sgui = Instance.new("ScreenGui", CoreGui)
    sgui.Name, sgui.ResetOnSpawn = "QuickCamlock", false

    self.UI.Frame, self.UI.Button, self.UI.Stroke = self:CreateUIBtn(sgui, 0.45, nil)
    self.UI.Frame.Visible = self.Config.QuickGuiVisible

    self.UI.SwitchFrame, self.UI.SwitchButton, self.UI.SwitchStroke = self:CreateUIBtn(sgui, 0.55, "Switch Target")
    self.UI.SwitchFrame.Visible = self.Config.SwitchGuiVisible

    MakeDraggableAndClickable(self.UI.Frame, self.UI.Button, function() self:Toggle(not self.Config.Enabled) end)
    MakeDraggableAndClickable(self.UI.SwitchFrame, self.UI.SwitchButton, function() 
        if self.Config.Enabled then 
            self.State.Target = self:GetNextTarget()
            self:Tween(self.UI.SwitchButton, {TextColor3 = Color3.fromRGB(255, 255, 255)}, 0.1)
            self:Tween(self.UI.SwitchStroke, {Color = Color3.fromRGB(255, 170, 0)}, 0.1)
            task.delay(0.2, function()
                if self.UI.SwitchButton then self:Tween(self.UI.SwitchButton, {TextColor3 = Color3.fromRGB(200, 200, 200)}, 0.2) end
                if self.UI.SwitchStroke then self:Tween(self.UI.SwitchStroke, {Color = Color3.fromRGB(60, 60, 60)}, 0.2) end
            end)
        end 
    end)

    self:UpdateQuickUI()
end

function CamlockBot:Toggle(state)
    self.Config.Enabled = state
    self:UpdateQuickUI()

    if not state then
        RunService:UnbindFromRenderStep(self.RenderKey)
        for _, c in ipairs(self.Connections) do if c.Connected then c:Disconnect() end end
        table.clear(self.Connections)
        self.State.PinchTouches, self.State.LastPinchDistance = {}, nil
        
        if Camera and self.State.OriginalCameraSubject then
            Camera.CameraType, Camera.CameraSubject = Enum.CameraType.Custom, self.State.OriginalCameraSubject
            self.State.OriginalCameraSubject, self.State.Target, self.State.CustomCFrame = nil, nil, nil
        end
        return
    end

    if not Camera or self.State.OriginalCameraSubject then return end
    self.State.OriginalCameraSubject = Camera.CameraSubject
    self.State.CustomCFrame = Camera.CFrame 

    RunService:BindToRenderStep(self.RenderKey, 250, function()
        if not self:IsKiller() then
            if Camera.CameraType == Enum.CameraType.Scriptable then Camera.CameraType = Enum.CameraType.Custom end
            return
        end

        if not (self.State.Target and self.State.Target.Parent and self.State.Target.Parent:FindFirstChild("Humanoid") and self.State.Target.Parent.Humanoid.Health > 0) then
            self.State.Target = self:GetNearest()
            if not self.State.Target and Camera.CameraType == Enum.CameraType.Scriptable then Camera.CameraType = Enum.CameraType.Custom end
            return
        end

        local myRoot = playerCharacter and playerCharacter:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end

        local aimPos = self:GetAimPos(self.State.Target.Parent) or self.State.Target.Position
        local anchorPos = myRoot.Position + Vector3.new(0, self.Config.HeightOffset, 0)
        
        local targetDir = (aimPos - anchorPos).Unit
        local currentDir = self.State.CustomCFrame and self.State.CustomCFrame.LookVector or Camera.CFrame.LookVector
        
        local smoothDir = currentDir:Lerp(targetDir, self.Config.Smoothness).Unit 
        local camPos = anchorPos - smoothDir * self.Config.ZoomDistance
        
        self.State.CustomCFrame = CFrame.lookAt(camPos, camPos + smoothDir)
        Camera.CameraType, Camera.CFrame, Camera.Focus = Enum.CameraType.Scriptable, self.State.CustomCFrame, CFrame.new(aimPos)
    end)

    table.insert(self.Connections, UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseWheel then self.Config.ZoomDistance = math.clamp(self.Config.ZoomDistance - input.Position.Z * 2, 2, 30) end
    end))

    table.insert(self.Connections, UserInputService.TouchStarted:Connect(function(t, gp)
        if gp then return end
        table.insert(self.State.PinchTouches, t)
        if #self.State.PinchTouches == 2 then self.State.LastPinchDistance = (self.State.PinchTouches[1].Position - self.State.PinchTouches[2].Position).Magnitude end
    end))

    table.insert(self.Connections, UserInputService.TouchMoved:Connect(function(t, gp)
        if gp then return end
        for i, touch in ipairs(self.State.PinchTouches) do if touch == t then self.State.PinchTouches[i] = t break end end
        if #self.State.PinchTouches == 2 and self.State.LastPinchDistance then
            local newDist = (self.State.PinchTouches[1].Position - self.State.PinchTouches[2].Position).Magnitude
            self.Config.ZoomDistance = math.clamp(self.Config.ZoomDistance - (newDist - self.State.LastPinchDistance) / 20, 2, 30)
            self.State.LastPinchDistance = newDist
        end
    end))

    table.insert(self.Connections, UserInputService.TouchEnded:Connect(function(t)
        for i, touch in ipairs(self.State.PinchTouches) do if touch == t then table.remove(self.State.PinchTouches, i) break end end
        if #self.State.PinchTouches < 2 then self.State.LastPinchDistance = nil end
    end))
end

function CamlockBot:SetUIVisible(uiFrame, state)
    if not uiFrame then return end
    
    local cPos = uiFrame.Position
    local targetPos = state and cPos or UDim2.new(1.3, 0, cPos.Y.Scale, cPos.Y.Offset)
    local targetTrans = state and 0 or 1

    if state then
        uiFrame.Visible = true
        uiFrame.Position = UDim2.new(1.3, 0, cPos.Y.Scale, cPos.Y.Offset)
        uiFrame.BackgroundTransparency = 1
    end
    
    self:Tween(uiFrame, {Position = targetPos, BackgroundTransparency = targetTrans}, 0.35)
    for _, child in ipairs(uiFrame:GetChildren()) do
        if child:IsA("TextButton") then self:Tween(child, {TextTransparency = targetTrans}, 0.35) end
        if child:IsA("UIStroke") then self:Tween(child, {Transparency = targetTrans}, 0.35) end
    end

    if not state then
        task.delay(0.35, function() 
            uiFrame.Visible = false 
            uiFrame.Position = cPos
        end)
    end
end

