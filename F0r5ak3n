CoreData.Logic.FindNearestTarget = function(allowedFolders)
    CoreData.Temp.ShortestDist = math.huge
    CoreData.Temp.Nearest = nil

    for _, folder in ipairs(allowedFolders) do
        if folder then
            for _, char in ipairs(folder:GetChildren()) do
                if char ~= playerCharacter then
                    CoreData.Temp.TargetRoot = char:FindFirstChild("HumanoidRootPart")
                    if CoreData.Temp.TargetRoot then
                        CoreData.Temp.Dist = (CoreData.Temp.TargetRoot.Position - CoreData.Temp.Root.Position).Magnitude
                        if CoreData.Temp.Dist <= CoreData.Temp.ShortestDist then
                            CoreData.Temp.ShortestDist = CoreData.Temp.Dist
                            CoreData.Temp.Nearest = CoreData.Temp.TargetRoot
                        end
                    end
                end
            end
        end
    end
    return CoreData.Temp.Nearest, CoreData.Temp.ShortestDist
end

CoreData.Logic.UpdateAbilityTarget = function(configKey, stateKey)
    if CoreData.Config[configKey].Enabled then
        CoreData.Temp.SearchFolders = {}
        if table.find(CoreData.Config[configKey].Targets, "Killers") then 
            table.insert(CoreData.Temp.SearchFolders, killersFolder) 
        end
        if table.find(CoreData.Config[configKey].Targets, "Survivors") then 
            table.insert(CoreData.Temp.SearchFolders, survivorsFolder) 
        end
        CoreData.State[stateKey], _ = CoreData.Logic.FindNearestTarget(CoreData.Temp.SearchFolders)
    else
        CoreData.State[stateKey] = nil
    end
end

CoreData.Logic.CanFlintlockAim = function()
    return CoreData.Config.AutoAim.Enabled 
       and CoreData.State.IsFlintlockVisible 
       and CoreData.State.NearestKillerRoot 
       and CoreData.State.KillerDist <= CoreData.Config.AutoAim.MaxDistance
end

CoreData.Logic.GetFlatAimCFrame = function(originPosition, targetPosition)
    return CFrame.lookAt(
        originPosition, 
        Vector3.new(targetPosition.X, originPosition.Y, targetPosition.Z)
    )
end

CoreData.Logic.ApplyPlasmaHook = function()
    CoreData.Temp.Path = ReplicatedStorage:FindFirstChild("Systems")
        and ReplicatedStorage.Systems:FindFirstChild("Player")
        and ReplicatedStorage.Systems.Player:FindFirstChild("Miscellaneous")
        and ReplicatedStorage.Systems.Player.Miscellaneous:FindFirstChild("GetPlayerMousePosition")
        
    if not CoreData.Temp.Path then return end
    
    CoreData.Temp.Module = require(CoreData.Temp.Path)
    CoreData.Temp.OriginalGetMousePos = CoreData.Temp.Module.GetMousePos
    if not CoreData.Temp.OriginalGetMousePos then return end
    
    if CoreData.Temp.Module.__silentAimHooked then return end
    CoreData.Temp.Module.__silentAimHooked = true
    
    CoreData.Hooks.OldGetMousePos = CoreData.Temp.OriginalGetMousePos
    
    hookfunction(CoreData.Temp.Module.GetMousePos, function(...)
        if CoreData.Config.PlasmaBeam.Enabled and CoreData.State.NearestPlasmaRoot then
            return CoreData.State.NearestPlasmaRoot.Position
        end
        
        if CoreData.Config.Nova.Enabled and CoreData.State.NearestNovaRoot then
            return CoreData.State.NearestNovaRoot.Position
        end
        
        return CoreData.Hooks.OldGetMousePos(...)
    end)
end

CoreData.Logic.ApplyCorruptNatureHook = function()
    CoreData.Temp.UtilPath = ReplicatedStorage:FindFirstChild("Modules")
        and ReplicatedStorage.Modules:FindFirstChild("Utilities")
        and ReplicatedStorage.Modules.Utilities:FindFirstChild("Util")
        
    if not CoreData.Temp.UtilPath then return end
    
    CoreData.Temp.UtilModule = require(CoreData.Temp.UtilPath)
    if not CoreData.Temp.UtilModule.GetPlayerMousePosition then return end
    
    if CoreData.Temp.UtilModule.__corruptAimHooked then return end
    CoreData.Temp.UtilModule.__corruptAimHooked = true
    
    CoreData.Hooks.OldUtilGetMousePos = CoreData.Temp.UtilModule.GetPlayerMousePosition
    
    hookfunction(CoreData.Temp.UtilModule.GetPlayerMousePosition, function(...)
        if CoreData.Config.CorruptNature.Enabled and CoreData.State.NearestCorruptRoot then
            return CoreData.State.NearestCorruptRoot.Position
        end
        
        if CoreData.Config.Nova.Enabled and CoreData.State.NearestNovaRoot then
            return CoreData.State.NearestNovaRoot.Position
        end
        
        return CoreData.Hooks.OldUtilGetMousePos(...)
    end)
end

