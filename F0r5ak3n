AbilityEvent = {
    GetNumber = function(value)
        if type(value) == "string" then
            value = string.gsub(value, "[^%d%.]", "")
        end

        return tonumber(value) or 0
    end,

    GetCharge = function(btn)
        local charge = btn:GetAttribute("Charges")

        if charge == nil then
            charge = btn:GetAttribute("Charge")
        end

        if charge ~= nil then
            return tonumber(charge) or 0
        end

        local node =
            btn:FindFirstChild("Charges")
            or btn:FindFirstChild("Charge")
            or btn:FindFirstChild("Count")
            or btn:FindFirstChild("Amount")

        if not node then
            return 0
        end

        if node:IsA("TextLabel")
            or node:IsA("TextBox")
            or node:IsA("TextButton") then
            return AbilityEvent.GetNumber(node.Text)
        end

        return tonumber(node.Value) or 0
    end,

    IsReverse = function(value)
        if type(value) == "string" then
            return string.lower(value) == "true"
        end

        return value == true
    end,

    Fire = function(btn)
        if type(firesignal) == "function" then
            firesignal(btn.MouseButton1Click)
            firesignal(btn.MouseButton1Down)
            firesignal(btn.MouseButton1Up)
            firesignal(btn.Activated)
        elseif btn.Activate then
            btn:Activate()
        end
    end,

    CanUse = function(btn, requiredCharges, reverseCheck, chargeBtn)
        if not btn then
            return false
        end

        chargeBtn = chargeBtn or btn

        for _, child in ipairs(btn:GetChildren()) do
            if child:GetAttribute("IsLockObject") then
                return false
            end
        end

        local cooldown = btn:FindFirstChild("CooldownTime")

        if cooldown and cooldown.Visible then
            if AbilityEvent.GetNumber(cooldown.Text) > 0 then
                return false
            end
        end

        if requiredCharges then
            requiredCharges = tonumber(requiredCharges)

            if requiredCharges then
                local currentCharge = AbilityEvent.GetCharge(chargeBtn)

                if AbilityEvent.IsReverse(reverseCheck) then
                    if currentCharge >= requiredCharges then
                        return false
                    end
                elseif currentCharge < requiredCharges then
                    return false
                end
            end
        end

        return true
    end,

    Use = function(self, abilityName, requiredCharges, reverseCheck, checkAbilityName)
        if not PlayerGui then
            return false
        end

        local mainUI = PlayerGui:FindFirstChild("MainUI")
        local container = mainUI and mainUI:FindFirstChild("AbilityContainer")

        if not container then
            return false
        end

        local targetBtn = container:FindFirstChild(tostring(abilityName))

        if not targetBtn then
            return false
        end

        local chargeBtn = targetBtn

        if checkAbilityName then
            chargeBtn = container:FindFirstChild(tostring(checkAbilityName))

            if not chargeBtn then
                return false
            end
        end

        if self.CanUse(targetBtn, requiredCharges, reverseCheck, chargeBtn) then
            self.Fire(targetBtn)
            return true
        end

        return false
    end
}

