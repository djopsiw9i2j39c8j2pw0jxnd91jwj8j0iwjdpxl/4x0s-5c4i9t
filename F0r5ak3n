function ItemBot.Funcs.InspectAndCache(obj)
    if not obj:IsA("ProximityPrompt") then return end
    
    local itemRoot = obj.Parent
    if not itemRoot or itemRoot.Name ~= "ItemRoot" then return end
    
    local item = itemRoot.Parent
    if not item or item:FindFirstChild("Humanoid") then return end

    ItemBot.State.LiveCache[item] = obj
end

function ItemBot.Funcs.ScanFolder(folder)
    if not folder then return end
    
    for _, obj in ipairs(folder:GetDescendants()) do
        ItemBot.Funcs.InspectAndCache(obj)
    end
    
    folder.DescendantAdded:Connect(function(desc)
        task.delay(0.1, function() ItemBot.Funcs.InspectAndCache(desc) end)
    end)
end

task.spawn(function()
    if IngameFolder then ItemBot.Funcs.ScanFolder(IngameFolder) end
    if TargetMapFolder and TargetMapFolder ~= IngameFolder then 
        ItemBot.Funcs.ScanFolder(TargetMapFolder) 
    end
end)

function ItemBot.Funcs.GetAvailableItems()
    local validItems = {}
    for item, prompt in pairs(ItemBot.State.LiveCache) do
        if item and item.Parent and prompt and prompt.Parent then
            if prompt.Enabled then
                table.insert(validItems, item)
            end
        else
            ItemBot.State.LiveCache[item] = nil
        end
    end
    return validItems
end

function ItemBot.Funcs.TeleportAndPickup(item)
    if not item then return end
    local rootPart = playerCharacter and playerCharacter:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end

    local prompt = ItemBot.State.LiveCache[item]
    local itemRoot = item:FindFirstChild("ItemRoot")
    if not itemRoot or not prompt then return end

    local oldCFrame = rootPart.CFrame
    rootPart.CFrame = itemRoot.CFrame
    task.wait(0.25)
    
    pcall(function() 
        local oldLOS = prompt.RequiresLineOfSight
        prompt.RequiresLineOfSight = false
        fireproximityprompt(prompt) 
        
        task.delay(0.1, function()
            if prompt and prompt.Parent then prompt.RequiresLineOfSight = oldLOS end
        end)
    end)
    
    task.wait(0.3)
    rootPart.CFrame = oldCFrame
end

function ItemBot.Funcs.PickUpItem(mode, specificName)
    local rootPart = playerCharacter and playerCharacter:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end

    local items = ItemBot.Funcs.GetAvailableItems()
    if #items == 0 then return end

    if mode == "Random" then
        ItemBot.Funcs.TeleportAndPickup(items[math.random(1, #items)])
        return
    end

    local closest, minDist = nil, math.huge
    for _, item in ipairs(items) do
        if mode == "Specific" and item.Name ~= specificName then continue end
        
        local dist = (rootPart.Position - item.ItemRoot.Position).Magnitude
        if dist < minDist then 
            minDist = dist 
            closest = item 
        end
    end

    if closest then ItemBot.Funcs.TeleportAndPickup(closest) end
end

