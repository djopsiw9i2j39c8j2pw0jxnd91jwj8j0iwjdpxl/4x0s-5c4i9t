local function UpdateUIScale()
    local camera = Workspace.CurrentCamera
    if not camera then
        UIScale.Scale = 1
        return
    end

    local viewport = camera.ViewportSize
    local width = viewport.X

    if width <= 0 then
        UIScale.Scale = 1
        return
    end

    local scale = width / State.ReferenceWidth

    scale = math.clamp(
        scale,
        State.MinScale,
        State.MaxScale
