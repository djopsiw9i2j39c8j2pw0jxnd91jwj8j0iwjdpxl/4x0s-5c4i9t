App.NormalizeId = function(id) return tostring(id):match("%d+") end

App.NamesFor = function(charName, aliasesTbl)
	App.State.TempNames = { charName }
	App.State.TempLowered = charName:lower()
	for canonical, aliases in pairs(aliasesTbl) do
		if App.State.TempLowered == canonical then
			for _, alias in ipairs(aliases) do table.insert(App.State.TempNames, alias) end
		else
			for _, alias in ipairs(aliases) do
				if App.State.TempLowered == alias:lower() then table.insert(App.State.TempNames, canonical); break end
			end
		end
	end
	return App.State.TempNames
end

App.FindChildCI = function(parent, name)
	if not parent then return nil end
	App.State.TempLoweredChild = name:lower()
	for _, child in ipairs(parent:GetChildren()) do
		if child.Name:lower() == App.State.TempLoweredChild then return child end
	end
	return nil
end

App.MatchKey = function(name, keyList)
	if type(name) ~= "string" then return nil end
	App.State.TempLoweredKey = name:lower()
	for _, key in ipairs(keyList) do
		if App.State.TempLoweredKey == key:lower() then return App.State.TempLoweredKey end
	end
	return nil
end

App.CollectIds = function(value, key, out)
	if type(value) == "string" or type(value) == "number" then
		out[App.NormalizeId(value)] = key
	elseif type(value) == "table" then
		for _, v in ipairs(value) do App.CollectIds(v, key, out) end
	end
end

App.WalkTable = function(tbl, out, depth, keyList)
	if depth > 4 then return end
	for k, v in pairs(tbl) do
		App.State.TempMatched = App.MatchKey(k, keyList)
		if App.State.TempMatched then App.CollectIds(v, App.State.TempMatched, out) end
		if type(v) == "table" then App.WalkTable(v, out, depth + 1, keyList) end
	end
end

App.GetPath = function(parts)
	App.State.TempCurPath = ReplicatedStorage
	for _, name in ipairs(parts) do
		App.State.TempCurPath = App.State.TempCurPath:FindFirstChild(name)
		if not App.State.TempCurPath then return nil end
	end
	return App.State.TempCurPath
end

App.ResolveFolders = function(charName, skin, basePathArr, skinPathArr, aliasesTbl)
	App.State.TempFolderResult, App.State.TempSeenFolders = {}, {}
	App.State.TempSkinRoot, App.State.TempBaseRoot = App.GetPath(skinPathArr), App.GetPath(basePathArr)
	
	for _, name in ipairs(App.NamesFor(charName, aliasesTbl)) do
		App.State.TempTargets = {}
		if App.State.TempSkinRoot and skin and skin ~= "" then
			App.State.TempK = App.FindChildCI(App.State.TempSkinRoot, name)
			table.insert(App.State.TempTargets, App.State.TempK and App.FindChildCI(App.State.TempK, skin))
		end
		if App.State.TempBaseRoot then table.insert(App.State.TempTargets, App.FindChildCI(App.State.TempBaseRoot, name)) end
		for _, folder in ipairs(App.State.TempTargets) do
			if folder and not App.State.TempSeenFolders[folder] then 
				App.State.TempSeenFolders[folder] = true
				table.insert(App.State.TempFolderResult, folder) 
			end
		end
	end
	return App.State.TempFolderResult
end

App.ScanSkills = function(charObj, basePathArr, skinPathArr, aliasesTbl, keyList, out, forceCharName)
	App.State.TempSkin = charObj:GetAttribute("SkinName") or ""
	for _, folder in ipairs(App.ResolveFolders(forceCharName or charObj.Name, App.State.TempSkin, basePathArr, skinPathArr, aliasesTbl)) do
		App.State.TempModule = App.FindChildCI(folder, "config")
		if App.State.TempModule then
			if not App.State.GlobalModuleCache[App.State.TempModule] then
				App.State.GlobalModuleCache[App.State.TempModule] = {}
				App.State.TempOk, App.State.TempData = pcall(require, App.State.TempModule)
				if App.State.TempOk and type(App.State.TempData) == "table" then 
					App.WalkTable(App.State.TempData, App.State.GlobalModuleCache[App.State.TempModule], 0, keyList) 
				end
			end
			for id, key in pairs(App.State.GlobalModuleCache[App.State.TempModule]) do out[id] = key end
		end
	end
end

App.ResolveKiller = function(killer)
