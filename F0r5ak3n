RagdollLogic = {
    Enabled = false,
    CreatedConstraints = {},
    CreatedAttachments = {},
    DisabledMotors = {},
    Temp = {},

    ManageInstance = function(self, class, parent, props, listName)
        self.Temp.Obj = Instance.new(class)
        for k, v in pairs(props) do
            self.Temp.Obj[k] = v
        end
        self.Temp.Obj.Parent = parent
        table.insert(self[listName], self.Temp.Obj)
        return self.Temp.Obj
    end,

    ClearList = function(self, listName)
        for _, obj in ipairs(self[listName]) do
            if obj and obj.Parent then obj:Destroy() end
        end
        table.clear(self[listName])
    end,

    SetState = function(self, stateValue, standValue)
        if not playerCharacter then return end
        playerCharacter:SetAttribute("Ragdolling", stateValue)
        self.Temp.Hum = playerCharacter:FindFirstChildOfClass("Humanoid")
        if self.Temp.Hum then
            self.Temp.Hum.PlatformStand = standValue
        end
    end,

    Toggle = function(self, state)
        self.Enabled = state
        self[self.Enabled and "Enable" or "Disable"](self)
    end,

    Enable = function(self)
        self:Disable()
        
        self.Temp.Hum = playerCharacter and playerCharacter:FindFirstChildOfClass("Humanoid")
        if not self.Temp.Hum or self.Temp.Hum.Health <= 0 then return end

        self:SetState(true, true)

        for _, desc in ipairs(playerCharacter:GetDescendants()) do
            if desc:IsA("Motor6D") and desc.Enabled then
                desc.Enabled = false
                table.insert(self.DisabledMotors, desc)

                self.Temp.P0 = desc.Part0
                self.Temp.P1 = desc.Part1
                
                if self.Temp.P0 and self.Temp.P1 then
                    self.Temp.A0 = self:ManageInstance("Attachment", self.Temp.P0, {CFrame = desc.C0}, "CreatedAttachments")
                    self.Temp.A1 = self:ManageInstance("Attachment", self.Temp.P1, {CFrame = desc.C1}, "CreatedAttachments")
                    
                    self:ManageInstance("BallSocketConstraint", self.Temp.P0, {
                        Attachment0 = self.Temp.A0,
                        Attachment1 = self.Temp.A1,
                        LimitsEnabled = true,
                        TwistLimitsEnabled = true
                    }, "CreatedConstraints")
                end
            end
        end

        self.Temp.Conn = self.Temp.Hum.Died:Connect(function()
            self:Disable()
        end)
    end,

    Disable = function(self)
        if self.Temp.Conn then
            self.Temp.Conn:Disconnect()
            self.Temp.Conn = nil
        end

        self:ClearList("CreatedConstraints")
        self:ClearList("CreatedAttachments")

        for _, motor in ipairs(self.DisabledMotors) do
            if motor and motor.Parent then
                motor.Enabled = true
            end
        end
        table.clear(self.DisabledMotors)

        self:SetState(nil, false)

