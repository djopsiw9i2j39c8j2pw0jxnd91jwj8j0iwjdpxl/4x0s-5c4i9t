ConfigSys = {
    State = {
        Name = "",
        Selected = nil,
        CurrentObject = nil
    },
    Dropdown = nil,
    Manager = Window.ConfigManager,
    Tab = MyUIElements.SettingsManager.MySubTabs.Config
}

function ConfigSys.Notify(title, content, icon)
    WindUI:Notify({ Title = title, Content = content, Duration = 3, Icon = icon })
end

function ConfigSys.GetConfigs()
    return ConfigSys.Manager:AllConfigs()
end

function ConfigSys.RefreshDropdown()
    if not ConfigSys.Dropdown then return end
    ConfigSys.Dropdown:Refresh(ConfigSys.GetConfigs())

    local setFunc = ConfigSys.Dropdown.Set or ConfigSys.Dropdown.SetValue
    if setFunc then
        setFunc(ConfigSys.Dropdown, ConfigSys.State.Selected)
    end
end

function ConfigSys.Exists(name)
    if not name or name == "" then return false end
    for _, cfgName in ipairs(ConfigSys.GetConfigs()) do
        if cfgName == name then return true end
    end
    return false
end

function ConfigSys.Execute(name, action)
    local success, cfg = pcall(function() return ConfigSys.Manager:CreateConfig(name) end)
    if not success or not cfg then return false end

    local actionSuccess = pcall(function()
        if action == "Save" then cfg:Save()
        elseif action == "Load" then cfg:Load()
        elseif action == "Delete" then cfg:Delete() end
    end)

    if actionSuccess and action ~= "Delete" then
        ConfigSys.State.CurrentObject = cfg
        Window.CurrentConfig = cfg
    end
    return actionSuccess
end

function ConfigSys.HandleAction(actionType, errEmpty, errNotExist, successMsg, icon)
    local isMake = (actionType == "Make")
    local targetName = isMake and ConfigSys.State.Name or ConfigSys.State.Selected

    if not targetName or targetName == "" then 
        return ConfigSys.Notify("loc:Config", errEmpty, "circle-alert") 
    end

    local exists = ConfigSys.Exists(targetName)
    if isMake and exists then
        return ConfigSys.Notify("loc:Config", errNotExist, "circle-alert")
    elseif not isMake and not exists then
        return ConfigSys.Notify("loc:Config", errNotExist, "circle-alert")
    end

    local execType = (isMake or actionType == "Update") and "Save" or actionType
    if ConfigSys.Execute(targetName, execType) then
        if isMake then
            ConfigSys.State.Selected = targetName
            ConfigSys.RefreshDropdown()
        elseif actionType == "Delete" then
            ConfigSys.State.Selected = nil
            ConfigSys.State.CurrentObject = nil
            ConfigSys.RefreshDropdown()
        end
        ConfigSys.Notify("loc:Config", successMsg, icon)
    else
        if isMake then ConfigSys.Notify("loc:Config", "Failed to create config", "circle-alert") end
    end
end

