local function IsSelf(obj)
    if not localPlayer then return false end
    if obj == localPlayer then return true end
    
    local char = localPlayer.Character
    if char then
        if obj == char then return true end
        if typeof(obj) == "Instance" and obj:IsDescendantOf(char) then return true end
    end
    return false
end

local function AllocateDrawings(d)
    if not d.Drawings then d.Drawings = {} end
    local draw, set = d.Drawings, d.Settings

    if set.UseHighlight and not draw.Highlight then
        local h = Instance.new("Highlight")
        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        h.Parent = CoreGui
        h.Enabled = false
        draw.Highlight = h
    end

    if set.UseText and not draw.TextBill then
        local tb = Instance.new("BillboardGui")
        tb.AlwaysOnTop = true
        tb.Size = UDim2.new(0, 200, 0, 50)
        tb.StudsOffset = Vector3.new(0, 4, 0)
        tb.Parent = espFolder
        tb.Enabled = false

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.TextStrokeTransparency = 0
        label.TextColor3 = Color3.new(1, 1, 1)
        label.TextSize = 13
        label.FontFace = Font.new("rbxassetid://12187361116", Enum.FontWeight.Bold)
        label.Parent = tb

        draw.TextBill = tb
        draw.TextLabel = label
    end

    if set.UseBox and not draw.Box then
        local b = Instance.new("BillboardGui")
        b.AlwaysOnTop = true
        b.Size = UDim2.new(4.5, 0, 6.5, 0)
        b.Parent = espFolder
        b.Enabled = false

        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 1, 0)
        frame.BackgroundTransparency = 1
        frame.Parent = b

        local stroke = Instance.new("UIStroke")
        stroke.Thickness = 1.5
        stroke.Parent = frame

        draw.Box = b
        draw.BoxStroke = stroke
    end

    if set.UseTracer and not draw.Tracer then
        local line = Instance.new("Frame")
        line.AnchorPoint = Vector2.new(0.5, 0.5)
        line.BorderSizePixel = 0
        line.Visible = false
        line.Parent = tracerGui
        draw.Tracer = line
    end

    return draw
end

local function SetAllVisible(draw, v)
    if not draw then return end
    if draw.TextBill and draw.TextBill.Enabled ~= v then draw.TextBill.Enabled = v end
    if draw.Box and draw.Box.Enabled ~= v then draw.Box.Enabled = v end 
    if draw.Tracer and draw.Tracer.Visible ~= v then draw.Tracer.Visible = v end
    if draw.Highlight and draw.Highlight.Enabled ~= v then draw.Highlight.Enabled = v end
end

function ESP:DangKy(id, obj, settings)
    if not obj or IsSelf(obj) then return end

    settings = settings or {}
    if settings.ShowName == nil then settings.ShowName = true end
    if settings.UseHighlight == nil then settings.UseHighlight = false end
    settings.Color = settings.Color or Color3.new(1, 1, 1)

    if self.Objects[id] then  
        self.Objects[id].Settings = settings  
        self.Objects[id].Object = obj
        self.Objects[id].BaseName = settings.CustomName or (typeof(obj) == "Instance" and obj.Name or tostring(obj))
        return  
    end  
    
    local isInst = typeof(obj) == "Instance"  
    self.Objects[id] = {  
        Object = obj, Settings = settings, Drawings = nil,
        IsActive = true, BaseName = settings.CustomName or (isInst and obj.Name or tostring(obj)),  
        IsInstance = isInst, IsPlayer = isInst and obj:IsA("Player"), DisplayText = ""   
    }
end

function ESP:Huy(id)
    local d = self.Objects[id]
    if d then
        if d.Drawings then
            local draw = d.Drawings
            if draw.Highlight then draw.Highlight:Destroy() end
            if draw.TextBill then draw.TextBill:Destroy() end
            if draw.Box then draw.Box:Destroy() end
            if draw.Tracer then draw.Tracer:Destroy() end
        end
        self.Objects[id] = nil
    end
end

function ESP:RemoveAllEsp()
    for id in pairs(self.Objects) do self:Huy(id) end
    if self.Connection then self.Connection:Disconnect() end
    if self.PlayerRemovingConn then self.PlayerRemovingConn:Disconnect() end
    if self.ViewSizeConn then self.ViewSizeConn:Disconnect() end
end

