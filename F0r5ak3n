App.GetPositionData = function(pRoot, kRoot)
	App.State.PosDelta = (pRoot.Position - kRoot.Position) * App.State.FlatVec
	App.State.PosDist = App.State.PosDelta.Magnitude
	App.State.KVel = kRoot.AssemblyLinearVelocity * App.State.FlatVec
	App.State.KLookVec = (kRoot.CFrame.LookVector * App.State.FlatVec).Unit
end

App.AntiBait = {}

App.AntiBait.BuildExclude = function(killer)
	App.State.TempExclude = { playerCharacter, killer }
	for _, folder in ipairs({ killersFolder, survivorsFolder }) do
		for _, model in ipairs(folder:GetChildren()) do
			if model ~= killer then table.insert(App.State.TempExclude, model) end
		end
	end
	return App.State.TempExclude
end

App.AntiBait.WallCheck = function(killer, pRoot, kRoot)
	App.State.RayOrigin, App.State.RayDelta = pRoot.Position, kRoot.Position - pRoot.Position
	if App.State.RayDelta.Magnitude < 0.01 then return true end

	App.Inst.AntiBaitParams.FilterDescendantsInstances = App.AntiBait.BuildExclude(killer)

	for _ = 1, App.Config.AntiBait.MaxBounces do
		App.State.RayHit = Workspace:Raycast(App.State.RayOrigin, App.State.RayDelta, App.Inst.AntiBaitParams)
		if not App.State.RayHit then return true end
		if App.State.RayHit.Instance.CanCollide then return false end
		App.State.RayOrigin = App.State.RayHit.Position + App.State.RayDelta.Unit * 0.1
		App.State.RayDelta  = kRoot.Position - App.State.RayOrigin
	end
	return true
end

App.AntiBait.AngleCheck = function(killer, pRoot, kRoot)
	App.GetPositionData(pRoot, kRoot)
	if App.State.PosDist < 0.01 then return true end
	
	App.State.TempAngleData = App.State.AngleData[killer]
	if App.State.TempAngleData and App.State.TempAngleData.Spinning then return true end
	
	return App.State.KLookVec:Dot(App.State.PosDelta.Unit) > App.Config.AntiBait.ViewDot
end

App.AntiBait.RetreatCheck = function(killer, pRoot, kRoot)
	App.GetPositionData(pRoot, kRoot)
	if App.State.KVel.Magnitude < 1.5 or App.State.PosDist < 0.01 then return true end
	
	App.State.TempRetreat = App.State.RetreatData[killer]
	if not App.State.TempRetreat then
		App.State.TempRetreat = { Dist = 0, LastPos = kRoot.Position, LastClock = os.clock() }
		App.State.RetreatData[killer] = App.State.TempRetreat
	end
	
	if os.clock() - App.State.TempRetreat.LastClock > App.Config.AntiBait.RecheckGap then
		App.State.TempRetreat.Dist = 0
	end
	App.State.TempRetreat.LastClock = os.clock()
	
	App.State.MoveDelta = (kRoot.Position - App.State.TempRetreat.LastPos) * App.State.FlatVec
	App.State.TempRetreat.LastPos = kRoot.Position
	
	App.State.MoveDot = App.State.KVel.Unit:Dot(App.State.PosDelta.Unit)
	
	if App.State.MoveDot <= App.Config.AntiBait.RetreatDot then
		App.State.TempRetreat.Dist += App.State.MoveDelta.Magnitude
	elseif App.State.MoveDot >= App.Config.AntiBait.ApproachDot then
		App.State.TempRetreat.Dist = 0
	end
	
	return App.State.TempRetreat.Dist < App.Config.AntiBait.RetreatDist
end

App.AntiBait.BackwardsApproachCheck = function(killer, pRoot, kRoot)
	App.GetPositionData(pRoot, kRoot)
	
	if App.State.KVel.Magnitude < 1.5 or App.State.PosDist < 0.01 then 
		App.State.BaitTimestamps[killer] = nil 
		return true 
	end
	
	App.State.FacingPlayer = App.State.KLookVec:Dot(App.State.PosDelta.Unit)
	App.State.MovingToPlayer = App.State.KVel.Unit:Dot(App.State.PosDelta.Unit)
	App.State.IsMoonwalking = App.State.KVel.Unit:Dot(App.State.KLookVec)

	if App.State.FacingPlayer < -0.2 and App.State.MovingToPlayer > 0.3 and App.State.IsMoonwalking < -0.5 then
		App.State.BaitTimestamps[killer] = App.State.BaitTimestamps[killer] or os.clock()
		if os.clock() - App.State.BaitTimestamps[killer] >= 0.5 then
			return false 
		end
	else
		App.State.BaitTimestamps[killer] = nil 
	end
	
	return true
end

App.AntiBait.Run = function(killer)
	App.State.PRoot, App.State.KRoot = App.GetRoot(playerCharacter), App.GetRoot(killer)
	if not (App.State.PRoot and App.State.KRoot) then return false end

	if (App.State.PRoot.Position - App.State.KRoot.Position).Magnitude <= App.Config.AntiBait.CloseDist then
		return true
	end

	for checkName, isActive in pairs(App.State.ActiveAntiBait) do
		if isActive and App.AntiBait[checkName] and not App.AntiBait[checkName](killer, App.State.PRoot, App.State.KRoot) then 
			return false 
		end
	end
	return true
end

App.UpdateSpinTracking = function(dt)
	if not (App.State.Flags.AutoBlock and App.State.ActiveAntiBait.AngleCheck) then
		if next(App.State.AngleData) then table.clear(App.State.AngleData) end
		return
	end
	for killer in pairs(App.State.KillerStates) do
		App.State.TrackRoot = App.GetRoot(killer)
		if App.State.TrackRoot then
			App.State.TrackLookFlat = App.State.TrackRoot.CFrame.LookVector * App.State.FlatVec
			if App.State.TrackLookFlat.Magnitude >= 0.001 then
				App.State.TrackLook = App.State.TrackLookFlat.Unit
				App.State.TrackData = App.State.AngleData[killer]
				if not App.State.TrackData then
					App.State.AngleData[killer] = { LastLook = App.State.TrackLook, SpinTime = 0, Spinning = false }
				else
					App.State.TurnDot = math.clamp(App.State.TrackData.LastLook:Dot(App.State.TrackLook), -1, 1)
					App.State.TurnSpeed = math.deg(math.acos(App.State.TurnDot)) / math.max(dt, 1e-4)
					if App.State.TurnSpeed >= App.Config.AntiBait.SpinSpeed then
						App.State.TrackData.SpinTime += dt
						if App.State.TrackData.SpinTime >= App.Config.AntiBait.SpinTime then
							App.State.TrackData.Spinning = true
						end
					else
						App.State.TrackData.SpinTime, App.State.TrackData.Spinning = 0, false
					end
					App.State.TrackData.LastLook = App.State.TrackLook
				end
			end
		end
	end
end

App.PlayerInVirtualHitbox = function(killer, key)
	App.State.HitKRoot, App.State.HitPRoot = App.GetRoot(killer), App.GetRoot(playerCharacter)
	if not (App.State.HitKRoot and App.State.HitPRoot) then return false end
