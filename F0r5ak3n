local function SetupMapEvents(mapFolder)
    mapFolder.ChildAdded:Connect(function(child)
        if child.Name == "Generator" and GeneratorESPConfig.Enabled then
            HandleGeneratorESP(child, false, GeneratorESPConfig)
        elseif child.Name == "FakeGenerator" and FakeGenESPConfig.Enabled then
            HandleGeneratorESP(child, true, FakeGenESPConfig)
        end
    end)

    mapFolder.ChildRemoved:Connect(function(child)
        if child.Name == "Generator" then
            ESP:Huy("Gen_" .. (child:GetDebugId() or child.Name))
        elseif child.Name == "FakeGenerator" then
            ESP:Huy("FakeGen_" .. (child:GetDebugId() or child.Name))
        end
    end)
end

for _, child in ipairs(IngameFolder:GetChildren()) do
