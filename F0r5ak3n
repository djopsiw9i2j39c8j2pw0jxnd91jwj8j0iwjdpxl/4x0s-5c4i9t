TeleportLogic = {
    Height = 100,
    SelectedSurvivor = nil,
    SelectedKiller = nil,
    SelectedGen = nil,
    SurvivorDropdown = nil,
    KillerDropdown = nil,
    GenDropdown = nil,
    SurvivorHash = "",
    KillerHash = "",
    GenHash = "",
    GenCache = {},

    DoTeleport = function(self, targetCFrame)
        self.TempHRP = playerCharacter and playerCharacter:FindFirstChild("HumanoidRootPart")
        if self.TempHRP and targetCFrame then
            self.TempHRP.CFrame = targetCFrame
        end
    end,

    ExecuteUp = function(self)
        self.TempHRP = playerCharacter and playerCharacter:FindFirstChild("HumanoidRootPart")
        if self.TempHRP then
            self:DoTeleport(self.TempHRP.CFrame + Vector3.new(0, self.Height, 0))
        end
    end,

    GetNamesFromFolder = function(self, folder)
        self.TempList = {} 
        if folder then
            for _, obj in pairs(folder:GetChildren()) do
                table.insert(self.TempList, obj.Name)
            end
        end
        return self.TempList
    end,

    GetGenerators = function(self)
        self.GenNames = {}
        self.GenCache = {}
        
        if TargetMapFolder then
            self.GenCount = 1
            for _, obj in pairs(TargetMapFolder:GetChildren()) do
                if obj.Name == "Generator" then
                    self.GenDisplayName = "Generator " .. tostring(self.GenCount)
                    table.insert(self.GenNames, self.GenDisplayName)
                    self.GenCache[self.GenDisplayName] = obj
                    self.GenCount = self.GenCount + 1
                end
            end
        end
        return self.GenNames
    end,

    TeleportToTarget = function(self, targetName, folder)
        if targetName and folder then
            self.TargetObj = folder:FindFirstChild(targetName)
            self.TargetHRP = self.TargetObj and self.TargetObj:FindFirstChild("HumanoidRootPart")
            if self.TargetHRP then
                self:DoTeleport(self.TargetHRP.CFrame)
            end
        end
    end,

    TeleportToGen = function(self)
        if self.SelectedGen and self.GenCache[self.SelectedGen] then
            self.TargetGen = self.GenCache[self.SelectedGen]
            self.GenPart = self.TargetGen.PrimaryPart or self.TargetGen:FindFirstChildWhichIsA("BasePart")
            if self.GenPart then
                self:DoTeleport(self.GenPart.CFrame * CFrame.new(0, 0, -6))
            end
        end
    end,

    RefreshDropdownIfNeeded = function(self, dropdownObj, hashProperty, getListFunc)
        if not dropdownObj then return end
        
        self.CurrentNames = getListFunc(self)
        self.NewHash = table.concat(self.CurrentNames, ",")
        
        if self[hashProperty] ~= self.NewHash then
            self[hashProperty] = self.NewHash
            pcall(function() dropdownObj:SetValues(self.CurrentNames) end)
            pcall(function() dropdownObj:Refresh(self.CurrentNames, true) end)
        end
    end,

    BindFolderEvents = function(self, folder, dropdownObj, hashProperty, getListFunc)
        if not folder then return end
        
        folder.ChildAdded:Connect(function()
            task.delay(1, function()
                self:RefreshDropdownIfNeeded(dropdownObj, hashProperty, getListFunc)
            end)
        end)
        
        folder.ChildRemoved:Connect(function()
            self:RefreshDropdownIfNeeded(dropdownObj, hashProperty, getListFunc)
        end)
    end,

    InitEvents = function(self)
        self.GetSurvivorFunc = function(s) return s:GetNamesFromFolder(survivorsFolder) end
        self.GetKillerFunc = function(s) return s:GetNamesFromFolder(killersFolder) end
        self.GetGenFunc = function(s) return s:GetGenerators() end
        self:BindFolderEvents(survivorsFolder, self.SurvivorDropdown, "SurvivorHash", self.GetSurvivorFunc)
        self:BindFolderEvents(killersFolder, self.KillerDropdown, "KillerHash", self.GetKillerFunc)
        self:BindFolderEvents(IngameFolder, self.GenDropdown, "GenHash", self.GetGenFunc)
    end
}

