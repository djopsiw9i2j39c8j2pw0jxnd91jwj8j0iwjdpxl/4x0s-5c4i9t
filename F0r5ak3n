AutoManager = {
    State = {
        AutoQTE = false,
        AutoBloodhook = false,
        Hooks = {
            QTE = false,
            Network = false,
            InputLoop = false
        }
    },
    
    Targets = {
        QTE = {"cl_ConstructQTE", "ConstructQTE"},
        Network = {"Network"}
    },

    GetModule = function(self, hookType)
        for _, name in ipairs(self.Targets[hookType]) do
            local found = ReplicatedStorage:FindFirstChild(name, true)
            if found then return found end
        end
        return nil
    end,

    StartBloodhookMash = function(self)
        if self.State.Hooks.InputLoop then return end
        self.State.Hooks.InputLoop = true
        
        task.spawn(function()
            while self.State.AutoBloodhook do
                task.wait(0.01)
                
                local tempUI = PlayerGui:FindFirstChild("TemporaryUI")
                local qteGui = (tempUI and tempUI:FindFirstChildWhichIsA("ScreenGui")) 
                            or PlayerGui:FindFirstChild("QTE") 
                            or PlayerGui:FindFirstChild("Bloodhook")
                
                if qteGui and (qteGui:IsA("ScreenGui") and qteGui.Enabled or qteGui.Visible) then
                    for _, btn in ipairs(qteGui:GetDescendants()) do
                        if btn:IsA("GuiButton") and btn.Visible then
                            if firesignal then
                                firesignal(btn.MouseButton1Down)
                                firesignal(btn.MouseButton1Click)
                                firesignal(btn.Activated)
                            end
                        end
                    end
                    
                    VirtualUser:CaptureController()
                    VirtualUser:Button1Down(Vector2.new(0, 0))
                    VirtualUser:Button1Up(Vector2.new(0, 0))
                end
            end
            self.State.Hooks.InputLoop = false
        end)
    end,

    InitHook = function(self, hookType)
        if self.State.Hooks[hookType] then return end
        
        local module = self:GetModule(hookType)
        if not (module and module:IsA("ModuleScript")) then return end
        
        local success, data = pcall(require, module)
        if not (success and type(data) == "table") then return end
        
        if hookType == "QTE" and data.new then
            local originalNew = data.new
            
            data.new = function(...)
                local tempInstance = originalNew(...)
                
                if self.State.AutoQTE then
                    task.spawn(function(qte)
                        task.wait(0.1)
                        if type(qte) == "table" and qte.AddProgress then
                            qte:AddProgress(100)
                        end
                    end, tempInstance)
                end
                
                return tempInstance
            end
            self.State.Hooks[hookType] = true
            
        elseif hookType == "Network" and data.FireServerConnection then
            local originalFire = data.FireServerConnection
            
            data.FireServerConnection = function(...)
                local tempArgs = {...}
                
                if self.State.AutoBloodhook then
                    if type(tempArgs[2]) == "string" and string.find(tempArgs[2], "NosHookQTE") then
                        tempArgs[4] = true
                    end
                end
                
                return originalFire(unpack(tempArgs))
            end
            self.State.Hooks[hookType] = true
        end
    end
}

