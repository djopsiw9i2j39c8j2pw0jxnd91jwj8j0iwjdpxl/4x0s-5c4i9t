local CurrentMap = nil

local function HandleGeneratorESP(obj, isFake, config)
    task.spawn(function()
        local prefix = isFake and "FakeGen_" or "Gen_"
        local defaultName = isFake and "Fake Generator" or "Generator"
        local id = prefix .. (obj:GetDebugId() or obj.Name)
        
        local progress = obj:WaitForChild("Progress", 3)
        
        local function UpdateESP()
            if not config.Enabled then
                ESP:Huy(id)
                return
            end
            
            if progress and progress:IsA("NumberValue") and progress.Value >= 100 then
                ESP:Huy(id)
                return
            end
            
            local displayName = defaultName
            if config.TextFormat.Progress and progress and progress:IsA("NumberValue") then
                displayName = defaultName .. " [" .. math.floor(progress.Value) .. "%]"
            end
            
            ESP:DangKy(id, obj, {
                UseHighlight = config.Types.Highlight,
                UseText = config.Types.Text,
                UseBox = config.Types.Box,
                UseTracer = config.Types.Tracer,
                Color = config.Color,
                ShowName = config.TextFormat.Name,
                ShowHP = false,
                ShowDistance = config.TextFormat.Distance,
                CustomName = displayName
            })
        end

        if progress and progress:IsA("NumberValue") then
            if not progress:GetAttribute("ESP_Watch") then
                progress:SetAttribute("ESP_Watch", true)
                progress:GetPropertyChangedSignal("Value"):Connect(function()
                    if config.Enabled then
                        UpdateESP()
                    end
                end)
            end
        end
        
        UpdateESP()
    end)
end

local GeneratorESPConfig = {
    Enabled = false,
    Types = { Highlight = true, Text = false, Box = false, Tracer = false },
