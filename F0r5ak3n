    Parent = ConfigSys.Tab,
    Title = "loc:Auto_Load_Config",
    Desc = "loc:Auto_Load_Config_Desc",
    AutoSaveInterval = 3,
    Resolve = function()
        if not ConfigSys.State.Selected or ConfigSys.State.Selected == "" then
            ConfigSys.Notify("loc:Config", "loc:AutoLoad_NoSelection", "circle-alert")
            return nil
        end

        if not ConfigSys.Exists(ConfigSys.State.Selected) then
            ConfigSys.Notify("loc:Config", "loc:AutoLoad_NotExist", "circle-alert")
            return nil
        end

        if not ConfigSys.Execute(ConfigSys.State.Selected, "Load") then
            ConfigSys.Notify("loc:Config", "loc:AutoLoad_LoadFailed", "circle-alert")
            return nil
        end

        return ConfigSys.State.CurrentObject
    end,
    OnEnabled = function()
        ConfigSys.Notify("loc:Config", "loc:AutoLoad_Enabled", "check")
    end,
    OnDisabled = function()
        ConfigSys.Notify("loc:Config", "loc:AutoLoad_Disabled", "info")
    end,
    OnError = function(reason)
