function VisualBot:UpdateCamera()
    if self.Config.EnableZoom then
        localPlayer.CameraMinZoomDistance = self.Config.ZoomMin
        localPlayer.CameraMaxZoomDistance = self.Config.ZoomMax
    else
        localPlayer.CameraMinZoomDistance = self.Originals.ZoomMin
        localPlayer.CameraMaxZoomDistance = self.Originals.ZoomMax
    end
end

function VisualBot:RestoreLighting()
    if not self.Config.Fullbright then
        Lighting.Ambient = self.Originals.Ambient
        Lighting.OutdoorAmbient = self.Originals.OutdoorAmbient
        Lighting.Brightness = self.Originals.Brightness
        Lighting.GlobalShadows = self.Originals.GlobalShadows
    end
    
    if not self.Config.NoFog then
        Lighting.FogEnd = self.Originals.FogEnd
        for atmo, density in pairs(self.Originals.Atmospheres) do
            if atmo and atmo.Parent then
                atmo.Density = density
            end
        end
    end
end

function VisualBot:UpdateLightingEngine()
    if not self.Connections.LightingLoop then
        self.Connections.LightingLoop = RunService.Heartbeat:Connect(function()
            if self.Config.Fullbright then
                Lighting.Ambient = Color3.fromRGB(150, 150, 150)
                Lighting.OutdoorAmbient = Color3.fromRGB(150, 150, 150)
                Lighting.GlobalShadows = false
            end
            
            if self.Config.NoFog then
                Lighting.FogEnd = 100000
                for _, v in ipairs(Lighting:GetChildren()) do
                    if v:IsA("Atmosphere") then
                        v.Density = 0
                    end
                end
            end
        end)
    end
end

function VisualBot:StopLightingEngine()
    if not self.Config.Fullbright and not self.Config.NoFog then
        if self.Connections.LightingLoop then
            self.Connections.LightingLoop:Disconnect()
            self.Connections.LightingLoop = nil
        end
    end
end

