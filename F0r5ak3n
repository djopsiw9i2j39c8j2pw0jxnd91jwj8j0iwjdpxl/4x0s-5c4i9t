AFKBypass = {
    Enabled = false,
    Initialized = false,
    OldHooks = {},
    Loop = nil,
    NetworkMod = nil,
    Method = ""
}

-- Tách logic chặn Remote ra function riêng (DRY & Không local)
function HookNetwork(self, name, ...)
    if AFKBypass.Enabled and name == "AFKInsanity" then
        return -- Chặn hoàn toàn tín hiệu báo AFK lên server
    end
    return AFKBypass.OldHooks.FireServer(self, name, ...)
end

-- Tách logic fake input ra function riêng (DRY & Không local)
function HookNamecall(self, ...)
    AFKBypass.Method = getnamecallmethod()
    -- Lừa hàm GetKeysPressed của game là ta luôn đang giữ phím Space
    if AFKBypass.Enabled and not checkcaller() and self == UserInputService and AFKBypass.Method == "GetKeysPressed" then
        return {Enum.KeyCode.Space}
    end
    return AFKBypass.OldHooks.Namecall(self, ...)
end

-- Function khởi tạo Hook, chỉ chạy 1 lần duy nhất
function InitAFK()
    if AFKBypass.Initialized then return end
    AFKBypass.Initialized = true
    
    -- Hook vào thẳng Module Network của game (đúng đường dẫn trong source bro gửi)
    AFKBypass.NetworkMod = require(ReplicatedStorage.Modules.Network.Network)
    AFKBypass.OldHooks.FireServer = AFKBypass.NetworkMod.FireServerConnection
    AFKBypass.NetworkMod.FireServerConnection = HookNetwork
    
    -- Hook namecall để bypass GetKeysPressed
    AFKBypass.OldHooks.Namecall = hookmetamethod(game, "__namecall", HookNamecall)
end

-- Function trị triệt để lỗi AFK do văng cửa sổ (Tab out)
function ForceWindowFocus()
    if not getconnections then return end
    -- Bắn event báo game rằng người chơi đang focus màn hình liên tục
    for _, conn in ipairs(getconnections(UserInputService.WindowFocused)) do
        conn:Fire()
    end
end

