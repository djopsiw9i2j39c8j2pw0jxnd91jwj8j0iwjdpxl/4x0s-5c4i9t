end

StatusLogic.EscapeString = function(self, str)
    return string.gsub(str, "[%^%$%(%)%%%.%[%]%*%+%-%?]", "%%%1")
end

StatusLogic.ProcessTextReplacement = function(self, object, pathInfo)
    if self.Cache.IsUpdating then return end
    self.Cache.IsUpdating = true

    self.Cache.OldText = object.Text
    self.Cache.NewText = self.Cache.OldText
    self.Cache.IsTarget = false

    if pathInfo.Type == "Name" and self.CustomNameEnabled then
        if string.find(self.Cache.OldText, self:EscapeString(localPlayer.DisplayName)) then
            self.Cache.NewText = string.gsub(self.Cache.OldText, self:EscapeString(localPlayer.DisplayName), self.CustomName)
            self.Cache.IsTarget = true
        elseif string.find(self.Cache.OldText, self:EscapeString(localPlayer.Name)) then
            self.Cache.NewText = string.gsub(self.Cache.OldText, self:EscapeString(localPlayer.Name), self.CustomName)
            self.Cache.IsTarget = true
        end
    elseif pathInfo.Type == "Stat" then
        self.Cache.BaseText = self.OriginalTexts[object] or self.Cache.OldText
        
        if pathInfo.StatName == "Time" and self.Toggles.Time then
            self.Cache.BaseTime = self:ParseClockToSeconds(self.Cache.BaseText)
            self.Cache.NewText = "Time Played: " .. self:FormatClock(self.Cache.BaseTime + self.CustomStats.Time)
            self.Cache.IsTarget = true
        elseif pathInfo.StatName == "SurvivorWins" and self.Toggles.SurvivorWins then
            self.Cache.BaseWins = self:ParseNumber(self.Cache.BaseText)
            self.Cache.NewText = tostring(self.Cache.BaseWins + self.CustomStats.SurvivorWins)
            self.Cache.IsTarget = true
        elseif pathInfo.StatName == "KillerWins" and self.Toggles.KillerWins then
            self.Cache.BaseWins = self:ParseNumber(self.Cache.BaseText)
            self.Cache.NewText = tostring(self.Cache.BaseWins + self.CustomStats.KillerWins)
            self.Cache.IsTarget = true
        end
    end

    if self.Cache.IsTarget and object.Text ~= self.Cache.NewText then
        object.Text = self.Cache.NewText
        self.Cache.LastSetTexts[object] = self.Cache.NewText
    end
    
    self.Cache.IsUpdating = false
end

StatusLogic.WatchObject = function(self, object, pathInfo)
    if self.WatchedObjects[object] then return end
    self.WatchedObjects[object] = true

    if not self.OriginalTexts[object] then
        self.OriginalTexts[object] = object.Text
    end

    self:ProcessTextReplacement(object, pathInfo)
    
    table.insert(self.Connections, object:GetPropertyChangedSignal("Text"):Connect(function()
        if self.Cache.IsUpdating then return end
        
        if object.Text ~= self.Cache.LastSetTexts[object] then
            self.OriginalTexts[object] = object.Text
            self:ProcessTextReplacement(object, pathInfo)
        end
    end))
end

StatusLogic.RestoreTexts = function(self)
    self.Cache.IsUpdating = true
    for TargetObject, OriginalText in pairs(self.OriginalTexts) do
        if TargetObject and TargetObject.Parent then
            TargetObject.Text = OriginalText
        end
    end
    self.Cache.IsUpdating = false
    table.clear(self.OriginalTexts)
    table.clear(self.Cache.LastSetTexts)
end

StatusLogic.ProcessObject = function(self, object)
    if not object or not object:IsA("TextLabel") or not self.TargetPaths[object.Name] then return end

    for _, Path in ipairs(self.TargetPaths[object.Name]) do
        if Path.Type == "Name" and self.CustomNameEnabled then
            if Path.Depth == 1 and object.Parent and object.Parent.Name == Path.ParentName then
                self:WatchObject(object, Path)
                break
            elseif Path.Depth == 2 and object.Parent and object.Parent.Parent and object.Parent.Parent.Name == Path.ParentName then
                self:WatchObject(object, Path)
                break
            end
        elseif Path.Type == "Stat" then
            if (Path.StatName == "Time" and self.Toggles.Time) or 
               (Path.StatName == "SurvivorWins" and self.Toggles.SurvivorWins and object.Parent and object.Parent.Name == Path.ParentName) or
               (Path.StatName == "KillerWins" and self.Toggles.KillerWins and object.Parent and object.Parent.Name == Path.ParentName) then
                self:WatchObject(object, Path)
                break
            end
        end
    end
end

