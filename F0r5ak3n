            ForceWindowFocus()
            
            -- Lặp lại việc force focus để chống Tab-out
            if not AFKBypass.Loop then
                AFKBypass.Loop = RunService.Heartbeat:Connect(function()
                    if AFKBypass.Enabled then
                        ForceWindowFocus()
                    end
                end)
            end
        else
            -- Tắt gọn gàng, tránh lặp lại loop (áp dụng đúng Rule 3)
            if AFKBypass.Loop then
                AFKBypass.Loop:Disconnect()
                AFKBypass.Loop = nil
            end
        end
    end
})

local BypassSystem = {
    Config = { AntiSubspace = false, AntiBlindness = false },
    Core = { Lighting = game.Lighting, Player = game.Players.LocalPlayer }
}

function BypassSystem:SafeDestroy(parent, name)
    local effect = parent:FindFirstChild(name)
    if effect then
        effect.Enabled = false
        effect:Destroy()
        return true
    end
    return false
end

function BypassSystem:ProcessVFX()
    local light = self.Core.Lighting
    
    if self.Config.AntiSubspace then
        local removedBlur = self:SafeDestroy(light, "SubspaceVFXBlur")
        local removedCC = self:SafeDestroy(light, "SubspaceVFXColorCorrection")

        if removedBlur or removedCC then
            for _, v in ipairs(light:GetChildren()) do
                local origVal = v:GetAttribute("originalVal")
                if origVal ~= nil then v.Enabled = origVal end
            end
        end

        local char = self.Core.Player.Character
        if char and char:GetAttribute("MuteChaseThemes") then
            char:SetAttribute("MuteChaseThemes", false)
        end
    end

    if self.Config.AntiBlindness then
        self:SafeDestroy(light, "BlindnessBlur")
        
        if light.ExposureCompensation < -2 or light.ExposureCompensation > 2 then
            light.ExposureCompensation = 0 
        end
    end
end

task.spawn(function()
    while task.wait(0.25) do
        if BypassSystem.Config.AntiSubspace or BypassSystem.Config.AntiBlindness then
            BypassSystem:ProcessVFX()
        end
    end
end)

