local ServerManager = {
    ManualJobId = ""
}

function ServerManager:RandomHop()
    local url = "https://games.roblox.com/v1/games/" .. tostring(game.PlaceId) .. "/servers/Public?sortOrder=Asc&limit=100"
    
    local response = nil
    pcall(function()
        response = request({
            Url = url,
            Method = "GET"
        })
    end)
    
    if response and response.StatusCode == 200 then
        local data = HttpService:JSONDecode(response.Body)
        if data and data.data then
            local validServers = {}
            for _, srv in ipairs(data.data) do
                if srv.playing and srv.maxPlayers and srv.playing < srv.maxPlayers and srv.id ~= game.JobId then
                    table.insert(validServers, srv)
                end
            end
            
            if #validServers > 0 then
                local randomServer = validServers[math.random(1, #validServers)]
                TeleportService:TeleportToPlaceInstance(game.PlaceId, randomServer.id, localPlayer)
            end
        end
    end
end

