function AxosToggle.UpdatePosition(input)
    local state = AxosToggle.State

    if not state.dragStartPos or not state.startGuiPos then
        return
    end

    local delta = input.Position - state.dragStartPos

    if delta.Magnitude > 5 then
        state.isDragMove = true
    end

    Btn.Position = UDim2.new(
        state.startGuiPos.X.Scale,
        state.startGuiPos.X.Offset + delta.X,

        state.startGuiPos.Y.Scale,
        state.startGuiPos.Y.Offset + delta.Y
    )
end

function AxosToggle.Began(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        local state = AxosToggle.State

        state.isDragging = true
        state.isDragMove = false
        state.dragStartPos = input.Position
        state.startGuiPos = Btn.Position
        state.dragInput = input
    end
end

function AxosToggle.Ended(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        local state = AxosToggle.State

        state.isDragging = false

        if not state.isDragMove then
            if Window and typeof(Window.Toggle) == "function" then
                Window:Toggle()
            end
        end

        state.isDragMove = false
        state.dragInput = nil
    end
end

