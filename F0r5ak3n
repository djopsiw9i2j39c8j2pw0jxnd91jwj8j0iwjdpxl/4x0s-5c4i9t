function FreezeCharacter(humanoid, hrp)
    AppState.OldWalkSpeed = humanoid.WalkSpeed
    AppState.OldJumpPower = humanoid.JumpPower
    AppState.OldJumpHeight = humanoid.JumpHeight
    AppState.OldAutoRotate = humanoid.AutoRotate
    AppState.OldUseJumpPower = humanoid.UseJumpPower

    humanoid.WalkSpeed = 0
    humanoid.AutoRotate = false
    if humanoid.UseJumpPower then
        humanoid.JumpPower = 0
    else
        humanoid.JumpHeight = 0
    end
    humanoid.Jump = false
    humanoid:Move(Vector3.zero, false)
    ZeroVelocity(hrp)
end

function UnfreezeCharacter(humanoid, hrp)
    humanoid.WalkSpeed = AppState.OldWalkSpeed or 16
    humanoid.AutoRotate = AppState.OldAutoRotate ~= false
    if AppState.OldUseJumpPower then
        humanoid.UseJumpPower = true
        humanoid.JumpPower = AppState.OldJumpPower or 50
    else
        humanoid.UseJumpPower = false
        humanoid.JumpHeight = AppState.OldJumpHeight or 7.2
    end
    humanoid.Jump = false
    humanoid:Move(Vector3.zero, false)
    ZeroVelocity(hrp)
end

function StartFreecam()
    if AppState.InFreecam then return false end

    AppState.Hrp = GetHRP()
    if not AppState.Hrp then return false end

    AppState.OriginalCharacterCFrame = AppState.Hrp.CFrame
    AppState.SafeCFrame = GetHighestSafePos(AppState.OriginalCharacterCFrame.Position)
    if not AppState.SafeCFrame then
        AppState.FreecamEndTick = 0
        return false
    end

    AppState.InFreecam = true
    AppState.FreecamEndTick = os.clock() + PortalConfig.FreecamDuration
    AppState.PendingTeleportCFrame = AppState.SafeCFrame

    AppState.Humanoid = localPlayer.Character and localPlayer.Character:FindFirstChildOfClass("Humanoid")
    if AppState.Humanoid then
        FreezeCharacter(AppState.Humanoid, AppState.Hrp)
    end

    AppState.CamPart = Instance.new("Part")
    AppState.CamPart.Transparency = 1
    AppState.CamPart.Anchored = true
    AppState.CamPart.CanCollide = false
    AppState.CamPart.Size = Vector3.new(1, 1, 1)
    AppState.CamPart.CFrame = CFrame.new(AppState.Hrp.Position)
    AppState.CamPart.Parent = Workspace

    task.delay(0.15, function()
        if not AppState.InFreecam then return end
        AppState.Hrp = GetHRP()
        if AppState.Hrp and AppState.PendingTeleportCFrame then
            AppState.Hrp.CFrame = AppState.PendingTeleportCFrame
            ZeroVelocity(AppState.Hrp)
            AppState.PendingTeleportCFrame = nil
        end
    end)

    AppState.CamPitch, AppState.CamYaw = Camera.CFrame:ToEulerAnglesYXZ()
    Camera.CameraType = Enum.CameraType.Scriptable
    Camera.CFrame = AppState.CamPart.CFrame * CFrame.Angles(0, AppState.CamYaw, 0) * CFrame.Angles(AppState.CamPitch, 0, 0)

    if not UserInputService.TouchEnabled then
        UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
    end

    ManageScreenEffect(true)
    PlaySound(AppState.EnterSoundId, AppState.CamPart)

    AppState.RotateConnection = UserInputService.InputChanged:Connect(function(input, gpe)
        if not AppState.InFreecam then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            UpdateCamRotation(input.Delta.X, input.Delta.Y)
        elseif input.UserInputType == Enum.UserInputType.Touch and not gpe then
            UpdateCamRotation(input.Delta.X, input.Delta.Y)
        end
    end)

    AppState.MoveConnection = RunService.RenderStepped:Connect(function(dt)
        if os.clock() >= AppState.FreecamEndTick then
            EndFreecam()
            return
        end
        AppState.CamPart.CFrame = CFrame.new(AppState.CamPart.Position) * CFrame.Angles(0, AppState.CamYaw, 0) * CFrame.Angles(AppState.CamPitch, 0, 0)
        if AppState.Humanoid and AppState.Hrp then
            AppState.Humanoid:Move(Vector3.zero, false)
            AppState.Humanoid.Jump = false
        end

        AppState.MoveVector = AppState.ControlModule and AppState.ControlModule:GetMoveVector() or Vector3.new()
        if AppState.MoveVector.Magnitude > 0.01 then
            AppState.MoveDir = (AppState.CamPart.CFrame.LookVector * -AppState.MoveVector.Z) + (AppState.CamPart.CFrame.RightVector * AppState.MoveVector.X)
            if AppState.MoveDir.Magnitude > 0 then
                AppState.CamPart.CFrame = AppState.CamPart.CFrame + (AppState.MoveDir.Unit * PortalConfig.CamSpeed * dt)
            end
        end
        Camera.CFrame = AppState.CamPart.CFrame
    end)
    return true
end

function EndFreecam()
    if not AppState.InFreecam then return end
    AppState.InFreecam = false

    DisconnectConn("MoveConnection")
    DisconnectConn("RotateConnection")
    UserInputService.MouseBehavior = Enum.MouseBehavior.Default

    ManageScreenEffect(false)

    AppState.Hrp = GetHRP()
    if AppState.Hrp and AppState.CamPart then
        AppState.SafePos = AppState.CamPart.Position
        AppState.Hrp.CFrame = CFrame.new(AppState.SafePos) * (AppState.OriginalCharacterCFrame - AppState.OriginalCharacterCFrame.Position)

        if AppState.Humanoid then
            UnfreezeCharacter(AppState.Humanoid, AppState.Hrp)
        end

        AppState.ExitCooldown = os.clock() + 1.5
        BuildPortal(GetPortalCFrame(AppState.Hrp, 5, -1))
    end

    if AppState.CamPart then AppState.CamPart:Destroy() AppState.CamPart = nil end
    Camera.CameraType = Enum.CameraType.Custom
    if localPlayer.Character then
        Camera.CameraSubject = localPlayer.Character:FindFirstChild("Humanoid")
    end
end
function TweenDecals(duration, style, direction, transparency)
    for _, decal in pairs(AppState.PortalDecals) do
        CreateTween(decal, duration, style, direction, {Transparency = transparency})
    end
end

function ClosePortal()
    if not AppState.CurrentPortal or not AppState.CurrentPortal.Parent then return end
    AppState.ClosingPortal = AppState.CurrentPortal
    AppState.CurrentPortal = nil

    PlaySound(AppState.EndSoundId, AppState.ClosingPortal)

    DisconnectConn("PortalSpin")
    if AppState.PortalLight then CreateTween(AppState.PortalLight, 0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In, {Range = 0, Brightness = 0}) end

    TweenDecals(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 1)
    CreateTween(AppState.ClosingPortal, 0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In, {Size = Vector3.new(0.3, 0.1, 0.1)})
    Debris:AddItem(AppState.ClosingPortal, 0.55)
end

function BuildPortal(portalCFrame)
    DisconnectConn("PortalSpin")
    DisconnectConn("PortalConnection")
    if AppState.CurrentPortal then AppState.CurrentPortal:Destroy() AppState.CurrentPortal = nil end

    AppState.CurrentPortal = Instance.new("Part")
    AppState.CurrentPortal.Name = "portalrickprime"
    AppState.CurrentPortal.Anchored = true
    AppState.CurrentPortal.CanCollide = false
    AppState.CurrentPortal.Material = Enum.Material.Neon
    AppState.CurrentPortal.Color = Color3.fromRGB(255, 221, 51)
    AppState.CurrentPortal.Shape = Enum.PartType.Cylinder
    AppState.CurrentPortal.Size = Vector3.new(0.3, 0.1, 0.1)
    AppState.CurrentPortal.CFrame = portalCFrame
    AppState.CurrentPortal.Transparency = 1
    AppState.CurrentPortal.Parent = Workspace

    PlaySound(AppState.OpenSoundId, AppState.CurrentPortal)
    table.clear(AppState.PortalDecals)

    for _, face in pairs({Enum.NormalId.Left, Enum.NormalId.Right}) do
        AppState.PortalDecals[face.Name] = Instance.new("Decal")
        AppState.PortalDecals[face.Name].Texture = PortalConfig.PortalImage
        AppState.PortalDecals[face.Name].Face = face
        AppState.PortalDecals[face.Name].Transparency = 1
        AppState.PortalDecals[face.Name].Parent = AppState.CurrentPortal
    end

    AppState.PortalLight = Instance.new("PointLight")
    AppState.PortalLight.Color = Color3.fromRGB(80, 255, 120)
    AppState.PortalLight.Range = 0
    AppState.PortalLight.Brightness = 0
    AppState.PortalLight.Parent = AppState.CurrentPortal
    AppState.PortalAngle = 0

    AppState.PortalSpin = RunService.Heartbeat:Connect(function(dt)
        if AppState.CurrentPortal and AppState.CurrentPortal.Parent then
            AppState.PortalAngle = AppState.PortalAngle - (80 * dt)
            AppState.CurrentPortal.CFrame = portalCFrame * CFrame.Angles(math.rad(AppState.PortalAngle), 0, 0)
        end
    end)

    CreateTween(AppState.PortalLight, 0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, {Range = 10, Brightness = 1.2})
    TweenDecals(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0)

    task.spawn(function()
        AppState.StepTween = CreateTween(AppState.CurrentPortal, 0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, {Size = Vector3.new(0.3, 10, 0.2)})
        if AppState.StepTween then AppState.StepTween.Completed:Wait() end
        if AppState.CurrentPortal then CreateTween(AppState.CurrentPortal, 0.9, Enum.EasingStyle.Back, Enum.EasingDirection.Out, {Size = Vector3.new(0.3, 10, 8)}) end
    end)

    AppState.PortalDespawnTick = os.clock() + PortalConfig.PortalLifetime
    AppState.PortalConnection = RunService.Heartbeat:Connect(function()
        if not AppState.CurrentPortal or not AppState.CurrentPortal.Parent then return end
        if os.clock() >= AppState.PortalDespawnTick then
            DisconnectConn("PortalConnection")
            ClosePortal()
            return
        end
        AppState.Hrp = GetHRP()
        if AppState.Hrp
            and not AppState.InFreecam
            and os.clock() > AppState.ExitCooldown
            and (AppState.Hrp.Position - AppState.CurrentPortal.Position).Magnitude < 4 then

            if StartFreecam() then
                DisconnectConn("PortalConnection")
                ClosePortal()
            end
        end
    end)
end

function HandlePortalAction()
    if AppState.InFreecam then
        EndFreecam()
        return
    end
    AppState.Hrp = GetHRP()
    if not AppState.Hrp or AppState.IsSpawning then return end

    AppState.IsSpawning = true
    BuildPortal(GetPortalCFrame(AppState.Hrp, 6, 1))
    task.wait(1)
    AppState.IsSpawning = false
end

