App.ScanFolderForTarget = function(folder)
	for _, charModel in ipairs(folder:GetChildren()) do
		if charModel ~= playerCharacter then
			App.State.TargetRoot = App.GetRoot(charModel)
			App.State.TargetHum = charModel:FindFirstChildOfClass("Humanoid")
			if App.State.TargetRoot and App.State.TargetHum and App.State.TargetHum.Health > 0 then
				App.State.TargetDist = (App.State.TargetRoot.Position - App.State.PRootNearest.Position).Magnitude
				if App.State.TargetDist < App.State.MinDist then 
					App.State.MinDist = App.State.TargetDist
					App.State.NearestTarget = App.State.TargetRoot 
				end
			end
		end
	end
end

App.GetNearestTarget = function()
	App.State.PRootNearest = App.GetRoot(playerCharacter)
	if not App.State.PRootNearest then return nil end
	
	App.State.NearestTarget, App.State.MinDist = nil, math.huge
	
	if App.State.ActiveTargets.Killers then App.ScanFolderForTarget(killersFolder) end
	if App.State.ActiveTargets.Survivors then App.ScanFolderForTarget(survivorsFolder) end
	
	return App.State.NearestTarget
