task.spawn(function()
    while task.wait(0.2) do
        local puzzle = PuzzleBot.Funcs.GetPuzzle()

        if puzzle ~= PuzzleBot.State.LastPuzzle then
            PuzzleBot.Funcs.ClearWatchers()
            PuzzleBot.State.LastPuzzle = puzzle
        end

        if not puzzle then
            PuzzleBot.State.IsSolving = false
            continue
        end

        if PuzzleBot.Config.ShowPath and #PuzzleBot.State.Watchers == 0 then
            PuzzleBot.Funcs.ApplyESP(puzzle)
        end

        if PuzzleBot.Config.AutoSolve and not PuzzleBot.State.IsSolving and not puzzle.gameEnded then
            PuzzleBot.State.IsSolving = true
            task.spawn(function()
                PuzzleBot.Funcs.SolvePuzzle(puzzle)
            end)
        end
    end
end)

