function SkillController.UpdateSteering(Delta)
    if not SkillController.CurrentHRP or not SkillController.CurrentHRP.Parent or not SkillController.CurrentHumanoid or not SkillController.CurrentHumanoid.Parent then
        SkillController.Clear()
        return
    end
    
    if SkillController.ActiveMode == "Walkspeed" and (not SkillController.TrackedLV or not SkillController.TrackedLV.Parent or SkillController.CurrentHRP.Parent:FindFirstChild("Result")) then
        SkillController.Clear()
        return
    end
    
    if SkillController.ActiveMode == "Walkspeed" and SkillController.TrackedLV.Enabled then
        SkillController.TrackedLV.Enabled = false
    end

    if SkillController.ActiveMode == "Charge" then
        pcall(function()
            RunService:UnbindFromRenderStep("GuestCharging")
        end)
        SkillController.CurrentHumanoid.AutoRotate = false
        SkillController.CurrentHumanoid.WalkSpeed = SkillController.ChargeBuff
    end
    
    SkillController.TargetPart = nil
    SkillController.UsePathfinding = false
    
    if SkillController.ActiveMode == "Walkspeed" and SkillController.WalkspeedAutoAim then
        SkillController.TargetPart = SkillController.GetTarget(CoreData.Config.CorruptNature.Targets)
        SkillController.UsePathfinding = SkillController.WalkspeedPathfinding
    elseif SkillController.ActiveMode == "Voidrush" and SkillController.VoidrushAutoAim then
        SkillController.TargetPart = SkillController.GetTarget(CoreData.Config.Nova.Targets)
        SkillController.UsePathfinding = SkillController.VoidrushPathfinding
    end
    
    if SkillController.ActiveMode == "Charge" or not (SkillController.TargetPart and SkillController.TargetPart:IsA("BasePart")) then
        SkillController.CamLook = Camera.CFrame.LookVector
        SkillController.Direction = Vector3.new(SkillController.CamLook.X, 0, SkillController.CamLook.Z)
    else
        if SkillController.UsePathfinding then
            SkillController.StraightVector = SkillController.TargetPart.Position - SkillController.CurrentHRP.Position
            SkillController.RayParams.FilterType = Enum.RaycastFilterType.Exclude
            SkillController.RayParams.FilterDescendantsInstances = {playerCharacter, SkillController.TargetPart.Parent}
            
            SkillController.RayResult = Workspace:Raycast(SkillController.CurrentHRP.Position, SkillController.StraightVector, SkillController.RayParams)
            
            if not SkillController.RayResult then
                SkillController.CalculateTargetDirection()
            else
                if tick() - SkillController.LastPathTime > 0.2 then
                    SkillController.LastPathTime = tick()
                    SkillController.Path:ComputeAsync(SkillController.CurrentHRP.Position, SkillController.TargetPart.Position)
                    
                    if SkillController.Path.Status == Enum.PathStatus.Success then
                        SkillController.Waypoints = SkillController.Path:GetWaypoints()
                        SkillController.WaypointIndex = 2 
                    end
                end
                
                if SkillController.Waypoints and SkillController.Waypoints[SkillController.WaypointIndex] then
                    SkillController.NextPos = SkillController.Waypoints[SkillController.WaypointIndex].Position

                    if Vector3.new(SkillController.NextPos.X - SkillController.CurrentHRP.Position.X, 0, SkillController.NextPos.Z - SkillController.CurrentHRP.Position.Z).Magnitude < 8 then
                        if SkillController.WaypointIndex < #SkillController.Waypoints then
                            SkillController.WaypointIndex = SkillController.WaypointIndex + 1
                            SkillController.NextPos = SkillController.Waypoints[SkillController.WaypointIndex].Position
                        end
                    end
                    
                    SkillController.Direction = Vector3.new(
                        SkillController.NextPos.X - SkillController.CurrentHRP.Position.X,
                        0,
                        SkillController.NextPos.Z - SkillController.CurrentHRP.Position.Z
                    )
                else
                    SkillController.CalculateTargetDirection()
                end
            end
        else
            SkillController.CalculateTargetDirection()
        end
    end
    
    if SkillController.Direction.Magnitude > 0 then
        SkillController.Direction = SkillController.Direction.Unit
    else
        SkillController.Direction = SkillController.CurrentHRP.CFrame.LookVector
    end
    
    if SkillController.ActiveMode == "Walkspeed" then
        SkillController.CurrentHRP.CFrame = SkillController.CurrentHRP.CFrame:Lerp(CFrame.lookAt(SkillController.CurrentHRP.Position, SkillController.CurrentHRP.Position + SkillController.Direction), Delta * 15)
        SkillController.CurrentTargetSpeed = SkillController.WalkspeedBuff
        SkillController.ForwardVector = SkillController.CurrentHRP.CFrame.LookVector
        SkillController.VelocityY = SkillController.CurrentHRP.AssemblyLinearVelocity.Y
        SkillController.CurrentHRP.AssemblyLinearVelocity = Vector3.new(SkillController.ForwardVector.X * SkillController.CurrentTargetSpeed, SkillController.VelocityY, SkillController.ForwardVector.Z * SkillController.CurrentTargetSpeed)
        
    elseif SkillController.ActiveMode == "Voidrush" then
        SkillController.CurrentHRP.CFrame = CFrame.lookAt(SkillController.CurrentHRP.Position, SkillController.CurrentHRP.Position + SkillController.Direction)
        SkillController.CurrentTargetSpeed = SkillController.VoidrushBuff
        SkillController.ForwardVector = SkillController.CurrentHRP.CFrame.LookVector
        SkillController.VelocityY = SkillController.CurrentHRP.AssemblyLinearVelocity.Y
        SkillController.CurrentHRP.AssemblyLinearVelocity = Vector3.new(SkillController.ForwardVector.X * SkillController.CurrentTargetSpeed, SkillController.VelocityY, SkillController.ForwardVector.Z * SkillController.CurrentTargetSpeed)
        
    elseif SkillController.ActiveMode == "Charge" then
        SkillController.CurrentHRP.CFrame = SkillController.CurrentHRP.CFrame:Lerp(CFrame.lookAt(SkillController.CurrentHRP.Position, SkillController.CurrentHRP.Position + SkillController.Direction), Delta * 20)
        SkillController.CurrentHumanoid:Move(SkillController.Direction)
    end
end

function SkillController.SetupCharacter(Character)
    SkillController.SetupHRP = Character:WaitForChild("HumanoidRootPart", 5)
    SkillController.SetupHumanoid = Character:WaitForChild("Humanoid", 5)
    
    if SkillController.SetupHRP then
        SkillController.SetupHRP.ChildAdded:Connect(function(Child)
            if SkillController.WalkspeedEnabled and Child:IsA("LinearVelocity") and Character:GetAttribute("FootstepsMuted") == true then
                SkillController.Clear()
                SkillController.CurrentHRP = Character:FindFirstChild("HumanoidRootPart")
                SkillController.CurrentHumanoid = Character:FindFirstChild("Humanoid")
                SkillController.TrackedLV = Child
                SkillController.ActiveMode = "Walkspeed"
                SkillController.Loop = RunService.RenderStepped:Connect(SkillController.UpdateSteering)
            end
        end)
    end
    
    Character:GetAttributeChangedSignal("VoidRushState"):Connect(function()
        if not SkillController.VoidrushEnabled then return end
        
        if Character:GetAttribute("VoidRushState") == "Dashing" then
            SkillController.Clear()
            SkillController.CurrentHRP = Character:FindFirstChild("HumanoidRootPart")
            SkillController.CurrentHumanoid = Character:FindFirstChild("Humanoid")
            if SkillController.CurrentHRP and SkillController.CurrentHumanoid then
                SkillController.ActiveMode = "Voidrush"
                SkillController.Loop = RunService.RenderStepped:Connect(SkillController.UpdateSteering)
            end
        elseif SkillController.ActiveMode == "Voidrush" then
            SkillController.Clear()
        end
    end)
end

RunService.RenderStepped:Connect(function()
    if not SkillController.ChargeEnabled or not playerCharacter then
        if SkillController.ActiveMode == "Charge" then
            SkillController.Clear()
        end
        return
    end

    SkillController.SetupMultipliers = playerCharacter:FindFirstChild("SpeedMultipliers")
    if SkillController.SetupMultipliers and SkillController.SetupMultipliers:FindFirstChild("Guest1337Charge") then
        if SkillController.ActiveMode ~= "Charge" then
            SkillController.Clear()
            SkillController.CurrentHRP = playerCharacter:FindFirstChild("HumanoidRootPart")
            SkillController.CurrentHumanoid = playerCharacter:FindFirstChild("Humanoid")
            if SkillController.CurrentHRP and SkillController.CurrentHumanoid then
                SkillController.ActiveMode = "Charge"
                SkillController.Loop = RunService.RenderStepped:Connect(SkillController.UpdateSteering)
            end
        end
    else
        if SkillController.ActiveMode == "Charge" then
            SkillController.Clear()
        end
    end
end)

if playerCharacter then
    SkillController.SetupCharacter(playerCharacter)
end

