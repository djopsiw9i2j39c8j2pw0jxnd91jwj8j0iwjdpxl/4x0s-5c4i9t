function ServerManager:RandomHop()
    local url = "https://games.roblox.com/v1/games/" .. tostring(game.PlaceId) .. "/servers/Public?sortOrder=Asc&limit=100"
    
    local response = nil
    pcall(function()
        response = request({
            Url = url,
            Method = "GET"
        })
    end)
    
    if response and response.StatusCode == 200 then
