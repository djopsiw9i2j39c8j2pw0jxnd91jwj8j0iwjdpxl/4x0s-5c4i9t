function ESP:BuildText(d, dist)
    d.Cache.TextParts = d.Cache.TextParts or {}
    d.Cache.TextParts[1] = d.Settings.ShowName ~= false and d.BaseName or nil
    d.Cache.TextParts[2] = (d.Settings.ShowHP and d.Cache.Humanoid) and string.format("[%d/%d]", math.floor(d.Cache.Humanoid.Health), math.floor(d.Cache.Humanoid.MaxHealth)) or nil
    d.Cache.TextParts[3] = d.Settings.ShowDistance and string.format("[%dm]", math.floor(dist)) or nil

    self.Cache.CleanText = {}
    for i = 1, 3 do
        if d.Cache.TextParts[i] then
            self.Cache.CleanText[#self.Cache.CleanText + 1] = d.Cache.TextParts[i]
        end
    end
    return table.concat(self.Cache.CleanText, " ")
end

function ESP:ClearTargetCache(d)
    d.Cache.Root = nil
    d.Cache.Adornee = nil
    d.Cache.Humanoid = nil
    return false
end

function ESP:GetFallbackPart(obj)
    if obj:IsA("BasePart") then return obj end
    return obj:FindFirstChild("HumanoidRootPart") or 
           obj.PrimaryPart or 
           obj:FindFirstChild("Head") or 
           obj:FindFirstChild("UpperTorso") or 
           obj:FindFirstChild("Torso") or
           obj:FindFirstChildWhichIsA("BasePart", true)
end

function ESP:RefreshTargetCache(d)
    d.Cache = d.Cache or {}

    if not d.IsInstance or not d.Object or not d.Object.Parent then
        return self:ClearTargetCache(d)
    end

    d.Cache.Target = d.Object

    if d.IsPlayer then
        d.Cache.Target = d.Object.Character
        if not d.Cache.Target then
            return self:ClearTargetCache(d)
        end
    end

    if self:IsSelf(d.Cache.Target) then
        return self:ClearTargetCache(d)
    end

    if d.Cache.Target:IsA("Model") then
        if not d.Cache.Root or not d.Cache.Root.Parent or not d.Cache.Root:IsDescendantOf(d.Cache.Target) then
            d.Cache.Root = self:GetFallbackPart(d.Cache.Target)
        end

        if not d.Cache.Humanoid or not d.Cache.Humanoid.Parent or not d.Cache.Humanoid:IsDescendantOf(d.Cache.Target) then
            d.Cache.Humanoid = d.Cache.Target:FindFirstChildOfClass("Humanoid")
        end

        d.Cache.Adornee = d.Cache.Target
    elseif d.Cache.Target:IsA("BasePart") then
        d.Cache.Root = d.Cache.Target
        d.Cache.Adornee = d.Cache.Target
        
        if not d.Cache.Humanoid or not d.Cache.Humanoid.Parent or d.Cache.Humanoid.Parent ~= d.Cache.Target.Parent then
            d.Cache.Humanoid = d.Cache.Target.Parent and d.Cache.Target.Parent:FindFirstChildOfClass("Humanoid") or nil
        end
    else
        return self:ClearTargetCache(d)
    end

    if d.Cache.Humanoid and d.Cache.Humanoid.Health <= 0 then
        return false
    end

    return d.Cache.Root ~= nil
end

function ESP:UpdateTracer(frame, fromPos, toPos, color)
    self.Cache.dX = toPos.X - fromPos.X
    self.Cache.dY = toPos.Y - fromPos.Y
    self.Cache.Length = (toPos - fromPos).Magnitude

    self:SetProp(frame, "Size", UDim2.new(0, self.Cache.Length, 0, 1.5))
    self:SetProp(frame, "Position", UDim2.new(0, (fromPos.X + toPos.X) * 0.5, 0, (fromPos.Y + toPos.Y) * 0.5))
    self:SetProp(frame, "Rotation", math.deg(math.atan2(self.Cache.dY, self.Cache.dX)))
    self:SetProp(frame, "BackgroundColor3", color)
end

function ESP:QueueRemove(id)
    self.PendingRemove[#self.PendingRemove + 1] = id
end

function ESP:FlushRemoveQueue()
    for i = 1, #self.PendingRemove do
        self:Huy(self.PendingRemove[i])
        self.PendingRemove[i] = nil
    end
end

function ESP:ApplyDefaults(settings)
    settings = settings or {}
    for key, value in next, self.Defaults do
        if settings[key] == nil then
            settings[key] = value
        end
    end
    settings.CustomName = settings.CustomName or nil
    return settings
end

function ESP:DangKy(id, obj, settings)
    if not obj or self:IsSelf(obj) then return end
    settings = self:ApplyDefaults(settings)

    if self.Objects[id] then
        self.Objects[id].Object = obj
        self.Objects[id].Settings = settings
        self.Objects[id].BaseName = settings.CustomName or (typeof(obj) == "Instance" and obj.Name or tostring(obj))
        self.Objects[id].IsInstance = typeof(obj) == "Instance"
        self.Objects[id].IsPlayer = self.Objects[id].IsInstance and obj:IsA("Player")
        return
    end

    self.Objects[id] = {
        Object = obj,
        Settings = settings,
        Drawings = nil,
        State = {},
        Cache = {},
        IsActive = true,
        IsInstance = typeof(obj) == "Instance",
        IsPlayer = typeof(obj) == "Instance" and obj:IsA("Player"),
        BaseName = settings.CustomName or (typeof(obj) == "Instance" and obj.Name or tostring(obj)),
        DisplayText = ""
    }
end

function ESP:Huy(id)
    if not self.Objects[id] then return end
    if self.Objects[id].Drawings then
        if self.Objects[id].Drawings.Highlight then self.Objects[id].Drawings.Highlight:Destroy() end
        if self.Objects[id].Drawings.TextBill then self.Objects[id].Drawings.TextBill:Destroy() end
        if self.Objects[id].Drawings.Box then self.Objects[id].Drawings.Box:Destroy() end
        if self.Objects[id].Drawings.Tracer then self.Objects[id].Drawings.Tracer:Destroy() end
    end
    self.Objects[id] = nil
end

function ESP:RemoveAllEsp()
    for id in next, self.Objects do self:Huy(id) end
    if self.Connection then self.Connection:Disconnect() self.Connection = nil end
    if self.PlayerRemovingConn then self.PlayerRemovingConn:Disconnect() self.PlayerRemovingConn = nil end
    if self.ViewSizeConn then self.ViewSizeConn:Disconnect() self.ViewSizeConn = nil end
end

ESP.PlayerRemovingConn = Players.PlayerRemoving:Connect(function(p)
    for id, d in next, ESP.Objects do
        if d.Object == p then ESP:Huy(id) end
    end
end)

ESP.ViewSizeConn = Camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
    ESP.Cache.ViewSize = Camera.ViewportSize
end)

ESP.Connection = RunService.RenderStepped:Connect(function(dt)
    ESP.Cache.Elapsed = ESP.Cache.Elapsed + dt
    ESP.Cache.HeavyUpdate = ESP.Cache.Elapsed >= ESP.Config.UpdateInterval

    if ESP.Cache.HeavyUpdate then ESP.Cache.Elapsed = 0 end

    ESP.Cache.LocalPosition = ESP:GetLocalPosition()
    ESP.Cache.TracerPosition = ESP:GetTracerPos()

    for id, d in next, ESP.Objects do
        if not d.IsActive then
            ESP:SetAllVisible(d.Drawings, false)
            continue
        end

        if d.IsInstance and (not d.Object or not d.Object.Parent) then
            ESP:QueueRemove(id)
            continue
        end

        if ESP:IsSelf(d.Object) then
            ESP:SetAllVisible(d.Drawings, false)
            continue
        end

        if ESP.Cache.HeavyUpdate or not d.Cache.Root then
            ESP:RefreshTargetCache(d)
        end

        if not d.Cache.Root or not d.Cache.Root.Parent then
            ESP:SetAllVisible(d.Drawings, false)
            continue
        end

        if d.Cache.Humanoid and d.Cache.Humanoid.Health <= 0 then
            ESP:SetAllVisible(d.Drawings, false)
            continue
        end

        d.Cache.Position = d.Cache.Root.Position
        d.Cache.Distance = (ESP.Cache.LocalPosition - d.Cache.Position).Magnitude

        if d.Cache.Distance > ESP.Config.MaxDistance then
            ESP:SetAllVisible(d.Drawings, false)
            continue
        end

        ESP:AllocateDrawings(d)
        d.Cache.Color = d.Settings.Color

        if ESP.Cache.HeavyUpdate and d.Settings.UseText then
            d.DisplayText = ESP:BuildText(d, d.Cache.Distance)
        end

        if d.Settings.UseHighlight and d.Drawings.Highlight then
            ESP:SetProp(d.Drawings.Highlight, "Enabled", true)
            ESP:SetProp(d.Drawings.Highlight, "Adornee", d.Cache.Adornee)
            ESP:SetProp(d.Drawings.Highlight, "FillColor", d.Cache.Color)
        elseif d.Drawings and d.Drawings.Highlight then
            ESP:SetProp(d.Drawings.Highlight, "Enabled", false)
        end

        if d.Settings.UseBox and d.Drawings.Box then
            ESP:SetProp(d.Drawings.Box, "Enabled", true)
            ESP:SetProp(d.Drawings.Box, "Adornee", d.Cache.Root)
            ESP:SetProp(d.Drawings.BoxStroke, "Color", d.Cache.Color)
        elseif d.Drawings and d.Drawings.Box then
            ESP:SetProp(d.Drawings.Box, "Enabled", false)
        end

        if d.Settings.UseText and d.Drawings.TextBill then
            ESP:SetProp(d.Drawings.TextBill, "Enabled", true)
            ESP:SetProp(d.Drawings.TextBill, "Adornee", d.Cache.Root)

            if d.Drawings.TextLabel.Text ~= d.DisplayText then
                d.Drawings.TextLabel.Text = d.DisplayText
            end
            ESP:SetProp(d.Drawings.TextLabel, "TextColor3", d.Cache.Color)
        elseif d.Drawings and d.Drawings.TextBill then
            ESP:SetProp(d.Drawings.TextBill, "Enabled", false)
        end

        if d.Settings.UseTracer and d.Drawings.Tracer then
            d.Cache.ScreenPos, d.Cache.OnScreen = Camera:WorldToViewportPoint(d.Cache.Position)

            if d.Cache.OnScreen then
                ESP:SetProp(d.Drawings.Tracer, "Visible", true)
                ESP:UpdateTracer(
                    d.Drawings.Tracer,
                    ESP.Cache.TracerPosition,
                    Vector2.new(d.Cache.ScreenPos.X, d.Cache.ScreenPos.Y),
                    d.Cache.Color
                )
            else
                ESP:SetProp(d.Drawings.Tracer, "Visible", false)
            end
        elseif d.Drawings and d.Drawings.Tracer then
            ESP:SetProp(d.Drawings.Tracer, "Visible", false)
        end
    end

    ESP:FlushRemoveQueue()
end)

Farm = {
    AutoKillerFarm = false,
    AutoFarmGen = false,
    SafeModeGen = true,
    SafeRangeGen = 45,
    Target = nil,
    LastPos = nil,
    CurrentGen = nil,
    CurrentMap = nil,
    LoadTime = 0,
    IsHolding = false
}

Farm.GetEntity = function(char)
    if not char then return nil, false end
    return char:FindFirstChild("HumanoidRootPart"), (char:FindFirstChildWhichIsA("Humanoid") and char:FindFirstChildWhichIsA("Humanoid").Health > 0)
end

Farm.IsKillerNear = function(pos)
    if not Farm.SafeModeGen then return false end
    for _, k in pairs(killersFolder:GetChildren()) do
        Farm.TempHrp, Farm.TempAlive = Farm.GetEntity(k)
        if Farm.TempHrp and Farm.TempAlive and (Farm.TempHrp.Position - pos).Magnitude <= Farm.SafeRangeGen then
            return true
        end
    end
    return false
end

Farm.IsOccupied = function(pos, me)
    for _, s in pairs(survivorsFolder:GetChildren()) do
        if s ~= me then
            Farm.TempHrp, Farm.TempAlive = Farm.GetEntity(s)
            if Farm.TempHrp and Farm.TempAlive and (Farm.TempHrp.Position - pos).Magnitude < 2.5 then
                return true
            end
        end
    end
    return false
end

Farm.FindSurvivor = function(hrp, me, exclude)
    Farm.BestTarget = nil
    Farm.MinDist = math.huge
    for _, s in pairs(survivorsFolder:GetChildren()) do
        if s ~= me then
            Farm.TempHrp, Farm.TempAlive = Farm.GetEntity(s)
            if Farm.TempHrp and Farm.TempAlive and Farm.TempHrp ~= exclude then
                Farm.CurrentDist = (Farm.TempHrp.Position - hrp.Position).Magnitude
                if Farm.CurrentDist < Farm.MinDist then
                    Farm.MinDist = Farm.CurrentDist
                    Farm.BestTarget = Farm.TempHrp
                end
            end
        end
    end
    return Farm.BestTarget
end

Farm.ChangeTarget = function()
    Farm.TempHrp = Farm.GetEntity(localPlayer.Character)
    if not Farm.TempHrp then return end

    Farm.NewTarget = Farm.FindSurvivor(Farm.TempHrp, localPlayer.Character, Farm.Target)

    if not Farm.NewTarget and Farm.Target and Farm.Target.Parent and Farm.Target:IsDescendantOf(survivorsFolder) and select(2, Farm.GetEntity(Farm.Target.Parent)) then
        return
    end
    Farm.Target = Farm.NewTarget or Farm.FindSurvivor(Farm.TempHrp, localPlayer.Character)
end

Farm.ProcKiller = function()
    Farm.TempHrp, Farm.TempAlive = Farm.GetEntity(localPlayer.Character)

    if not (localPlayer.Character and localPlayer.Character:IsDescendantOf(killersFolder) and Farm.TempAlive) then
        Farm.Target = nil
        return
    end

    if not (Farm.Target and Farm.Target.Parent and Farm.Target:IsDescendantOf(survivorsFolder) and select(2, Farm.GetEntity(Farm.Target.Parent))) then
        Farm.Target = Farm.FindSurvivor(Farm.TempHrp, localPlayer.Character)
    end

    if Farm.Target then
        Farm.TempHrp.CFrame = CFrame.lookAt((Farm.Target.CFrame * CFrame.new(0, 0, 3)).Position, Farm.Target.Position)
    end
end

Farm.FindSafeGen = function()
    if TargetMapFolder and TargetMapFolder ~= Farm.CurrentMap then
        Farm.CurrentMap = TargetMapFolder
        Farm.LoadTime = tick()
    end
    
    if not TargetMapFolder then return end

    for _, gen in pairs(TargetMapFolder:GetChildren()) do
        if gen.Name == "Generator" and gen:FindFirstChild("Progress") and gen.Progress.Value < 100 then
            Farm.GenPart = gen.PrimaryPart or gen:FindFirstChildWhichIsA("BasePart")
            if Farm.GenPart and not Farm.IsKillerNear(Farm.GenPart.Position) then
                return gen, Farm.GenPart
            end
        end
    end
end

Farm.GetSafePos = function(part, me)
    Farm.Positions = {
        part.CFrame * CFrame.new(0, 0, -6),
        part.CFrame * CFrame.new(6, 0, 0),
        part.CFrame * CFrame.new(-6, 0, 0)
    }
    for _, posCF in pairs(Farm.Positions) do
        if not Farm.IsOccupied(posCF.Position, me) and not Farm.IsKillerNear(posCF.Position) then
            return CFrame.lookAt(posCF.Position, part.Position)
        end
    end
end

Farm.HandlePrompt = function(gen)
    Farm.Prompt = gen:FindFirstChild("Main") and gen.Main:FindFirstChild("Prompt")
    if Farm.Prompt and Farm.Prompt:IsA("ProximityPrompt") and (tick() - Farm.LoadTime) >= 3 and not Farm.IsHolding then
        Farm.IsHolding = true
        task.spawn(function()
            pcall(function()
                Farm.Prompt.HoldDuration = 0.125
                Farm.Prompt:InputHoldBegin()
                task.wait(0.125)
                if Farm.Prompt.Parent then Farm.Prompt:InputHoldEnd() end
            end)
            Farm.IsHolding = false
        end)
    end
end

Farm.ProcGen = function()
    if Farm.IsHolding then return end
    
    Farm.TempHrp, Farm.TempAlive = Farm.GetEntity(localPlayer.Character)
    
    if not (localPlayer.Character and localPlayer.Character:IsDescendantOf(survivorsFolder) and Farm.TempAlive and Farm.TempHrp) then 
        Farm.LastPos = nil
        Farm.CurrentGen = nil
        return 
    end

    Farm.FoundGen, Farm.GenPart = Farm.FindSafeGen()
    if not Farm.FoundGen then return end

    Farm.IsValid = Farm.LastPos and (Farm.TempHrp.Position - Farm.LastPos.Position).Magnitude < 3 and not Farm.IsOccupied(Farm.LastPos.Position, localPlayer.Character)

    if not Farm.IsValid or Farm.CurrentGen ~= Farm.FoundGen then
        Farm.NewPos = Farm.GetSafePos(Farm.GenPart, localPlayer.Character)
        if Farm.NewPos then
            Farm.LastPos = Farm.NewPos
            Farm.CurrentGen = Farm.FoundGen
            Farm.TempHrp.CFrame = Farm.NewPos
        end
    end

    Farm.HandlePrompt(Farm.FoundGen)
end

