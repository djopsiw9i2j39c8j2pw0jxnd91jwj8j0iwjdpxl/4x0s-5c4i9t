    self:Tween(self.UI.Stroke, {Color = state and Color3.fromRGB(255, 75, 75) or Color3.fromRGB(60, 60, 60)}, 0.3)
end

function CamlockBot:UpdateUISize()
    local s = self.Config.UIScale
    local size = UDim2.new(0, 130 * s, 0, 45 * s)
    if self.UI.Frame then
        self:Tween(self.UI.Frame, {Size = size}, 0.2)
        if self.UI.Button then self.UI.Button.TextSize = 14 * s end
    end
    if self.UI.SwitchFrame then
        self:Tween(self.UI.SwitchFrame, {Size = size}, 0.2)
        if self.UI.SwitchButton then self.UI.SwitchButton.TextSize = 14 * s end
    end
end

local function MakeDraggableAndClickable(frame, button, onClick)
    local dragInput, dragging, startPos, dragStart, dragDist = nil, false, nil, nil, 0
    
    button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging, dragInput, dragStart, startPos, dragDist = true, input, input.Position, frame.Position, 0
            CamlockBot:Tween(frame, {Size = UDim2.new(0, (130 - 10) * CamlockBot.Config.UIScale, 0, (45 - 5) * CamlockBot.Config.UIScale)}, 0.1)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            dragDist = delta.Magnitude
            if dragDist > 5 then frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y) end
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input == dragInput then
            dragging, dragInput = false, nil
            CamlockBot:Tween(frame, {Size = UDim2.new(0, 130 * CamlockBot.Config.UIScale, 0, 45 * CamlockBot.Config.UIScale)}, 0.15)
            if dragDist < 10 and onClick then onClick() end
        end
    end)
end

