StatusLogic.FormatName = function(self, value)
    self.CustomName = (tostring(value) == "" or tostring(value) == "nil") and "None" or tostring(value)
end

StatusLogic.FormatClock = function(self, seconds)
    self.Cache.Days = math.floor(seconds / 86400)
    self.Cache.Hours = math.floor((seconds % 86400) / 3600)
    self.Cache.Mins = math.floor((seconds % 3600) / 60)
    self.Cache.Secs = seconds % 60

    if self.Cache.Days > 0 then
        return string.format("%d:%02d:%02d:%02d", self.Cache.Days, self.Cache.Hours, self.Cache.Mins, self.Cache.Secs)
    else
        return string.format("%02d:%02d:%02d", self.Cache.Hours, self.Cache.Mins, self.Cache.Secs)
    end
end

StatusLogic.ParseNumber = function(self, text)
    return tonumber(string.match(text, "%d+")) or 0
end

StatusLogic.ParseClockToSeconds = function(self, text)
    self.Cache.d, self.Cache.h, self.Cache.m, self.Cache.s = string.match(text, "(%d+):(%d+):(%d+):(%d+)")
    if self.Cache.d then
        return (tonumber(self.Cache.d) * 86400) + (tonumber(self.Cache.h) * 3600) + (tonumber(self.Cache.m) * 60) + tonumber(self.Cache.s)
    end

    self.Cache.h, self.Cache.m, self.Cache.s = string.match(text, "(%d+):(%d+):(%d+)")
    if self.Cache.h then
        return (tonumber(self.Cache.h) * 3600) + (tonumber(self.Cache.m) * 60) + tonumber(self.Cache.s)
    end

    self.Cache.m, self.Cache.s = string.match(text, "(%d+):(%d+)")
    if self.Cache.m then
        return (tonumber(self.Cache.m) * 60) + tonumber(self.Cache.s)
    end

    return self:ParseNumber(text)
end

