function StaminaBot.Funcs.ApplyStats()
    if not StaminaBot.Funcs.LoadModule() then return end
    local cfg = StaminaBot.Config

    if cfg.Max.Enabled then StaminaBot.Funcs.SafeSet("MaxStamina", "maxStamina", cfg.Max.Value) end
    if cfg.Regen.Enabled then StaminaBot.Funcs.SafeSet("StaminaGain", "staminaGain", cfg.Regen.Value) end
    if cfg.Drain.Enabled then StaminaBot.Funcs.SafeSet("StaminaLoss", "staminaLoss", cfg.Drain.Value) end
    if cfg.Speed.Enabled then StaminaBot.Funcs.SafeSet("SprintSpeed", "sprintSpeed", cfg.Speed.Value) end

    local current = StaminaBot.Funcs.GetCurrent()
    local maxValue = cfg.Max.Enabled and cfg.Max.Value or StaminaBot.Originals.Max

    if cfg.Max.Enabled then
        if current > maxValue then
            StaminaBot.Funcs.SetStamina(maxValue)
        elseif current <= StaminaBot.Originals.Max and tick() - StaminaBot.State.LastForce >= StaminaBot.State.ForceDelay then
            StaminaBot.State.LastForce = tick()
            StaminaBot.Funcs.SetStamina(math.clamp(current, 0, maxValue))
        end
    end

    if cfg.InfStamina and current < maxValue then
        StaminaBot.Funcs.SetStamina(maxValue)
    end
end

