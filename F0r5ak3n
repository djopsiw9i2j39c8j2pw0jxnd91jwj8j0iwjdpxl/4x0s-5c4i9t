function StaminaBot.Funcs.SafeSet(propUpper, propLower, value)
    local mod = StaminaBot.State.Module
    if not mod then return end
    pcall(function() mod[propUpper] = value end)
    pcall(function() mod[propLower] = value end)
end

function StaminaBot.Funcs.LoadModule()
    if StaminaBot.State.Module then return true end

    local success, mod = pcall(require, StaminaBot.State.ModulePath)
    if success and mod then
        StaminaBot.State.Module = mod
        
        StaminaBot.Originals.Max = tonumber(mod.MaxStamina) or tonumber(mod.maxStamina) or 100
        StaminaBot.Originals.Regen = tonumber(mod.StaminaGain) or tonumber(mod.staminaGain) or 20
        StaminaBot.Originals.Drain = tonumber(mod.StaminaLoss) or tonumber(mod.staminaLoss) or 10
        StaminaBot.Originals.Speed = tonumber(mod.SprintSpeed) or tonumber(mod.sprintSpeed) or 25
        return true
    end
    return false
end

function StaminaBot.Funcs.SetStamina(val)
    local mod = StaminaBot.State.Module
    if not mod then return end
    val = tonumber(val) or 0

    pcall(function()
        if type(mod.SetStamina) == "function" then mod:SetStamina(val)
        elseif type(mod.UpdateStamina) == "function" then mod:UpdateStamina(val)
        elseif type(mod.ChangeStamina) == "function" then mod:ChangeStamina(val)
        else mod.Stamina = val end
    end)
    pcall(function() mod.Stamina = val end)
end

function StaminaBot.Funcs.GetCurrent()
    local mod = StaminaBot.State.Module
    return mod and (tonumber(mod.Stamina) or 0) or 0
