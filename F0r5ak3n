getgenv().AntiFakeState = getgenv().AntiFakeState or {
    Killers = false,
    Pizza = false,
    Dispenser = false,
    Protect = false
}

getgenv().AntiFakeLoopRunning = getgenv().AntiFakeLoopRunning or false

local function UpdateAntiFakeLoop()
    if getgenv().AntiFakeLoopRunning then return end

    local hasActiveToggle = false
    for _, state in pairs(getgenv().AntiFakeState) do
        if state then hasActiveToggle = true; break end
    end
    
    if not hasActiveToggle then return end

    getgenv().AntiFakeLoopRunning = true

    task.spawn(function()
        while getgenv().AntiFakeLoopRunning do
            task.wait(0.2)
            
            local keepRunning = false
            for _, state in pairs(getgenv().AntiFakeState) do
                if state then keepRunning = true; break end
            end

            if not keepRunning then
                getgenv().AntiFakeLoopRunning = false
                break
            end

            if getgenv().AntiFakeState.Killers then
                if killersFolder then
                    for _, killer in ipairs(killersFolder:GetChildren()) do
                        if killer:GetAttribute("Undetectable") == true then
                            killer:Destroy()
                        end
                    end
                end
                
                local hitboxesFolder = Workspace:FindFirstChild("Hitboxes")
                if hitboxesFolder then
                    for _, hb in ipairs(hitboxesFolder:GetChildren()) do
                        if hb.Name == "SIKE&Hitbox" or hb.Name == "SIKEHitbox" then
                            hb:Destroy()
                        end
                    end
                end
                
                for _, sound in ipairs(SoundService:GetDescendants()) do
                    if sound:IsA("Sound") and string.find(sound.Name, "FakeLayer") then
                        sound:Stop()
                        sound:Destroy()
                    end
                end
            end

            if getgenv().AntiFakeState.Pizza or getgenv().AntiFakeState.Dispenser or getgenv().AntiFakeState.Protect then
                if IngameFolder then
                    for _, item in ipairs(IngameFolder:GetChildren()) do
                        if getgenv().AntiFakeState.Pizza and item.Name == "Pizza" and not item:FindFirstChild("PizzaJoint") then
                            item:Destroy()
                        
                        elseif getgenv().AntiFakeState.Dispenser and string.find(item.Name, "Dispenser") then
                            item:Destroy()
                            
                        elseif getgenv().AntiFakeState.Protect and item.Name == "TheEvilNoliOOOOO" then
                            item:Destroy()
                        end
                    end
                end
            end

            if getgenv().AntiFakeState.Protect then
                for _, effect in ipairs(Lighting:GetChildren()) do
                    if effect:IsA("BlurEffect") and effect.Size >= 34 then
                        effect:Destroy()
                    end
                end
            end
        end
    end)
end

