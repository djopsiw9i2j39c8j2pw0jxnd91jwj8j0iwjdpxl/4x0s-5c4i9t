InvisData.Logic.Check007Eligibility = function()
    return (playerCharacter and playerCharacter.Name == "007n7") and true or false
end

InvisData.Logic.GetAnimator = function()
    if not playerCharacter then return nil end
    InvisData.Cache.Hum = playerCharacter:FindFirstChildOfClass("Humanoid")
    return InvisData.Cache.Hum and InvisData.Cache.Hum:FindFirstChildOfClass("Animator")
end

InvisData.Logic.StopAnim = function()
    if InvisData.State.AnimTrack then
        InvisData.State.AnimTrack:Stop(0.1)
        InvisData.State.AnimTrack = nil
    end
    InvisData.State.IsPlaying = false
end

InvisData.Logic.PlayAnim = function()
    if InvisData.State.IsPlaying then return end
    InvisData.Cache.Animator = InvisData.Logic.GetAnimator()
    if not InvisData.Cache.Animator then return end
    
    InvisData.Cache.Anim = Instance.new("Animation")
    InvisData.Cache.Anim.AnimationId = InvisData.State.AnimId
    
    InvisData.State.AnimTrack = InvisData.Cache.Animator:LoadAnimation(InvisData.Cache.Anim)
    InvisData.State.AnimTrack.Priority = Enum.AnimationPriority.Action4
    InvisData.State.AnimTrack:Play(0.1)
    InvisData.State.AnimTrack:AdjustSpeed(0)
    InvisData.State.IsPlaying = true
end

InvisData.Logic.UpdateAnim = function()
    InvisData.Cache.IsSkillValid = InvisData.Config.SkillAnim and InvisData.State.IsTransparent and InvisData.Logic.Check007Eligibility()
    InvisData.Cache.ShouldPlay = InvisData.Config.InstantAnim or InvisData.Cache.IsSkillValid
    
    if InvisData.Cache.ShouldPlay then
        InvisData.Logic.PlayAnim()
    else
        InvisData.Logic.StopAnim()
    end
end

InvisData.Logic.CheckTransparency = function()
    if not playerCharacter then return false end
    InvisData.Cache.Head = playerCharacter:FindFirstChild("Head")
    return (InvisData.Cache.Head and InvisData.Cache.Head.Transparency > 0.3) or false
end

InvisData.Logic.HookCursorMouse = function()
    if InvisData.Hooks.IsMouseHooked then return end
    
    InvisData.Cache.CurrentMod = ReplicatedStorage
    InvisData.Cache.ModulePath = {"Systems", "Player", "Miscellaneous", "GetPlayerMousePosition"}
    
    for _, path in ipairs(InvisData.Cache.ModulePath) do
        InvisData.Cache.CurrentMod = InvisData.Cache.CurrentMod and InvisData.Cache.CurrentMod:FindFirstChild(path)
    end
    
    if not InvisData.Cache.CurrentMod then return end
    InvisData.Cache.ReqMod = require(InvisData.Cache.CurrentMod)
    
    if type(InvisData.Cache.ReqMod) ~= "table" or not InvisData.Cache.ReqMod.GetMousePos then return end
    
    InvisData.Hooks.IsMouseHooked = true
    InvisData.Hooks.OldGetMousePos = hookfunction(InvisData.Cache.ReqMod.GetMousePos, function(self, ...)
        if InvisData.Config.CloneToKiller and InvisData.State.IsTransparent and InvisData.Logic.Check007Eligibility() then
            if CoreData and CoreData.State and CoreData.State.Targets and CoreData.State.Targets.Killers then
                return CoreData.State.Targets.Killers.Position
            end
        end
        return InvisData.Hooks.OldGetMousePos(self, ...)
    end)
end

