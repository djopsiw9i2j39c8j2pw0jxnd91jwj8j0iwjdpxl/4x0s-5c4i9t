App.TriggerCounter = function(actionObj)
	if App.State.IsAimlocking or not App.State.Flags.AutoCounter then return end

	App.State.CounterTarget = App.GetNearestTarget()
	if not App.State.CounterTarget then return end

	App.State.CounterModel = App.State.CounterTarget.Parent
	App.State.CounterHum = App.State.CounterModel and App.State.CounterModel:FindFirstChildOfClass("Humanoid")

	if not App.State.CounterHum or App.State.CounterHum.Health <= 0 then
		App.State.CounterTarget = nil
		App.State.CounterModel = nil
		App.State.CounterHum = nil
		return
	end

	App.State.IsAimlocking = true
	App.State.LockedTarget = App.State.CounterTarget
	App.State.ActiveAction = actionObj
	App.State.LockEndTime = os.clock() + App.Config.Counter.AimMaxDuration

	App.UnequipCurrentItem(playerCharacter)

	if typeof(AbilityEvent) ~= "nil" then
		AbilityEvent:Use("Punch")
	end
end

App.CheckActionPlaying = function()
	return os.clock() < App.State.LockEndTime
end

App.SetShiftLock = function(forceState)
	App.State.SL = App.State.ShiftLockModule
	if not App.State.SL or type(App.State.SL.IsEnabled) ~= "function" then return end

	if forceState then
		if App.State.ShiftLockForced then return end
		if not App.State.SL:IsEnabled() then
			App.State.WasShiftLockForced = true
			App.State.SL:ToggleShiftLock(true)
		end
		App.State.ShiftLockForced = true
	elseif App.State.ShiftLockForced then
		if App.State.WasShiftLockForced and App.State.SL:IsEnabled() then
			App.State.SL:ToggleShiftLock(false)
		end
		App.State.ShiftLockForced = false
		App.State.WasShiftLockForced = false
	end
end

App.UpdateCameraAimBypass = function()
	if not App.State.IsAimlocking then return end

	if os.clock() >= App.State.LockEndTime then
		App.SetShiftLock(false)

		App.State.IsAimlocking = false
		App.State.LockedTarget = nil
		App.State.ActiveAction = nil
		App.State.CounterTarget = nil
		App.State.CounterModel = nil
		App.State.CounterHum = nil
		return
	end

	App.State.AimTargetRoot = App.State.LockedTarget
	App.State.TargetHum = App.State.CounterHum

	if not App.State.AimTargetRoot
		or not App.State.AimTargetRoot.Parent
		or not App.State.TargetHum
		or App.State.TargetHum.Health <= 0 then

		App.SetShiftLock(false)

		App.State.IsAimlocking = false
		App.State.LockedTarget = nil
		App.State.ActiveAction = nil
		App.State.CounterTarget = nil
		App.State.CounterModel = nil
		App.State.CounterHum = nil
		return
	end

	App.SetShiftLock(true)

	App.State.MyCamRoot = App.GetRoot(playerCharacter)
	if not App.State.MyCamRoot then return end

	App.State.CharPos = App.State.MyCamRoot.Position + Vector3.new(0, 1.5, 0)
	App.State.LookDir = App.State.AimTargetRoot.Position - App.State.CharPos

	if App.State.LookDir.Magnitude < 0.001 then return end

	App.State.LookDir = App.State.LookDir.Unit
	App.State.CamDist = math.clamp(
		(Camera.CFrame.Position - App.State.CharPos).Magnitude,
		2,
		15
	)

	Camera.CFrame = CFrame.new(
		App.State.CharPos - App.State.LookDir * App.State.CamDist,
		App.State.AimTargetRoot.Position
	)
end

