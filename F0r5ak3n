PuzzleBot = {
    Config = {
        AutoSolve = false,
        ShowPath = false,
        SolveSpeed = 0.07,
        HideGUI = false
    },
    State = {
        Watchers = {},
        ActivePuzzle = nil,
        LastPuzzle = nil,
        IsSolving = false
    },
    Vars = {},
    Funcs = {}
}

PuzzleBot.Funcs.IsNeighbor = function(node1, node2)
    return math.abs(node1.row - node2.row) + math.abs(node1.col - node2.col) == 1
end

PuzzleBot.Funcs.GetPuzzle = function()
    if PuzzleBot.State.ActivePuzzle and not PuzzleBot.State.ActivePuzzle.gameEnded and PuzzleBot.State.ActivePuzzle.gridFrame and PuzzleBot.State.ActivePuzzle.gridFrame:IsDescendantOf(game) then
        return PuzzleBot.State.ActivePuzzle
    end

    for _, obj in pairs(getgc(true)) do
        if type(obj) == "table" and rawget(obj, "targetPairs") and rawget(obj, "Solution") and rawget(obj, "gridFrame") then
            if not obj.gameEnded and obj.gridFrame:IsDescendantOf(game) then
                PuzzleBot.State.ActivePuzzle = obj
                return obj
            end
        end
    end
    
    PuzzleBot.State.ActivePuzzle = nil
    return nil
end

PuzzleBot.Funcs.ClearWatchers = function()
    for _, conn in pairs(PuzzleBot.State.Watchers) do
        if conn.Disconnect then conn:Disconnect() end
    end
    table.clear(PuzzleBot.State.Watchers)
end

PuzzleBot.Funcs.UpdateVisibility = function(puzzleTarget)
    if puzzleTarget and puzzleTarget.containerFrame then
        puzzleTarget.containerFrame.Visible = not PuzzleBot.Config.HideGUI
    end
end

PuzzleBot.Funcs.GetOrderedPath = function(rawSolPath)
    if not rawSolPath or #rawSolPath <= 1 then return rawSolPath end
    
    PuzzleBot.Vars.Pool = {}
    for _, node in ipairs(rawSolPath) do
        table.insert(PuzzleBot.Vars.Pool, {row = node.row, col = node.col})
    end
    
    PuzzleBot.Vars.StartIndex = 1
    for i, node in ipairs(PuzzleBot.Vars.Pool) do
        PuzzleBot.Vars.Neighbors = 0
        for j, other in ipairs(PuzzleBot.Vars.Pool) do
            if i ~= j and PuzzleBot.Funcs.IsNeighbor(node, other) then
                PuzzleBot.Vars.Neighbors = PuzzleBot.Vars.Neighbors + 1
            end
        end
        if PuzzleBot.Vars.Neighbors == 1 then
            PuzzleBot.Vars.StartIndex = i
            break
        end
    end
    
    PuzzleBot.Vars.Ordered = {}
    PuzzleBot.Vars.CurrentNode = table.remove(PuzzleBot.Vars.Pool, PuzzleBot.Vars.StartIndex)
    table.insert(PuzzleBot.Vars.Ordered, PuzzleBot.Vars.CurrentNode)
    
    while PuzzleBot.Vars.CurrentNode and #PuzzleBot.Vars.Pool > 0 do
        PuzzleBot.Vars.FoundIdx = nil
        for i, node in ipairs(PuzzleBot.Vars.Pool) do
            if PuzzleBot.Funcs.IsNeighbor(PuzzleBot.Vars.CurrentNode, node) then
                PuzzleBot.Vars.FoundIdx = i
                break
            end
        end
        
        PuzzleBot.Vars.CurrentNode = table.remove(PuzzleBot.Vars.Pool, PuzzleBot.Vars.FoundIdx or 1)
        table.insert(PuzzleBot.Vars.Ordered, PuzzleBot.Vars.CurrentNode)
    end
    
    return PuzzleBot.Vars.Ordered
end

PuzzleBot.Funcs.ApplyESP = function(puzzle)
    PuzzleBot.Vars.DefaultBtnColor = (puzzle.Settings and puzzle.Settings.defaultButtonColor) or Color3.fromRGB(30, 30, 30)

    for colorIndex, pathCoords in pairs(puzzle.Solution) do
        PuzzleBot.Vars.PureColor = (puzzle.colors and puzzle.colors[colorIndex]) or Color3.new(1,1,1)
        PuzzleBot.Vars.MixedColor = PuzzleBot.Vars.DefaultBtnColor:Lerp(PuzzleBot.Vars.PureColor, 0.3)
        
        for _, node in ipairs(pathCoords) do
            PuzzleBot.Vars.CellName = tostring(node.row) .. "-" .. tostring(node.col)
            PuzzleBot.Vars.Cell = puzzle.gridFrame:FindFirstChild(PuzzleBot.Vars.CellName)
            if PuzzleBot.Vars.Cell and PuzzleBot.Vars.Cell:FindFirstChild("Button") then
                table.insert(PuzzleBot.State.Watchers, PuzzleBot.Vars.Cell.Button:GetPropertyChangedSignal("BackgroundColor3"):Connect(function()
                    if PuzzleBot.Config.ShowPath and puzzle.gridFrame:FindFirstChild(tostring(node.row) .. "-" .. tostring(node.col)) then
                        puzzle.gridFrame[tostring(node.row) .. "-" .. tostring(node.col)].Button.BackgroundColor3 = (puzzle.Settings and puzzle.Settings.defaultButtonColor or Color3.fromRGB(30, 30, 30)):Lerp((puzzle.colors and puzzle.colors[colorIndex]) or Color3.new(1,1,1), 0.3)
                        puzzle.gridFrame[tostring(node.row) .. "-" .. tostring(node.col)].Button.BackgroundTransparency = 0 
                    end
                end))
                
                if PuzzleBot.Config.ShowPath then
                    PuzzleBot.Vars.Cell.Button.BackgroundColor3 = PuzzleBot.Vars.MixedColor
                    PuzzleBot.Vars.Cell.Button.BackgroundTransparency = 0
                end
            end
        end
    end
end

PuzzleBot.Funcs.SolvePuzzle = function(puzzle)
    for colorIndex, rawSolPath in pairs(puzzle.Solution) do
        if not PuzzleBot.Config.AutoSolve or puzzle.gameEnded then break end
        
        PuzzleBot.Vars.OrderedSolPath = PuzzleBot.Funcs.GetOrderedPath(rawSolPath)
        PuzzleBot.Vars.CurrentPath = puzzle.paths[colorIndex]
        PuzzleBot.Vars.IsPerfect = true
        
        if not PuzzleBot.Vars.CurrentPath or #PuzzleBot.Vars.CurrentPath ~= #PuzzleBot.Vars.OrderedSolPath then
            PuzzleBot.Vars.IsPerfect = false
        else
            for j, node in ipairs(PuzzleBot.Vars.OrderedSolPath) do
                if not PuzzleBot.Vars.CurrentPath[j] or PuzzleBot.Vars.CurrentPath[j].row ~= node.row or PuzzleBot.Vars.CurrentPath[j].col ~= node.col then
                    PuzzleBot.Vars.IsPerfect = false
                    break
                end
            end
        end

        if not PuzzleBot.Vars.IsPerfect then
            if PuzzleBot.Config.SolveSpeed <= 0 then
                puzzle.paths[colorIndex] = PuzzleBot.Vars.OrderedSolPath
                if puzzle.updateGui then puzzle:updateGui() end
            else
                puzzle.paths[colorIndex] = {}
                if puzzle.updateGui then puzzle:updateGui() end
                
                for _, node in ipairs(PuzzleBot.Vars.OrderedSolPath) do
                    if not PuzzleBot.Config.AutoSolve or puzzle.gameEnded then break end
                    table.insert(puzzle.paths[colorIndex], {row = node.row, col = node.col})
                    if puzzle.updateGui then puzzle:updateGui() end
                    task.wait(PuzzleBot.Config.SolveSpeed) 
                end
            end
        end
    end
    
    if puzzle.checkForWin then puzzle:checkForWin() end
    PuzzleBot.State.IsSolving = false
end

