local StaminaBot = {
    Config = {
        InfStamina = false,
        Max = { Enabled = false, Value = 100 },
        Regen = { Enabled = false, Value = 20 },
        Drain = { Enabled = false, Value = 10 },
        Speed = { Enabled = false, Value = 25 }
    },
    State = {
        ModulePath = ReplicatedStorage:WaitForChild("Systems"):WaitForChild("Character"):WaitForChild("Game"):WaitForChild("Sprinting"),
        Module = nil,
        LastForce = 0,
        ForceDelay = 0.2
    },
    Originals = {
        Max = 100, Regen = 20, Drain = 10, Speed = 25
    },
    Funcs = {}
}

function StaminaBot.Funcs.SafeSet(propUpper, propLower, value)
    local mod = StaminaBot.State.Module
    if not mod then return end
    pcall(function() mod[propUpper] = value end)
    pcall(function() mod[propLower] = value end)
end

function StaminaBot.Funcs.LoadModule()
    if StaminaBot.State.Module then return true end

    local success, mod = pcall(require, StaminaBot.State.ModulePath)
    if success and mod then
        StaminaBot.State.Module = mod
        
        StaminaBot.Originals.Max = tonumber(mod.MaxStamina) or tonumber(mod.maxStamina) or 100
        StaminaBot.Originals.Regen = tonumber(mod.StaminaGain) or tonumber(mod.staminaGain) or 20
        StaminaBot.Originals.Drain = tonumber(mod.StaminaLoss) or tonumber(mod.staminaLoss) or 10
        StaminaBot.Originals.Speed = tonumber(mod.SprintSpeed) or tonumber(mod.sprintSpeed) or 25
        return true
    end
    return false
end

function StaminaBot.Funcs.SetStamina(val)
    local mod = StaminaBot.State.Module
    if not mod then return end
    val = tonumber(val) or 0

    pcall(function()
        if type(mod.SetStamina) == "function" then mod:SetStamina(val)
        elseif type(mod.UpdateStamina) == "function" then mod:UpdateStamina(val)
        elseif type(mod.ChangeStamina) == "function" then mod:ChangeStamina(val)
        else mod.Stamina = val end
    end)
    pcall(function() mod.Stamina = val end)
end

function StaminaBot.Funcs.GetCurrent()
    local mod = StaminaBot.State.Module
    return mod and (tonumber(mod.Stamina) or 0) or 0
end

function StaminaBot.Funcs.ApplyStats()
    if not StaminaBot.Funcs.LoadModule() then return end
    local cfg = StaminaBot.Config

    if cfg.Max.Enabled then StaminaBot.Funcs.SafeSet("MaxStamina", "maxStamina", cfg.Max.Value) end
    if cfg.Regen.Enabled then StaminaBot.Funcs.SafeSet("StaminaGain", "staminaGain", cfg.Regen.Value) end
    if cfg.Drain.Enabled then StaminaBot.Funcs.SafeSet("StaminaLoss", "staminaLoss", cfg.Drain.Value) end
    if cfg.Speed.Enabled then StaminaBot.Funcs.SafeSet("SprintSpeed", "sprintSpeed", cfg.Speed.Value) end

    local current = StaminaBot.Funcs.GetCurrent()
    local maxValue = cfg.Max.Enabled and cfg.Max.Value or StaminaBot.Originals.Max

    if cfg.Max.Enabled then
        if current > maxValue then
            StaminaBot.Funcs.SetStamina(maxValue)
        elseif current <= StaminaBot.Originals.Max and tick() - StaminaBot.State.LastForce >= StaminaBot.State.ForceDelay then
            StaminaBot.State.LastForce = tick()
            StaminaBot.Funcs.SetStamina(math.clamp(current, 0, maxValue))
        end
    end

    if cfg.InfStamina and current < maxValue then
        StaminaBot.Funcs.SetStamina(maxValue)
    end
end

task.spawn(function()
    while task.wait(0.1) do
        local ok = pcall(function() StaminaBot.Funcs.ApplyStats() end)
        if not ok then StaminaBot.State.Module = nil end
    end
end)

localPlayer.CharacterAdded:Connect(function()
    task.wait(1)
    StaminaBot.State.Module = nil

    if StaminaBot.Funcs.LoadModule() then
        StaminaBot.Funcs.ApplyStats()
        if StaminaBot.Config.Max.Enabled then
            local current = StaminaBot.Funcs.GetCurrent()
            if current < StaminaBot.Config.Max.Value then
                StaminaBot.Funcs.SetStamina(StaminaBot.Config.Max.Value)
            end
        end
    end
end)

