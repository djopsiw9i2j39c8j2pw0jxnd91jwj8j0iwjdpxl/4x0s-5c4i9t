            PowerManager.AntiGravity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            PowerManager.AntiGravity.Velocity = Vector3.zero
        end

        PowerManager.Cache.MoveDir = PowerManager.Cache.Hum.MoveDirection
        if PowerManager.Cache.MoveDir.Magnitude > 0 then
            PowerManager.Cache.RotY = select(2, Camera.CFrame:ToEulerAnglesYXZ())
            PowerManager.Cache.FlatCam = CFrame.Angles(0, PowerManager.Cache.RotY, 0)
            
            PowerManager.Cache.Move3D = (Camera.CFrame.LookVector * PowerManager.Cache.MoveDir:Dot(PowerManager.Cache.FlatCam.LookVector)) + 
                                        (Camera.CFrame.RightVector * PowerManager.Cache.MoveDir:Dot(PowerManager.Cache.FlatCam.RightVector))
            
            PowerManager.Cache.Root.CFrame = PowerManager.Cache.Root.CFrame + (PowerManager.Cache.Move3D.Unit * PowerManager.Values.FlySpeed * dt)
        end
        PowerManager.Cache.Root.AssemblyLinearVelocity = Vector3.zero

    elseif PowerManager.Toggles.Speed and PowerManager.Cache.Hum.MoveDirection.Magnitude > 0 then
        PowerManager.Cache.Root.CFrame = PowerManager.Cache.Root.CFrame + (PowerManager.Cache.Hum.MoveDirection * PowerManager.Values.Speed * dt)
        
        PowerManager.Cache.CurrentVel = PowerManager.Cache.Root.AssemblyLinearVelocity
        PowerManager.Cache.Root.AssemblyLinearVelocity = Vector3.new(0, PowerManager.Cache.CurrentVel.Y, 0)
    end
end)

