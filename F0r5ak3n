	App.Inst.Probe.Size, App.Inst.Probe.CFrame = App.State.HitCfg.Size, App.State.HitKRoot.CFrame * App.State.HitCfg.Offset
	App.Inst.ProbeParams.FilterDescendantsInstances = { playerCharacter }
	return #Workspace:GetPartsInPart(App.Inst.Probe, App.Inst.ProbeParams) > 0
end

