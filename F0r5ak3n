function VeeronicaMods.GetCharacterData()
    if not playerCharacter then return nil, nil end

    VeeronicaMods.Data.Hum = playerCharacter:FindFirstChildOfClass("Humanoid")
    VeeronicaMods.Data.Root = playerCharacter:FindFirstChild("HumanoidRootPart")

    return VeeronicaMods.Data.Hum, VeeronicaMods.Data.Root
