    GetMusicNames = function(self)
        self.LMSList = {}
        for name in pairs(self.MusicList) do
            table.insert(self.LMSList, name)
        end
        return self.LMSList
    end,

    GetLastSurvivorSound = function(self)
        local theme = Workspace:FindFirstChild("Themes")
        if not theme then return nil end
        local lastSurvivor = theme:FindFirstChild("LastSurvivor")
        if not lastSurvivor then return nil end

        if lastSurvivor:IsA("Sound") then
            return lastSurvivor
        end
        return lastSurvivor:FindFirstChildWhichIsA("Sound", true)
    end,

    FormatSoundID = function(self, input)
        if not input or input == "" then return nil end

        if not string.find(input, "http") then
            local id = string.match(tostring(input), "%d+")
            return id and ("rbxassetid://" .. id) or nil
        end

        local fileName = "CustomLMS_" .. string.gsub(input, "%W", "") .. ".mp3"
        if isfile and writefile and getcustomasset then
            if not isfile(fileName) then
                local req = http_request or (syn and syn.request) or request
                local fileData = nil

                if req then
                    local res = req({Url = input, Method = "GET", Headers = {["User-Agent"] = "Mozilla/5.0"}})
                    if res then fileData = res.Body or res.BodyRaw end
                end

                if not fileData or #fileData == 0 then
                    pcall(function() fileData = game:HttpGet(input) end)
                end

                if fileData and #fileData > 0 then
                    writefile(fileName, fileData)
                end
            end
            
            if isfile(fileName) then
                return getcustomasset(fileName)
            end
        end
        return input
    end,

    SetVolume = function(self, val)
        local num = tonumber(val)
        if num then
            self.Volume = num

            local soundObj = self:GetLastSurvivorSound()
            if soundObj and soundObj.SoundId ~= self.OriginalSoundId then
                soundObj.Volume = self.Volume
            end

            if self.TestSoundObj then
                self.TestSoundObj.Volume = self.Volume
            end
        end
    end,

    UpdateState = function(self)
        local soundObj = self:GetLastSurvivorSound()

        if not soundObj then
            self.OriginalSoundId = nil
            return
        end

        if self.Enabled and self.CurrentTrack and self.CurrentTrack ~= "" then
            local newAsset = self:FormatSoundID(self.CurrentTrack)
            if not newAsset then return end
            
            if not self.OriginalSoundId and soundObj.SoundId ~= newAsset then
                self.OriginalSoundId = soundObj.SoundId
            end

            if soundObj.SoundId ~= newAsset then
                soundObj.SoundId = newAsset
                
                if soundObj.Loaded then
                    pcall(function() soundObj.Loaded:Wait() end)
                end
                
                soundObj.Volume = self.Volume
                soundObj.TimePosition = 0
                soundObj:Play()
            end
        else
            if self.OriginalSoundId and soundObj.SoundId ~= self.OriginalSoundId then
                soundObj.SoundId = self.OriginalSoundId
                soundObj.Volume = 1
                soundObj:Play()
            end
        end
    end,

    HandleTestSound = function(self, isTesting)
        if isTesting then
            if not self.CurrentTrack or self.CurrentTrack == "" then return end
            local testAsset = self:FormatSoundID(self.CurrentTrack)
            if not testAsset then return end

            if not self.TestSoundObj then
                self.TestSoundObj = Instance.new("Sound")
                self.TestSoundObj.Parent = SoundService
                self.TestSoundObj.Looped = true
            end

            self.TestSoundObj.SoundId = testAsset
            self.TestSoundObj.Volume = self.Volume
            if self.TestSoundObj.Loaded then
                pcall(function() self.TestSoundObj.Loaded:Wait() end)
            end
            self.TestSoundObj:Play()
        else
            if self.TestSoundObj then
                self.TestSoundObj:Stop()
                self.TestSoundObj:Destroy()
                self.TestSoundObj = nil
            end
        end
    end,

    CheckDelay = function(self)
        task.wait(0.2) 
        self:UpdateState()
    end,

    HookThemes = function(self, folder)
        if folder.Name == "Themes" then
            folder.ChildAdded:Connect(function(child)
                if child.Name == "LastSurvivor" then self:CheckDelay() end
            end)
            
            folder.ChildRemoved:Connect(function(child)
                if child.Name == "LastSurvivor" then self:UpdateState() end
            end)
            
            if folder:FindFirstChild("LastSurvivor") then self:CheckDelay() end
        end
    end,

    StartMonitor = function(self)
        if self.EventsSet then return end
        self.EventsSet = true

        Workspace.ChildAdded:Connect(function(child)
            self:HookThemes(child)
        end)

        local existingThemes = Workspace:FindFirstChild("Themes")
        if existingThemes then
            self:HookThemes(existingThemes)
        end
    end
}

