}

function ConfigSys.Notify(title, content, icon)
    WindUI:Notify({ Title = title, Content = content, Duration = 3, Icon = icon })
end

function ConfigSys.GetConfigs()
    return ConfigSys.Manager:AllConfigs()
end

function ConfigSys.RefreshDropdown()
    if not ConfigSys.Dropdown then return end
    ConfigSys.Dropdown:Refresh(ConfigSys.GetConfigs())

    ConfigSys.Temp.SetFunc = ConfigSys.Dropdown.Set or ConfigSys.Dropdown.SetValue
    if ConfigSys.Temp.SetFunc then
        ConfigSys.Temp.SetFunc(ConfigSys.Dropdown, ConfigSys.State.Selected)
    end
end

function ConfigSys.Exists(name)
    return name and name ~= "" and table.find(ConfigSys.GetConfigs(), name) ~= nil
end

function ConfigSys.Execute(name, action)
    ConfigSys.Temp.Success, ConfigSys.Temp.Cfg = pcall(function() return ConfigSys.Manager:CreateConfig(name) end)
    if not ConfigSys.Temp.Success or not ConfigSys.Temp.Cfg then return false end

    ConfigSys.Temp.ActionSuccess = pcall(function()
        if action == "Save" then ConfigSys.Temp.Cfg:Save()
        elseif action == "Load" then ConfigSys.Temp.Cfg:Load()
        elseif action == "Delete" then ConfigSys.Temp.Cfg:Delete() end
    end)

    if ConfigSys.Temp.ActionSuccess and action ~= "Delete" then
        ConfigSys.State.CurrentObject = ConfigSys.Temp.Cfg
        Window.CurrentConfig = ConfigSys.Temp.Cfg
    end
    return ConfigSys.Temp.ActionSuccess
end

function ConfigSys.HandleAction(actionType, errEmpty, errNotExist, successMsg, icon)
    ConfigSys.Temp.IsMake = (actionType == "Make")
    ConfigSys.Temp.TargetName = ConfigSys.Temp.IsMake and ConfigSys.State.Name or ConfigSys.State.Selected

    if not ConfigSys.Temp.TargetName or ConfigSys.Temp.TargetName == "" then 
        return ConfigSys.Notify("loc:Config", errEmpty, "circle-alert") 
    end

    ConfigSys.Temp.IsExist = ConfigSys.Exists(ConfigSys.Temp.TargetName)
    
    if (ConfigSys.Temp.IsMake and ConfigSys.Temp.IsExist) or (not ConfigSys.Temp.IsMake and not ConfigSys.Temp.IsExist) then
        return ConfigSys.Notify("loc:Config", errNotExist, "circle-alert")
    end

    ConfigSys.Temp.ExecType = (ConfigSys.Temp.IsMake or actionType == "Update") and "Save" or actionType
    
    if ConfigSys.Execute(ConfigSys.Temp.TargetName, ConfigSys.Temp.ExecType) then
        if ConfigSys.Temp.IsMake then
            ConfigSys.State.Selected = ConfigSys.Temp.TargetName
            task.delay(0.25, ConfigSys.RefreshDropdown)
        elseif actionType == "Delete" then
            ConfigSys.State.Selected = nil
            ConfigSys.State.CurrentObject = nil
            ConfigSys.RefreshDropdown()
        end
        ConfigSys.Notify("loc:Config", successMsg, icon)
    elseif ConfigSys.Temp.IsMake then 
        ConfigSys.Notify("loc:Config", "Failed to create config", "circle-alert") 
    end
end

